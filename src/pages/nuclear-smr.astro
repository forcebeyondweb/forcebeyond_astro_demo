---
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';

const pageTitle = 'Nuclear & SMR Components for Advanced Reactor Systems';
const seoTitle = 'Nuclear & SMR Components | Castings, Forgings & Machining';
const seoDescription = 'ForceBeyond supports nuclear and SMR programs with reactor internals, valve and pump components, pressure-boundary forgings, precision castings, rolled rings, CNC machining, HIP, heat treatment, NDT, and project-specific quality documentation.';

const canonicalUrl = 'https://www.forcebeyond.com/nuclear-smr/';
const socialImage = 'https://www.forcebeyond.com/media/nuclear-power-plant-cooling-towers-energy-generation.webp';

const faqs = [
    {
        q: "What manufacturing processes are commonly used for nuclear and SMR components?",
        a: "Depending on component function and qualification requirements, nuclear and SMR hardware may use investment casting, sand casting, open-die forging, closed-die forging, rolled-ring forging, wrought stock machining, HIP, heat treatment, welding, brazing, coatings, NDT, dimensional inspection, and pressure or leak testing."
    },
    {
        q: "Can ForceBeyond manufacture safety-related nuclear components?",
        a: "Safety classification, code scope, material, approved source, quality program, documentation, and regulatory requirements must be defined by the customer and governing contract. ForceBeyond may support nuclear manufacturing programs through qualified facilities and suppliers, but no component should be represented as safety-related, code-stamped, or nuclear-qualified without the applicable approvals and documented scope."
    },
    {
        q: "Which alloys are used in molten salt, high-temperature gas, or sodium-cooled systems?",
        a: "Candidate materials vary by coolant chemistry, temperature, irradiation, pressure, weldability, corrosion mechanism, and design code. Nickel alloys, stainless steels, ferritic or martensitic steels, zirconium alloys, and other materials may be evaluated, but final material selection must come from the reactor designer, governing specification, and validated test data."
    },
    {
        q: "What information is needed for a nuclear or SMR component quote?",
        a: "Provide drawings, CAD, material and product form, code or specification, safety classification, annual quantity, operating temperature and pressure, irradiation or coolant environment, heat treatment, NDT, inspection frequency, traceability, documentation, approved-source restrictions, export-control requirements, and target delivery schedule."
    }
];

const sources = [
    { label: 'U.S. Nuclear Regulatory Commission - Advanced Reactor and SMR Resources', url: 'https://www.nrc.gov/' },
    { label: 'U.S. Department of Energy - Advanced Nuclear Energy Resources', url: 'https://www.energy.gov/ne' },
    { label: 'ASME - Boiler and Pressure Vessel Code Resources', url: 'https://www.asme.org/codes-standards' },
    { label: 'ASTM International - Nuclear Materials and Testing Standards', url: 'https://www.astm.org/' },
    { label: 'ASM International - Nuclear and High-Temperature Materials', url: 'https://www.asminternational.org/' },
    { label: 'Forging Industry Association - Forging Design and Process Resources', url: 'https://www.forging.org/' }
];

const internalResources = [
    // Industry Hubs
    { label: "Energy & Power Generation", url: "/energy-power-generation" },
    { label: "Power Generation", url: "/power-generation" },
    { label: "Data Center Power", url: "/data-center-power" },
    { label: "Oil & Gas", url: "/oil-gas" },
    { label: "HVAC, Fluid & Flow Control", url: "/hvac-flow" },

    // Casting
    { label: "Casting Capabilities", url: "/casting" },
    { label: "Investment Casting", url: "/investment-casting" },
    { label: "Inconel Vacuum Precision Casting", url: "/inconel-vacuum-precision-casting" },
    { label: "Stainless Steel Casting", url: "/stainless-steel-casting" },
    { label: "Duplex Stainless Steel Casting", url: "/duplex-stainless-steel-casting" },
    { label: "Carbon & Low-Alloy Steel Casting", url: "/carbon-steel-casting" },
    { label: "Industrial Titanium Sand Casting", url: "/industrial-titanium-sand-casting" },

    // Forging
    { label: "Forging Capabilities", url: "/forging" },
    { label: "Open Die Forging", url: "/open-die-forging" },
    { label: "Closed Die Forging", url: "/closed-die-forging" },
    { label: "Rolled Ring Forging", url: "/rolled-ring-forging" },
    { label: "Superalloy Forging Services", url: "/high-performance-superalloy-forging" },

    // Machining and Secondary Operations
    { label: "Precision Machining", url: "/precision-machining" },
    { label: "High-Precision Component Machining", url: "/high-precision-machining" },
    { label: "Multi-Axis CNC Milling & Turning", url: "/multi-axis-cnc" },
    { label: "Hot Isostatic Pressing (HIP)", url: "/hot-isostatic-pressing" },
    { label: "Heat Treatment", url: "/heat-treatment" },
    { label: "Surface Finishing & Coating", url: "/surface-finishing" },
    { label: "Assembly & Kitting", url: "/assembly-and-kitting" },

    // Materials, Quality, and Technical
    { label: "Superalloys & Exotic Metals", url: "/superalloys-exotic-metals" },
    { label: "Titanium Alloys", url: "/titanium-alloys" },
    { label: "Stainless Steel & Carbon Steel", url: "/stainless-carbon-steel" },
    { label: "Materials & Technical Specifications", url: "/materials-technical-specs" },
    { label: "Material Cross-Reference Charts", url: "/material-cross-reference-charts" },
    { label: "Manufacturing Design Guides", url: "/manufacturing-design-guides" },
    { label: "Quality Assurance & Certifications", url: "/quality-assurance-certifications" },
    { label: "Testing & Inspection Capabilities", url: "/testing-inspection-capabilities" },
    { label: "Global Footprint & Logistics", url: "/global-footprint-logistics" }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": seoTitle,
      "description": seoDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://www.forcebeyond.com/#website",
        "name": "ForceBeyond",
        "url": "https://www.forcebeyond.com/"
      },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": socialImage
      },
      "breadcrumb": {
        "@id": `${canonicalUrl}#breadcrumb`
      },
      "about": [
        { "@type": "Thing", "name": "Small modular reactor components" },
        { "@type": "Thing", "name": "Advanced nuclear manufacturing" },
        { "@type": "Thing", "name": "Nuclear forgings" },
        { "@type": "Thing", "name": "Nuclear valve and pump components" },
        { "@type": "Thing", "name": "Reactor internals" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.forcebeyond.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Industries",
          "item": "https://www.forcebeyond.com/industries/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Nuclear & SMR",
          "item": canonicalUrl
        }
      ]
    },
    {
      "@type": "Service",
      "@id": `${canonicalUrl}#service`,
      "name": "Nuclear and SMR Component Manufacturing",
      "serviceType": "Casting, Forging, Machining and Inspection for Advanced Nuclear Systems",
      "description": seoDescription,
      "url": canonicalUrl,
      "provider": {
        "@id": "https://www.forcebeyond.com/#organization"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United States"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Nuclear and SMR Manufacturing Capabilities",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Reactor Internals and Structural Hardware",
              "description": "Project-specific cast, forged, and machined internals, supports, housings, grids, spacers, brackets, and structural components."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Pressure-Boundary Forgings and Rolled Rings",
              "description": "Open-die, closed-die, and rolled-ring forgings for flanges, rings, nozzles, closures, manways, and pressure-retaining hardware."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Valve, Pump and Flow-Control Components",
              "description": "Cast, forged, and machined valve bodies, pump components, impellers, manifolds, fittings, and fluid-system hardware."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Inspection, Traceability and Documentation",
              "description": "Project-specific NDT, dimensional inspection, mechanical testing, material records, traceability, and quality documentation."
            }
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }
  ]
