---
import { pageDates } from '../data/page-dates.js';
import TitaniumSolutionsPageLayout from '../layouts/TitaniumSolutionsPageLayout.astro';


const dates = pageDates['/machined-titanium-parts/'];

const pageTitle = 'Machined Titanium Parts';
const seoTitle = 'Machined Titanium Parts | Precision Titanium CNC Machining | ForceBeyond';
const seoDescription = 'ForceBeyond provides custom machined titanium parts for aerospace, marine, medical, oil and gas, automotive, and industrial applications, including Grade 2, Grade 5, and high-strength titanium alloys.';

const galleryItems = [
    {
        src: '/media/thumbs_Machined-Titanium-Parts-1.jpg',
        alt: 'Machined Titanium Parts'
    },
    {
        src: '/media/thumbs_Machined-Titanium-Parts-2.jpg',
        alt: 'Machined Titanium Parts'
    },
    {
        src: '/media/thumbs_Machined-Titanium-Parts-5-Axis-Milling-Titanium-Blade-for-Aircraft-Engines.jpg',
        alt: 'Machined Titanium Parts 5-Axis Milling Titanium Blade for Aircraft Engines'
    },
    {
        src: '/media/thumbs_Machined-Titanium-Parts-Aircraft-Parts.jpg',
        alt: 'Machined Titanium Parts Aircraft Parts'
    },
    {
        src: '/media/thumbs_Machined-Titanium-Parts-Aircraft-Parts-CNC-Turning.jpg',
        alt: 'Machined Titanium Parts Aircraft Parts CNC Turning'
    },
    {
        src: '/media/thumbs_Machined-Titanium-Parts-Aircraft-Parts-Helicopter-Parts.jpg',
        alt: 'Machined Titanium Parts Aircraft Parts Helicopter Parts'
    },
    {
        src: '/media/thumbs_Machined-Titanium-Parts-Grade-5-Aircraft-Parts.jpg',
        alt: 'Machined Titanium Parts Grade-5 High Precision Aircraft Parts'
    }
];

const sources = [
    { label: 'American Foundry Society — Metal Casting', url: 'https://www.afsinc.org/' },
    { label: 'Wikipedia — Investment Casting', url: 'https://en.wikipedia.org/wiki/Investment_casting' },
    { label: 'Wikipedia — Sand Casting', url: 'https://en.wikipedia.org/wiki/Sand_casting' },
    { label: 'eFunda — Sand Casting', url: 'https://www.efunda.com/processes/metal_processing/sand_casting_intro.cfm' },
    { label: 'The Investment Casting Institute — What is Investment Casting?', url: 'https://www.investmentcasting.org/what-is-investment-casting.html' },
    { label: 'The Library of Manufacturing — Investment Casting', url: 'http://thelibraryofmanufacturing.com/investment_casting.html' },
    { label: 'Forging Industry Association — Forging Industry', url: 'https://www.forging.org/' }
];

const internalResources = [
    { label: 'Die Casting', url: '/die-casting/' },
    { label: 'Aluminum Die Casting', url: '/aluminum-die-casting/' },
    { label: 'Zinc Die Casting', url: '/zinc-die-casting/' },
    { label: 'A356 Aluminum Casting with T6 Heat Treatment', url: '/a356-aluminum-casting/' },
    { label: 'Magnesium Die Casting', url: '/magnesium-die-casting/' },
    { label: 'Investment Casting', url: '/investment-casting/' },
    { label: 'Stainless Steel Casting', url: '/stainless-steel-casting/' },
    { label: 'Duplex Stainless Steel Casting', url: '/duplex-stainless-steel-casting/' },
    { label: 'Super Duplex Stainless Steel Casting', url: '/super-duplex-stainless-steel-casting/' },
    { label: 'Titanium Casting', url: '/titanium-casting/' },
    { label: 'Carbon & Low Alloy Casting', url: '/carbon-steel-casting-low-alloy-steel-casting/' },
    { label: 'Forging', url: '/forging/' },
    { label: 'Cold Forging', url: '/cold-forging/' },
    { label: 'Hot Forging', url: '/hot-forging/' },
    { label: 'ECO BRASS C69300 Brass Forging', url: '/eco-brass-c69300-brass-forging/' },
    { label: 'Sand Casting (Aluminum, Ductile Iron & Gray Iron)', url: '/sand-casting/' },
    { label: 'Specialty Fittings and Fasteners', url: '/fittings-fasteners/' },
    { label: 'Precision CNC Machining and Secondary Operations', url: '/precision-cnc-machining-secondary-operations/' }
];

const pageSchema = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebPage',
            '@id': 'https://www.forcebeyond.com/machined-titanium-parts/#webpage',
            url: 'https://www.forcebeyond.com/machined-titanium-parts/',
            name: seoTitle,
            description: seoDescription,
            datePublished: '2019-10-18T14:46:08-04:00',
            dateModified: dates.modified,
            isPartOf: { '@id': 'https://www.forcebeyond.com/#website' },
            about: { '@id': 'https://www.forcebeyond.com/machined-titanium-parts/#service' },
            inLanguage: 'en-US'
        },
        {
            '@type': 'Service',
            '@id': 'https://www.forcebeyond.com/machined-titanium-parts/#service',
            name: 'Machined Titanium Parts',
            serviceType: 'Titanium CNC Machining',
            description: seoDescription,
            provider: { '@id': 'https://www.forcebeyond.com/#organization' },
            areaServed: { '@type': 'Country', name: 'United States' }
        }
    ]
