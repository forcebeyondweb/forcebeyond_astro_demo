---
import { pageDates } from '../data/page-dates.js';
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';


const dates = pageDates['/titanium-aerospace-forging/'];

const pageTitle = 'Titanium Aerospace Forging: AS9100-Certified Mission Critical Components';
const seoTitle = 'Titanium Aerospace Forging | AMS 4928 & AS9100 Certified | ForceBeyond';
const seoDescription = 'AS9100 titanium aerospace forging for propulsion & airframes. Specialists in AMS 4928 Ti-6Al-4V. Integrated 5-axis machining. Lead times reduced to 14-18 weeks.';
const faqs = [
    {
    q: "Why is forged titanium often preferred over machined-from-plate material for aerospace structural components?",
    a: "Forging can develop material flow that follows the component geometry and primary loading directions, while a part machined from plate or bar retains the grain orientation of the original wrought stock. For appropriately designed components, this can provide advantages in fatigue resistance, fracture performance, and structural reliability. Actual performance depends on alloy, stock orientation, forging reduction, heat treatment, geometry, surface condition, and service loading."
    },
    {
    q: "What aerospace material specifications can apply to titanium forgings?",
    a: "For Ti-6Al-4V forgings, <strong>AMS 4928</strong> is a common aerospace material specification. Other specifications may apply depending on alloy, product form, heat-treatment condition, section size, and customer requirements. Legacy specifications such as <strong>MIL-T-9047</strong> or SAE AMS-T-9047 should only be applied when specifically invoked by the drawing, contract, or purchase order. The specified revision and customer acceptance criteria remain controlling."
    },
    {
        q: "How does the Tier-1.5 model reduce aerospace lead times?",
        a: "Traditional aerospace supply chains are fragmented between a forge, a heat-treater, and a machine shop. ForceBeyond’s <strong>Tier-1.5</strong> model integrates these steps under a single AS9100 oversight system. By managing the “Forge-to-Finish” cycle in-house, we reduce average lead times from 40+ weeks to 14–18 weeks."  
    },
    {
        q:" Do you offer Nondestructive Testing (NDT) for flight-critical parts?",
        a: "Absolutely. Our co-owned manufacturing facilities are equipped for in-house Ultrasonic Testing (UT), Fluorescent Penetrant Inspection (FPI), and other applicable NDT methods can be incorporated to evaluate flight-critical forgings according to customer-defined inspection and acceptance requirements."
    },
    {
        q: "What is the maximum size for your seamless rolled rings?",
        a: "Our aerospace lines can produce seamless rolled titanium rings up to 84 inches (2,133 mm) in outer diameter, subject to alloy, cross-section, ring geometry, equipment availability and DFM review, ideal for jet engine cases, combustion liners, and large structural seals."
    }
];

// Sources
const sources = [
    {
        label: "SAE International - AMS 4928 Ti-6Al-4V Bars, Forgings, Rings and Forging Stock",
        url: "https://saemobilus.sae.org/standards/ams4928x-titanium-alloy-bars-wire-forgings-flash-welded-rings-drawn-shapes-6al-4v-annealed"
    },
    {
        label: "SAE International - AMS 4976 Ti-6Al-2Sn-4Zr-2Mo Forgings",
        url: "https://saemobilus.sae.org/standards/ams4976-titanium-alloy-forgings-6al-2sn-4zr-2mo-solution-precipitation-heat-treated"
    },
    {
        label: "SAE International - AMS 4983 Ti-10V-2Fe-3Al Forgings",
        url: "https://saemobilus.sae.org/standards/ams4983g-titanium-alloy-forgings-10v-2fe-3al-consumable-electrode-melted-single-step-solution-heat-treated-aged-180-ksi-1241-mpa-tensile-strength"
    },
    {
        label: "DLA ASSIST - MIL-T-9047 Historical Specification Record",
        url: "https://quicksearch.dla.mil/qsDocDetails.aspx?ident_number=7476"
    },
    {
        label: "Forging Industry Association - Forgings Compared with Machined Bar and Plate",
        url: "https://www.forging.org/fia/content/about/design-engineering-center-content/How_Forgings_Compare_to_Other_Processes.aspx"
    }
];

// Resources 
const internalResources = [
    { label: "Titanium Forging Services", url: "/titanium-forging/" },

    // Related titanium forging spokes
    { label: "High-Strength Beta Titanium Forging", url: "/high-strength-beta-titanium-forging/" },
    { label: "Near-Net-Shape Titanium Forging", url: "/near-net-shape-titanium-forging/" },

    // Relevant forging methods
    { label: "Open Die Forging", url: "/open-die-forging/" },
    { label: "Closed Die Forging", url: "/closed-die-forging/" },
    { label: "Rolled Ring Forging", url: "/rolled-ring-forging/" },

    // Downstream / alternative routes
    { label: "Titanium Machining", url: "/titanium-machining/" },
    { label: "Aerospace Titanium Machining", url: "/aerospace-titanium-machining/" },
    { label: "Titanium Investment Casting", url: "/titanium-investment-casting/" }
];
// Page-level schema migrated from the current forcebeyond.com page.
// Global Place, Organization, and WebSite entities are defined in Layout.astro.
