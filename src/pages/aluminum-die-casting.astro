            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "A360, 413 and A413 Aluminum Die Casting",
              "description": "Aluminum die casting for components requiring fluidity, corrosion resistance, thermal performance, or pressure-tight designs."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "B390 and Wear-Resistant Aluminum Casting",
              "description": "High-silicon aluminum die casting for wear-related components and application-specific automotive or industrial parts."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Machined and Finished Aluminum Die Castings",
