---
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';

const pageTitle = 'Aluminum Die Casting Services for High-Volume Precision Components';
const seoTitle = 'Aluminum Die Casting Services | A380, A360 & 413 Parts';
const seoDescription = 'ForceBeyond provides custom aluminum die casting services for A380, A360, 383, 413, A413, and B390 components, including tooling, cold-chamber casting, CNC machining, coating, inspection, assembly, and production support.';

const canonicalUrl = 'https://www.forcebeyond.com/aluminum-die-casting/';
const socialImage = 'https://www.forcebeyond.com/media/custom-aluminum-die-casting-parts-engine-housings-4k.webp';

const faqs = [
    {
        q: "What is high-pressure aluminum die casting?",
        a: "High-pressure aluminum die casting injects molten aluminum alloy into a hardened steel die using a cold-chamber machine. The process can produce repeatable, near-net-shape parts with integrated ribs, bosses, thin sections, and detailed features. Actual pressure, fill speed, wall thickness, cycle time, and dimensional capability depend on alloy, geometry, die design, press size, and process conditions."
    },
    {
        q: "How does aluminum die casting compare with sand casting?",
        a: "Aluminum die casting generally provides faster cycle times, thinner sections, smoother as-cast surfaces, and greater dimensional repeatability than sand casting. Sand casting is often more economical for larger parts, lower production volumes, and projects that cannot justify permanent steel tooling. Process selection should consider annual volume, part size, alloy, tolerance, tooling budget, and finishing requirements."
    },
    {
        q: "What finishes can be applied to aluminum die castings?",
        a: "Common finishing options include conversion coating, painting, powder coating, E-coating, blasting, polishing, and selected anodizing systems where alloy and casting quality are suitable. Because high-silicon die-casting alloys can respond differently from wrought aluminum, the required cosmetic appearance, corrosion resistance, electrical properties, masking, and pretreatment should be reviewed before production."
    },
    {
        q: "What information is needed for an aluminum die casting quote?",
        a: "Provide a 2D drawing and, when available, a 3D CAD model, along with alloy preference, annual and batch quantity, critical tolerances, wall thickness, cosmetic requirements, pressure-tightness, machining, coating, inspection, assembly, packaging, tooling life, and delivery expectations. Identifying critical-to-quality features helps the engineering team review manufacturability and calculate press and tooling requirements."
    }
];

const sources = [
    { label: 'North American Die Casting Association - Die Casting Resources', url: 'https://www.diecasting.org/' },
    { label: 'Aluminum Association - Aluminum Alloy Information', url: 'https://www.aluminum.org/' },
    { label: 'ASTM International - Aluminum Alloy and Coating Standards', url: 'https://www.astm.org/' },
    { label: 'American Foundry Society - Metalcasting', url: 'https://www.afsinc.org/about-metalcasting' },
    { label: 'NIST - Manufacturing', url: 'https://www.nist.gov/topics/manufacturing' },
    { label: 'ASM International - Aluminum and Casting Resources', url: 'https://www.asminternational.org/' }
];

const internalResources = [
    // Die Casting
    { label: "Die Casting Overview", url: "/die-casting" },
    { label: "Zinc Die Casting", url: "/zinc-die-casting" },
    { label: "Magnesium Casting", url: "/magnesium-casting" },
    { label: "A356-T6 Casting", url: "/a356-t6-casting" },

    // Related Casting
    { label: "Casting Capabilities", url: "/casting" },
    { label: "Sand Casting", url: "/sand-casting" },
    { label: "Investment Casting", url: "/investment-casting" },

    // Machining and Secondary Operations
    { label: "Precision Machining", url: "/precision-machining" },
    { label: "Multi-Axis CNC Milling & Turning", url: "/multi-axis-cnc" },
    { label: "Secondary Operations", url: "/secondary-operations" },
    { label: "Surface Finishing & Coating", url: "/surface-finishing" },
    { label: "Heat Treatment", url: "/heat-treatment" },
    { label: "Assembly & Kitting", url: "/assembly-and-kitting" },

    // Quality and Technical
    { label: "Testing & Inspection Capabilities", url: "/testing-inspection-capabilities" },
    { label: "Quality Assurance & Certifications", url: "/quality-assurance-certifications" },
    { label: "Aluminum & Magnesium Materials", url: "/aluminum-magnesium" },
    { label: "Materials & Technical Specifications", url: "/materials-technical-specs" },
    { label: "Manufacturing Design Guides", url: "/manufacturing-design-guides" },

    // Industries
    { label: "Automotive", url: "/automotive" },
    { label: "HVAC, Fluid & Flow Control", url: "/hvac-flow" },
    { label: "Energy & Power Generation", url: "/energy-power-generation" },
    { label: "Medical & Healthcare", url: "/medical" },
    { label: "Space & Defence", url: "/space-defence" }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": seoTitle,
      "description": seoDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://www.forcebeyond.com/#website",
        "name": "ForceBeyond",
        "url": "https://www.forcebeyond.com/"
      },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": socialImage
      },
      "breadcrumb": {
        "@id": `${canonicalUrl}#breadcrumb`
      },
      "about": [
        { "@type": "Thing", "name": "Aluminum die casting" },
        { "@type": "Thing", "name": "High-pressure die casting" },
        { "@type": "Thing", "name": "Cold-chamber die casting" },
        { "@type": "Thing", "name": "A380 aluminum alloy" },
        { "@type": "Thing", "name": "A360 aluminum alloy" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
