---
import { pageDates } from '../data/page-dates.js';
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';


const dates = pageDates['/agricultural/'];

const pageTitle = 'Agricultural Equipment Components: Casting, Forging & Assembly';
const seoTitle = 'Agricultural Equipment Components | Casting, Forging & Assembly';
const seoDescription = 'ForceBeyond supports tractor, tillage, seeding, harvesting, drivetrain, hub, housing, and agricultural machinery programs with castings, forgings, CNC machining, heat treatment, coatings, assembly, kitting, inspection, and logistics.';

const canonicalUrl = 'https://www.forcebeyond.com/agricultural/';
const socialImage = 'https://www.forcebeyond.com/media/agricultural-equipment-overview-4k.webp';

const faqs = [
    {
        q: "What coatings are suitable for agricultural components exposed to weather, soil, and fertilizers?",
        a: "Potential systems include e-coating, powder coating, liquid paint, zinc-based coatings, plating, and application-specific corrosion-protection systems. Selection depends on substrate, pretreatment, fertilizer chemistry, UV exposure, abrasion, edge coverage, coating thickness, appearance, repair requirements, and the specified test method."
    },
    {
        q: "Can ForceBeyond provide pre-assembled hubs, bearing modules, or agricultural kits?",
        a: "Project-specific assembly and kitting may include machined hubs, bearings, seals, retaining hardware, lubrication, torque-controlled fasteners, labels, inspection, and packaging. Fit, cleanliness, torque, preload, runout, traceability, testing, and packaging requirements should be defined before quotation."
    },
    {
        q: "Which manufacturing processes are used for agricultural equipment components?",
        a: "Depending on geometry, material, annual volume, load, wear, and cost targets, agricultural components may use green-sand or no-bake casting, investment casting, aluminum die casting, closed-die forging, open-die forging, CNC machining, heat treatment, coatings, and mechanical assembly."
    },
    {
        q: "What information is needed for an agricultural component quote?",
        a: "Provide drawings, CAD, material, annual volume, component function, load, wear environment, corrosion exposure, heat treatment, hardness, machining, coating, inspection, assembly, packaging, service-parts demand, and delivery requirements."
    }
];

const sources = [
    { label: 'Association of Equipment Manufacturers - Agricultural Equipment Resources', url: 'https://www.aem.org/' },
    { label: 'American Foundry Society - Metalcasting Resources', url: 'https://www.afsinc.org/' },
    { label: 'Forging Industry Association - Forging Resources', url: 'https://www.forging.org/' },
    { label: 'ASM International - Wear, Heat Treatment and Materials Resources', url: 'https://www.asminternational.org/' },
    { label: 'ASTM International - Agricultural Materials, Coatings and Testing Standards', url: 'https://www.astm.org/' },
    { label: 'AMPP - Corrosion and Protective Coating Resources', url: 'https://www.ampp.org/' }
];

const internalResources = [
    // Industry Hubs
    { label: "Mining, Heavy Equipment & Agriculture", url: "/mining" },
    { label: "Automotive & Transportation", url: "/automotive" },
    { label: "Oil & Gas", url: "/oil-gas" },
    { label: "HVAC, Fluid & Flow Control", url: "/hvac-flow" },

    // Casting
    { label: "Casting Capabilities", url: "/casting" },
    { label: "Sand Casting", url: "/sand-casting" },
    { label: "Investment Casting", url: "/investment-casting" },
    { label: "Die Casting", url: "/die-casting" },
    { label: "Aluminum Die Casting", url: "/aluminum-die-casting" },
    { label: "A356-T6 Casting", url: "/a356-t6-casting" },
    { label: "Carbon & Low-Alloy Steel Casting", url: "/carbon-steel-casting" },

    // Forging
    { label: "Forging Capabilities", url: "/forging" },
    { label: "Closed Die Forging", url: "/closed-die-forging" },
    { label: "Cold Forging", url: "/cold-forging" },
    { label: "Open Die Forging", url: "/open-die-forging" },
    { label: "Rolled Ring Forging", url: "/rolled-ring-forging" },

    // Machining and Secondary Operations
    { label: "Precision Machining", url: "/precision-machining" },
    { label: "High-Precision Component Machining", url: "/high-precision-machining" },
    { label: "Multi-Axis CNC Milling & Turning", url: "/multi-axis-cnc" },
    { label: "Heat Treatment", url: "/heat-treatment" },
    { label: "Surface Finishing & Coating", url: "/surface-finishing" },
    { label: "Assembly & Kitting", url: "/assembly-and-kitting" },

    // Materials, Quality, and Supply Chain
    { label: "Stainless Steel & Carbon Steel", url: "/stainless-carbon-steel" },
    { label: "Aluminum & Copper Alloys", url: "/aluminum-copper-alloys" },
    { label: "Materials & Technical Specifications", url: "/materials-technical-specs" },
    { label: "Material Cross-Reference Charts", url: "/material-cross-reference-charts" },
    { label: "Manufacturing Design Guides", url: "/manufacturing-design-guides" },
    { label: "Quality Assurance & Certifications", url: "/quality-assurance-certifications" },
    { label: "Testing & Inspection Capabilities", url: "/testing-inspection-capabilities" },
    { label: "Global Footprint & Logistics", url: "/global-footprint-logistics" }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": seoTitle,
      "description": seoDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://www.forcebeyond.com/#website",
        "name": "ForceBeyond",
        "url": "https://www.forcebeyond.com/"
      },
      "primaryImageOfPage": {
