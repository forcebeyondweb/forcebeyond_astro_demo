        }
      ]
    },
    {
      "@type": "Service",
      "@id": `${canonicalUrl}#service`,
      "name": "Agricultural Equipment Component Manufacturing",
      "serviceType": "Casting, Forging, Machining, Coating, Assembly and Kitting for Agricultural Machinery",
      "description": seoDescription,
      "url": canonicalUrl,
      "provider": {
        "@id": "https://www.forcebeyond.com/#organization"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United States"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Agricultural Equipment Manufacturing Capabilities",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Tractor and Structural Cast Components",
              "description": "Project-specific frame brackets, gearbox housings, axle housings, counterweights, carriers, and structural castings."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Tillage and Harvesting Forgings",
              "description": "Forged plow points, tines, links, hitch components, cutter hardware, shafts, and wear-resistant agricultural parts."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Seed, Metering and Lightweight Components",
              "description": "Aluminum die-cast and machined housings, covers, brackets, metering parts, and cab or control hardware."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Hub Modules, Kitting and Assembly",
