        "url": socialImage
      },
      "breadcrumb": {
        "@id": `${canonicalUrl}#breadcrumb`
      },
      "about": [
        { "@type": "Thing", "name": "Agricultural equipment components" },
        { "@type": "Thing", "name": "Tractor castings and forgings" },
        { "@type": "Thing", "name": "Tillage and harvesting components" },
        { "@type": "Thing", "name": "Agricultural hub and bearing assemblies" },
        { "@type": "Thing", "name": "Agricultural OEM supply chain" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.forcebeyond.com/"
        },
        {
