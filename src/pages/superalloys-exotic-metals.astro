import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';


const dates = pageDates['/superalloys-exotic-metals/'];

const pageTitle = 'Superalloys & Exotic Metals for Casting, Forging and Machining';
const seoTitle = 'Superalloys & Exotic Metals | Inconel, Hastelloy & Cobalt';
const seoDescription = 'Explore ForceBeyond manufacturing support for Inconel, Hastelloy, cobalt alloys, and other superalloys through vacuum casting, forging, heat treatment, HIP, CNC machining, inspection, and material documentation.';

const canonicalUrl = 'https://www.forcebeyond.com/superalloys-exotic-metals/';
const socialImage = 'https://www.forcebeyond.com/media/precision-cnc-machining-metal-manufacturing-workshop-hero.webp';

const faqs = [
    {
        q: "Why is vacuum melting used for some superalloys?",
        a: "Vacuum melting can help control reactive elements, dissolved gases, oxidation, contamination, and chemistry during production of selected nickel- and cobalt-based alloys. The required melting route depends on alloy specification, product form, cleanliness requirements, and the downstream casting, forging, or remelting process."
    },
    {
        q: "How does hot isostatic pressing improve superalloy components?",
        a: "Hot isostatic pressing applies elevated temperature and isostatic gas pressure to reduce internal porosity and improve material uniformity in suitable castings or powder-based components. The resulting benefit depends on alloy, initial defect population, HIP cycle, heat treatment, geometry, and acceptance criteria. HIP does not guarantee elimination of every defect."
    },
    {
        q: "Which manufacturing processes are used for Inconel and Hastelloy components?",
        a: "Depending on geometry, volume, properties, and specification, superalloy components may be produced by investment casting, vacuum casting, open- or closed-die forging, rolled-ring forging, billet machining, powder metallurgy, additive manufacturing, and combinations of heat treatment, HIP, machining, finishing, and inspection."
    },
    {
        q: "What information is needed for a superalloy manufacturing quote?",
        a: "Provide a 2D drawing and, when available, a 3D CAD model, along with alloy grade, governing specification, product form, quantity, service temperature, corrosion environment, mechanical requirements, heat treatment, HIP, machining, NDT, documentation, and delivery expectations."
    }
];

const sources = [
    { label: 'ASM International - Superalloys and High-Temperature Materials', url: 'https://www.asminternational.org/' },
    { label: 'ASTM International - Nickel and Cobalt Alloy Standards', url: 'https://www.astm.org/' },
    { label: 'SAE International - Aerospace Materials Specifications', url: 'https://www.sae.org/standards' },
