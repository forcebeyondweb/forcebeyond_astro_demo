---
import { pageDates } from '../data/page-dates.js';
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';


const dates = pageDates['/titanium-alloys/'];

const pageTitle = 'Titanium Alloys for Casting, Forging and Precision Machining';
const seoTitle = 'Titanium Alloys | Ti-6Al-4V, Grade 23 & CP Titanium';
const seoDescription = 'Explore ForceBeyond manufacturing support for Ti-6Al-4V Grade 5, Ti-6Al-4V ELI Grade 23, and commercially pure titanium through casting, forging, CNC machining, heat treatment, surface finishing, inspection, and documentation.';

const canonicalUrl = 'https://www.forcebeyond.com/titanium-alloys/';
const socialImage = 'https://www.forcebeyond.com/media/precision-cnc-machining-metal-manufacturing-workshop-hero.webp';

const faqs = [
    {
        q: "How is alpha case controlled during titanium casting and heat treatment?",
        a: "Titanium readily reacts with oxygen, nitrogen, and carbon at elevated temperature. Alpha case is controlled through suitable vacuum or inert-atmosphere processing, compatible mold and crucible systems, controlled thermal exposure, chemical milling or pickling, machining allowance, and verification where required. The exact control plan depends on alloy, process route, section size, and specification."
    },
    {
        q: "What is the difference between Ti-6Al-4V Grade 5 and Grade 23 ELI?",
        a: "Grade 23 is the extra-low-interstitial version of Ti-6Al-4V, with tighter limits on oxygen, nitrogen, carbon, and iron than Grade 5. This can improve fracture toughness and low-temperature ductility. Medical or implant use still depends on the exact material specification, manufacturing process, surface condition, cleanliness, validation, and regulatory requirements."
    },
    {
        q: "Which manufacturing processes are used for titanium components?",
        a: "Titanium components may be produced by investment casting, sand casting, closed-die or open-die forging, rolled-ring forging, billet machining, additive manufacturing, and combinations of heat treatment, HIP, machining, chemical milling, surface finishing, and inspection. Process selection depends on geometry, volume, product form, properties, tooling, and specification."
    },
    {
        q: "What information is needed for a titanium manufacturing quote?",
        a: "Provide a 2D drawing and, when available, a 3D CAD model, along with titanium grade, governing specification, product form, quantity, service environment, mechanical requirements, heat treatment, HIP, machining, surface treatment, NDT, documentation, cleanliness, and delivery expectations."
    }
];

const sources = [
    { label: 'ASM International - Titanium and Titanium Alloys', url: 'https://www.asminternational.org/' },
    { label: 'ASTM International - Titanium Material Standards', url: 'https://www.astm.org/' },
    { label: 'SAE International - Aerospace Materials Specifications', url: 'https://www.sae.org/standards' },
    { label: 'International Titanium Association - Titanium Resources', url: 'https://titanium.org/' },
    { label: 'NIST - Materials and Manufacturing', url: 'https://www.nist.gov/topics/materials' },
    { label: 'Investment Casting Institute - Investment Casting Process', url: 'https://www.investmentcasting.org/what-is.html' }
];

const internalResources = [
    // Materials Hub
    { label: "Materials & Technical Specifications", url: "/materials-technical-specs" },
    { label: "Superalloys & Exotic Metals", url: "/superalloys-exotic-metals" },
