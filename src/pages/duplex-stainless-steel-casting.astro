---
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';

const pageTitle = 'Duplex & Super Duplex Stainless Steel Casting Services';
const seoTitle = 'Duplex Stainless Steel Casting | 2205 & Super Duplex 2507';
const seoDescription = 'ForceBeyond provides duplex and super duplex stainless steel casting services for corrosion-resistant components, including 2205, 2507, ASTM A890 grades, machining, heat treatment, inspection, and finishing.';

const canonicalUrl = 'https://www.forcebeyond.com/duplex-stainless-steel-casting/';
const socialImage = 'https://www.forcebeyond.com/media/duplex-stainless-steel-submersible-pump-housing-4k.webp';

const faqs = [
    {
        q: "What is the difference between duplex and super duplex stainless steel casting?",
        a: "Duplex stainless steels combine austenitic and ferritic phases to provide higher strength and better resistance to chloride stress-corrosion cracking than many conventional austenitic grades. Super duplex grades contain higher levels of chromium, molybdenum, and nitrogen and typically provide higher pitting resistance. Final selection should be based on the governing cast-alloy specification, service temperature, chloride level, pressure, welding requirements, and corrosion testing."
    },
    {
        q: "Why choose duplex stainless steel casting instead of 316L?",
        a: "Duplex grades generally provide higher yield strength and improved resistance to chloride stress-corrosion cracking and localized corrosion compared with 316L. These advantages can support thinner sections or longer service life in suitable designs. Duplex is not automatically the best choice for every application, because fabrication, heat treatment, temperature limits, cost, and specification requirements must also be considered."
    },
    {
        q: "Why is investment casting useful for duplex stainless steel parts?",
        a: "Duplex and super duplex alloys can be demanding to machine because of their strength and work-hardening behavior. Investment casting can form complex near-net shapes, fluid passages, and detailed features before machining, reducing stock removal on suitable components. Machining allowances, heat treatment, ferrite balance, and inspection should be planned together."
    },
    {
        q: "What information is needed for a duplex stainless steel casting quote?",
        a: "Provide a 2D drawing and, when available, a 3D CAD model, along with the required ASTM, UNS, NACE, ISO, or customer material specification, quantity, critical dimensions, pressure rating, corrosion environment, heat treatment, ferrite requirements, machining, NDT, corrosion testing, documentation, and delivery requirements."
    }
];

const sources = [
    { label: 'ASTM International - Stainless Steel Casting Standards', url: 'https://www.astm.org/' },
    { label: 'Nickel Institute - Duplex Stainless Steel Resources', url: 'https://nickelinstitute.org/' },
    { label: 'International Molybdenum Association - Duplex Stainless Steel', url: 'https://www.imoa.info/' },
    { label: 'Investment Casting Institute - What Is Investment Casting?', url: 'https://www.investmentcasting.org/what-is.html' },
    { label: 'American Foundry Society - Metalcasting', url: 'https://www.afsinc.org/about-metalcasting' },
    { label: 'NACE / AMPP - Corrosion Standards and Resources', url: 'https://www.ampp.org/' }
];

const internalResources = [
    // Duplex and Stainless
    { label: "Stainless Steel Casting", url: "/stainless-steel-casting" },
    { label: "Investment Casting", url: "/investment-casting" },
    { label: "Casting Capabilities", url: "/casting" },
    { label: "Carbon & Low-Alloy Steel Casting", url: "/carbon-steel-casting" },

    // Machining and Secondary Operations
    { label: "Duplex Stainless Steel Machining", url: "/duplex-machining" },
    { label: "Stainless Steel Machining", url: "/stainless-steel-machining" },
    { label: "Precision Machining", url: "/precision-machining" },
    { label: "Multi-Axis CNC Milling & Turning", url: "/multi-axis-cnc" },
    { label: "Secondary Operations", url: "/secondary-operations" },
    { label: "Heat Treatment", url: "/heat-treatment" },
    { label: "Surface Finishing & Coating", url: "/surface-finishing" },
    { label: "Assembly & Kitting", url: "/assembly-and-kitting" },

    // Quality and Technical
    { label: "Testing & Inspection Capabilities", url: "/testing-inspection-capabilities" },
    { label: "Quality Assurance & Certifications", url: "/quality-assurance-certifications" },
    { label: "Stainless Steel & Carbon Steel Materials", url: "/stainless-carbon-steel" },
    { label: "Materials & Technical Specifications", url: "/materials-technical-specs" },
    { label: "Manufacturing Design Guides", url: "/manufacturing-design-guides" },

    // Industry
    { label: "Oil & Gas", url: "/oil-gas" },
    { label: "HVAC, Fluid & Flow Control", url: "/hvac-flow" },
    { label: "Energy & Power Generation", url: "/energy-power-generation" },
    { label: "Mining & Heavy Equipment", url: "/mining" }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": seoTitle,
      "description": seoDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://www.forcebeyond.com/#website",
        "name": "ForceBeyond",
        "url": "https://www.forcebeyond.com/"
      },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": socialImage
      },
      "breadcrumb": {
        "@id": `${canonicalUrl}#breadcrumb`
      },
      "about": [
        { "@type": "Thing", "name": "Duplex stainless steel casting" },
        { "@type": "Thing", "name": "Super duplex stainless steel casting" },
        { "@type": "Thing", "name": "ASTM A890 castings" },
        { "@type": "Thing", "name": "2205 duplex stainless steel" },
        { "@type": "Thing", "name": "2507 super duplex stainless steel" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.forcebeyond.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Casting",
          "item": "https://www.forcebeyond.com/casting/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Investment Casting",
          "item": "https://www.forcebeyond.com/investment-casting/"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Duplex Stainless Steel Casting",
          "item": canonicalUrl
        }
      ]
    },
    {
      "@type": "Service",
      "@id": `${canonicalUrl}#service`,
      "name": "Duplex and Super Duplex Stainless Steel Casting Services",
      "serviceType": "Duplex Stainless Steel Investment Casting and Precision Manufacturing",
      "description": seoDescription,
      "url": canonicalUrl,
      "provider": {
        "@id": "https://www.forcebeyond.com/#organization"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United States"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Duplex Stainless Steel Casting Capabilities",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "ASTM A890 Duplex Stainless Steel Casting",
              "description": "Investment casting of duplex stainless grades for corrosion-resistant valves, pumps, manifolds, and industrial flow-control components."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Super Duplex Stainless Steel Casting",
              "description": "Casting of higher-alloy super duplex grades for chloride-bearing, marine, subsea, desalination, and chemical-processing applications."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Machined and Heat-Treated Duplex Castings",
              "description": "Coordinated solution treatment, water quenching, CNC machining, finishing, NDT, corrosion testing, and project-specific documentation."
            }
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }
  ]
};
---

<IndividualPageLayout
    title={seoTitle}
    description={seoDescription}
    canonicalUrl={canonicalUrl}
    robots="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    schema={pageSchema}
    pageTitle={pageTitle}
    heroImage="/media/stainless-steel-investment-casting-components-hero.webp"
    heroImageAlt="Duplex and super duplex stainless steel casting components and foundry processing"
    heroImageWidth={1920}
    heroImageHeight={1080}
    socialImage={socialImage}
    socialImageAlt="Duplex stainless steel casting services for corrosion-resistant components"
    faqSectionTitle="Frequently Asked Questions: Duplex Stainless Steel Casting"
    faqItems={faqs}
    ctaTitle="Request a Duplex Stainless Steel Casting Quote"
    ctaDescription="Send your drawing, CAD model, alloy specification, quantity, corrosion environment, heat-treatment, machining, inspection, testing, and delivery requirements for an engineering review."
    ctaButtonText="Request a Duplex Casting Quote"
    sourcesTitle="Technical References"
    sourcesList={sources}
    resourcesTitle="Related Duplex Casting, Machining, Quality and Materials Resources"
    resourcesList={internalResources}
>
    <div slot="full-width" class="individual-content">

        <section id="overview">
            <div class="content-container">
                <h2>Custom Duplex and Super Duplex Stainless Steel Casting</h2>

                <div class="grid gap-10 lg:grid-cols-2 lg:items-center mt-6">
                    <div>
                        <p>
                            ForceBeyond provides custom <strong>duplex stainless steel casting services</strong> and super duplex casting for corrosion-resistant, high-strength metal components. Duplex alloys combine ferritic and austenitic phases, offering higher strength and improved resistance to chloride stress-corrosion cracking compared with many conventional austenitic stainless steels.
                        </p>
                        <p>
                            Programs may include ASTM A890 and customer-specified cast duplex grades for valves, pumps, manifolds, impellers, pressure-containing components, and marine hardware. ForceBeyond coordinates
                            <a href="/investment-casting" class="highlight-link">investment casting</a>,
                            <a href="/duplex-machining" class="highlight-link">duplex stainless steel machining</a>,
                            solution treatment, finishing, inspection, and documentation through an integrated manufacturing network.
                        </p>
                    </div>

                    <div class="relative">
                        <div class="overflow-hidden">
                            <img
                                src="/media/duplex-stainless-steel-submersible-pump-housing-4k.webp"
                                alt="Duplex stainless steel cast pump housing with machined flanges and mounting features"
                                width="1200"
                                height="900"
                                loading="lazy"
                                decoding="async"
                                class="w-full h-auto object-cover hover:scale-105 transition-transform duration-500"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="process-selection">
            <div class="content-container">
                <h2>When to Choose Duplex Stainless Steel Casting</h2>
                <p>
                    Duplex and super duplex stainless steel casting is often selected when a component requires a combination of mechanical strength, resistance to chloride stress-corrosion cracking, and improved pitting or crevice-corrosion performance.
                </p>
                <ul>
                    <li><strong>Chloride-bearing service:</strong> seawater, brine, desalination, offshore, and selected chemical-processing environments.</li>
                    <li><strong>High-strength designs:</strong> higher yield strength may support reduced section thickness where permitted by code and design analysis.</li>
                    <li><strong>Complex flow components:</strong> pump housings, impellers, valve bodies, manifolds, and pressure-containing geometries.</li>
                    <li><strong>Near-net-shape efficiency:</strong> investment casting can reduce machining on strong, work-hardening duplex alloys.</li>
                    <li><strong>Specification-driven projects:</strong> applications requiring ASTM, UNS, NACE, ISO, customer, or industry-specific material controls.</li>
                </ul>
            </div>
        </section>

        <section id="alloy-capabilities">
            <div class="content-container">
                <h2>Duplex and Super Duplex Casting Grades</h2>
                <p>
                    Grade designations, chemical composition, ferrite balance, mechanical properties, and corrosion performance should be confirmed against the applicable cast-alloy specification. The information below is general guidance rather than a substitute for the governing material standard.
                </p>

                <div class="content-table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Material Category</th>
                                <th scope="col">Representative Cast Grades</th>
                                <th scope="col">Typical Characteristics and Applications</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Standard Duplex Stainless Steel</th>
                                <td>ASTM A890 Grade 4A and related customer-specified cast duplex grades</td>
                                <td>Good strength and resistance to chloride stress-corrosion cracking for pumps, valves, manifolds, desalination equipment, and chemical-processing components.</td>
                            </tr>
                            <tr>
                                <th scope="row">Super Duplex Stainless Steel</th>
                                <td>ASTM A890 Grade 5A and related high-alloy cast grades</td>
                                <td>Higher chromium, molybdenum, and nitrogen content for more demanding chloride, marine, subsea, and offshore environments.</td>
                            </tr>
                            <tr>
                                <th scope="row">High-Alloy Super Duplex Grades</th>
                                <td>Grade 6A and project-specific proprietary or customer-specified grades</td>
                                <td>Selected for severe corrosion environments, acid service, mining, slurry handling, desalination, and specialized flow-control equipment.</td>
                            </tr>
                            <tr>
                                <th scope="row">Cast Duplex Pump and Valve Grades</th>
                                <td>CD4MCuN and other specification-controlled cast duplex alloys</td>
                                <td>Used in pumps, impellers, valve bodies, and erosion-corrosion service where mechanical strength and corrosion resistance are both required.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section id="metallurgical-control">
            <div class="content-container">
                <h2>Metallurgical Control for Duplex Stainless Steel Castings</h2>
                <p>
                    Duplex casting performance depends on more than chemical composition. Melting, pouring, solidification, solution treatment, quenching, welding, and subsequent thermal exposure can affect phase balance, toughness, and corrosion resistance.
                </p>
                <ul>
                    <li><strong>Solution treatment and quenching:</strong> thermal cycles should dissolve harmful intermetallic phases and restore the required microstructure.</li>
                    <li><strong>Ferrite control:</strong> ferrite content should be evaluated according to the governing specification and service requirement.</li>
                    <li><strong>Intermetallic-phase avoidance:</strong> uncontrolled thermal exposure may promote sigma or other detrimental phases.</li>
                    <li><strong>Corrosion testing:</strong> ASTM G48 or other project-specific tests may be required for critical chloride service.</li>
                    <li><strong>Material verification:</strong> chemistry, mechanical testing, ferrite evaluation, and heat-treatment records should match purchase-order requirements.</li>
                </ul>
            </div>
        </section>

        <section id="design-guidelines">
            <div class="content-container">
                <h2>Duplex Stainless Steel Casting Design Guidelines</h2>
                <ul>
                    <li><strong>Wall transitions:</strong> avoid abrupt section changes that can create hot spots, shrinkage, and heat-treatment variation.</li>
                    <li><strong>Machining allowance:</strong> add controlled stock to sealing surfaces, bores, datums, and pressure-critical interfaces.</li>
                    <li><strong>Corrosion-sensitive geometry:</strong> identify crevices, stagnant zones, gasket interfaces, and dead legs during design review.</li>
                    <li><strong>Pressure-containing features:</strong> define NDT, hydrostatic testing, leak testing, and documentation requirements before tooling release.</li>
                    <li><strong>Welding and repair:</strong> establish whether weld repair is permitted and which qualification, heat-treatment, and inspection rules apply.</li>
                </ul>
            </div>
        </section>

        <section id="integrated-processing">
            <div class="content-container">
                <h2>Duplex Casting, Machining and Secondary Operations</h2>
                <p>
                    Duplex castings often require coordinated machining, heat treatment, surface conditioning, inspection, and testing before delivery.
                </p>
                <ul>
                    <li><strong><a href="/duplex-machining" class="highlight-link">Duplex stainless steel machining:</a></strong> rigid setups, controlled cutting parameters, and suitable tooling for bores, sealing faces, threads, flanges, and complex profiles.</li>
                    <li><strong><a href="/heat-treatment" class="highlight-link">Heat treatment:</a></strong> solution treatment and rapid quenching according to alloy and specification.</li>
                    <li><strong><a href="/surface-finishing" class="highlight-link">Surface finishing:</a></strong> blasting, pickling, passivation, polishing, and project-specific protective treatments.</li>
                    <li><strong><a href="/testing-inspection-capabilities" class="highlight-link">Inspection and testing:</a></strong> dimensional inspection, penetrant testing, radiography, ultrasonic testing, ferrite measurement, corrosion testing, and pressure testing as required.</li>
                    <li><strong><a href="/assembly-and-kitting" class="highlight-link">Assembly and kitting:</a></strong> seals, inserts, hardware, sub-assembly, labeling, and protective packaging.</li>
                </ul>
            </div>
        </section>

        <section id="industry-applications">
            <div class="content-container">
                <h2>Duplex and Super Duplex Casting Applications</h2>
                <ul>
                    <li><strong><a href="/oil-gas" class="highlight-link">Oil and gas:</a></strong> valve bodies, pump components, manifolds, subsea hardware, and sour-service components where permitted by the governing specification.</li>
                    <li><strong><a href="/hvac-flow" class="highlight-link">Fluid and flow control:</a></strong> impellers, pump housings, valve bodies, fittings, strainers, and pressure-containing flow components.</li>
                    <li><strong><a href="/energy-power-generation" class="highlight-link">Energy and power generation:</a></strong> cooling-water components, pumps, valves, and corrosion-resistant hardware.</li>
                    <li><strong>Desalination and marine:</strong> high-pressure pumps, seawater intake components, manifolds, and marine hardware.</li>
                    <li><strong>Chemical processing:</strong> agitators, pump parts, valve components, acid-transfer equipment, and corrosion-resistant fittings.</li>
                    <li><strong><a href="/mining" class="highlight-link">Mining and slurry handling:</a></strong> pump components, impellers, housings, and erosion-corrosion-resistant hardware.</li>
                </ul>
            </div>
        </section>

    </div>
</IndividualPageLayout>
