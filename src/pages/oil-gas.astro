---
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';

const pageTitle = 'Oil & Gas Components: Casting, Forging & CNC Machining';
const seoTitle = 'Oil & Gas Components | Casting, Forging & CNC Machining';
const seoDescription = 'ForceBeyond supports upstream, midstream, downstream, subsea, and petrochemical projects with valve bodies, pump components, manifolds, pressure-containing castings, forgings, rolled rings, CNC machining, heat treatment, coatings, NDT, and project-specific documentation.';

const canonicalUrl = 'https://www.forcebeyond.store/oil-gas/';
const socialImage = 'https://www.forcebeyond.store/media/offshore-oil-gas-processing-platform-industrial-equipment-hero.webp';

const faqs = [
    {
        q: "Can ForceBeyond support NACE MR0175 / ISO 15156 sour-service components?",
        a: "ForceBeyond may support sour-service projects when the customer defines the applicable material, hardness, heat treatment, environmental limits, product form, welding, manufacturing route, testing, and documentation requirements. Compliance must be established for the specific material condition and service environment; it should not be assumed for every duplex, super duplex, nickel-alloy, or steel component."
    },
    {
        q: "Can ForceBeyond provide EN 10204 3.1 material certificates?",
        a: "EN 10204 3.1 inspection documents may be supplied when required by the purchase specification and supported by the approved material source and documentation package. The exact records—such as heat number, chemistry, mechanical properties, impact data, heat treatment, NDT, or PMI—should be defined before quotation."
    },
    {
        q: "What inspection methods are used for pressure-containing oil and gas components?",
        a: "Depending on product form and specification, inspection may include radiography, ultrasonic testing, magnetic-particle or penetrant inspection, dimensional inspection, hardness, PMI, mechanical testing, hydrostatic or pneumatic pressure testing, leak testing, coating inspection, and documentation review."
    },
    {
        q: "What information is needed for an oil and gas component quote?",
        a: "Provide drawings, CAD, material and product form, pressure class, temperature, fluid composition, sour-service or chloride conditions, annual quantity, heat treatment, coating, NDT, pressure or leak testing, quality documentation, approved-source restrictions, packaging, and delivery requirements."
    }
];

const sources = [
    { label: 'AMPP - NACE MR0175 / ISO 15156 and Corrosion Resources', url: 'https://www.ampp.org/' },
    { label: 'American Petroleum Institute - Oil and Gas Equipment Standards', url: 'https://www.api.org/products-and-services/standards' },
    { label: 'ASME - Pressure Equipment and Piping Standards', url: 'https://www.asme.org/codes-standards' },
    { label: 'ASTM International - Oil, Gas, Materials and Testing Standards', url: 'https://www.astm.org/' },
    { label: 'ASM International - Corrosion, Alloy and Oilfield Materials Resources', url: 'https://www.asminternational.org/' },
    { label: 'Forging Industry Association - Forging Resources', url: 'https://www.forging.org/' }
];

const internalResources = [
    // Industry Hubs
    { label: "Energy & Power Generation", url: "/energy-power-generation" },
    { label: "Power Generation", url: "/power-generation" },
    { label: "Data Center Power", url: "/data-center-power" },
    { label: "Nuclear & SMR", url: "/nuclear-smr" },
    { label: "HVAC, Fluid & Flow Control", url: "/hvac-flow" },

    // Casting
    { label: "Casting Capabilities", url: "/casting" },
    { label: "Investment Casting", url: "/investment-casting" },
    { label: "Sand Casting", url: "/sand-casting" },
    { label: "Inconel Vacuum Precision Casting", url: "/inconel-vacuum-precision-casting" },
    { label: "Stainless Steel Casting", url: "/stainless-steel-casting" },
    { label: "Duplex Stainless Steel Casting", url: "/duplex-stainless-steel-casting" },
    { label: "Carbon & Low-Alloy Steel Casting", url: "/carbon-steel-casting" },

    // Forging
    { label: "Forging Capabilities", url: "/forging" },
    { label: "Open Die Forging", url: "/open-die-forging" },
    { label: "Closed Die Forging", url: "/closed-die-forging" },
    { label: "Rolled Ring Forging", url: "/rolled-ring-forging" },
    { label: "Superalloy Forging Services", url: "/high-performance-superalloy-forging" },

    // Machining and Secondary Operations
    { label: "Precision Machining", url: "/precision-machining" },
    { label: "High-Precision Component Machining", url: "/high-precision-machining" },
    { label: "Multi-Axis CNC Milling & Turning", url: "/multi-axis-cnc" },
    { label: "Inconel 718 Machining", url: "/inconel-718-machining" },
    { label: "Inconel 625 Machining", url: "/inconel-625-machining" },
    { label: "Hot Isostatic Pressing (HIP)", url: "/hot-isostatic-pressing" },
    { label: "Heat Treatment", url: "/heat-treatment" },
    { label: "Surface Finishing & Coating", url: "/surface-finishing" },
    { label: "Assembly & Kitting", url: "/assembly-and-kitting" },

    // Materials, Quality, and Supply Chain
    { label: "Superalloys & Exotic Metals", url: "/superalloys-exotic-metals" },
    { label: "Stainless Steel & Carbon Steel", url: "/stainless-carbon-steel" },
    { label: "Materials & Technical Specifications", url: "/materials-technical-specs" },
    { label: "Material Cross-Reference Charts", url: "/material-cross-reference-charts" },
    { label: "Manufacturing Design Guides", url: "/manufacturing-design-guides" },
    { label: "Quality Assurance & Certifications", url: "/quality-assurance-certifications" },
    { label: "Testing & Inspection Capabilities", url: "/testing-inspection-capabilities" },
    { label: "Global Footprint & Logistics", url: "/global-footprint-logistics" }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": seoTitle,
      "description": seoDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://www.forcebeyond.store/#website",
        "name": "ForceBeyond",
        "url": "https://www.forcebeyond.store/"
      },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": socialImage
      },
      "breadcrumb": {
        "@id": `${canonicalUrl}#breadcrumb`
      },
      "about": [
        { "@type": "Thing", "name": "Oil and gas components" },
        { "@type": "Thing", "name": "Subsea manufacturing" },
        { "@type": "Thing", "name": "Sour-service materials" },
        { "@type": "Thing", "name": "Pressure-containing castings and forgings" },
        { "@type": "Thing", "name": "Oilfield valve and pump components" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.forcebeyond.store/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Industries",
          "item": "https://www.forcebeyond.store/industries/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Oil & Gas",
          "item": canonicalUrl
        }
      ]
    },
    {
      "@type": "Service",
      "@id": `${canonicalUrl}#service`,
      "name": "Oil and Gas Component Manufacturing",
      "serviceType": "Casting, Forging, Machining and Inspection for Oilfield and Petrochemical Equipment",
      "description": seoDescription,
      "url": canonicalUrl,
      "provider": {
        "@id": "https://www.forcebeyond.store/#organization"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United States"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Oil and Gas Manufacturing Capabilities",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Pressure-Containing Valve and Manifold Components",
              "description": "Project-specific valve bodies, bonnets, manifolds, flange adapters, closures, fittings, and pressure-boundary hardware."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Drilling and Downhole Components",
              "description": "Forged and machined collars, housings, sleeves, fluid ends, covers, crossheads, and downhole structural hardware."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Pump and Rotating Equipment Components",
              "description": "Cast, forged, and machined volutes, impellers, shafts, diffusers, housings, rings, and wear components."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Inspection, Pressure Testing and Documentation",
              "description": "Project-specific NDT, CMM, hardness, PMI, material testing, hydrostatic or leak testing, traceability, and quality records."
            }
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }
  ]
};
---

<IndividualPageLayout
    title={seoTitle}
    description={seoDescription}
    canonicalUrl={canonicalUrl}
    robots="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    schema={pageSchema}
    pageTitle={pageTitle}
    heroImage="/media/industry-oil-gas-plant.webp"
    heroImageAlt="Oil and gas processing infrastructure with pipelines, towers, and pressure equipment"
    heroImageWidth={1920}
    heroImageHeight={1080}
    socialImage={socialImage}
    socialImageAlt="Oil and gas casting, forging and machining services"
    faqSectionTitle="Frequently Asked Questions: Oil & Gas Components"
    faqItems={faqs}
    ctaTitle="Review an Oil & Gas Component Program"
    ctaDescription="Send your drawings, material, pressure class, service environment, quantity, heat treatment, coating, NDT, pressure testing, documentation, approved-source restrictions, and delivery requirements for an engineering review."
    ctaButtonText="Request an Oil & Gas Review"
    sourcesTitle="Oil, Gas, Corrosion and Manufacturing References"
    sourcesList={sources}
    resourcesTitle="Related Oil & Gas, Casting, Forging, Machining and Quality Resources"
    resourcesList={internalResources}
>
    <div slot="full-width" class="individual-content">

        <section id="overview">
            <div class="content-container">
                <h2>Manufacturing Support for Upstream, Midstream and Downstream Equipment</h2>

                <div class="grid gap-10 lg:grid-cols-2 lg:items-center mt-6">
                    <div>
                        <p>
                            Oil and gas equipment may operate under high pressure, cyclic loading, sour gas, chlorides, seawater, erosion, abrasion, temperature extremes, and corrosive process fluids.
                        </p>
                        <p>
                            ForceBeyond supports upstream, midstream, downstream, subsea, and petrochemical programs through
                            <a href="/casting" class="highlight-link">casting</a>,
                            <a href="/forging" class="highlight-link">forging</a>,
                            <a href="/precision-machining" class="highlight-link">precision machining</a>,
                            heat treatment, HIP where specified, coatings, NDT, pressure testing, assembly, and supply-chain coordination.
                        </p>
                        <p>
                            Material suitability, NACE or API applicability, pressure class, source approval, inspection level, and documentation must be established for the specific component and service environment.
                        </p>
                    </div>

                    <div class="relative">
                        <div class="overflow-hidden">
                            <img
                                src="/media/offshore-oil-gas-processing-platform-industrial-equipment-hero.webp"
                                alt="Offshore oil and gas processing equipment with pressure-containing valves and manifolds"
                                width="1200"
                                height="900"
                                loading="lazy"
                                decoding="async"
                                class="w-full h-auto object-cover hover:scale-105 transition-transform duration-500"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="sector-matrix">
            <div class="content-container">
                <h2>Oil and Gas Sector Component Matrix</h2>

                <div class="content-table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Sector</th>
                                <th scope="col">Representative Components</th>
                                <th scope="col">Potential Manufacturing Routes</th>
                                <th scope="col">Key Engineering Requirements</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Upstream and Drilling</th>
                                <td>Fluid ends, drill collars, housings, sleeves, crossheads, covers, valve parts, downhole tools</td>
                                <td>Open-die forging, closed-die forging, bar or billet machining, heat treatment, surface treatment, NDT</td>
                                <td>Fatigue, impact, pressure, hardness control, wear, sour service, thread integrity, and traceability</td>
                            </tr>
                            <tr>
                                <th scope="row">Subsea Production</th>
                                <td>Valve bodies, manifolds, connectors, hubs, flanges, adapters, pump and actuator housings</td>
                                <td>Investment casting, forging, rolled rings, machining, cladding or coating where specified, pressure testing</td>
                                <td>Pressure containment, seawater and chloride corrosion, sour service, fatigue, leak integrity, NDT, and documentation</td>
                            </tr>
                            <tr>
                                <th scope="row">Midstream Pipeline and Compression</th>
                                <td>Valve bodies, compressor parts, rings, shafts, impellers, flanges, fittings, pigging and metering hardware</td>
                                <td>Sand or investment casting, forging, machining, heat treatment, coating, pressure and functional testing</td>
                                <td>Pressure class, fracture toughness, corrosion, erosion, low-temperature performance, sealing, and maintainability</td>
                            </tr>
                            <tr>
                                <th scope="row">Downstream and Petrochemical</th>
                                <td>Pump components, valve hardware, manifolds, furnace and heat-exchanger parts, nozzles, fittings, rotating components</td>
                                <td>Casting, forging, machining, heat treatment, welding or overlay where approved, coating, inspection</td>
                                <td>Process-fluid corrosion, high temperature, creep, oxidation, pressure integrity, cleanliness, and alloy compatibility</td>
                            </tr>
                            <tr>
                                <th scope="row">LNG and Cryogenic Systems</th>
                                <td>Valve bodies, stems, manifolds, pump parts, fittings, flanges, housings, transfer-system hardware</td>
                                <td>Investment casting, forging, machining, solution treatment, surface finishing, leak and cryogenic testing</td>
                                <td>Low-temperature toughness, dimensional stability, sealing, thermal cycling, cleanliness, and material compatibility</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section id="component-portfolio">
            <div class="content-container">
                <h2>Oilfield and Petrochemical Component Portfolio</h2>

                <div class="content-table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Component Family</th>
                                <th scope="col">Representative Hardware</th>
                                <th scope="col">Common Product Forms</th>
                                <th scope="col">Typical Verification</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Pressure-Containing Equipment</th>
                                <td>Valve bodies, bonnets, manifold blocks, flanges, closures, hubs, adapters, fittings</td>
                                <td>Forgings, investment castings, sand castings, rolled rings, wrought stock</td>
                                <td>NDT, material verification, CMM, pressure testing, leak testing, hardness, documentation</td>
                            </tr>
                            <tr>
                                <th scope="row">Drilling and Downhole Hardware</th>
                                <td>Drill collars, housings, sleeves, fluid ends, covers, crossheads, tool bodies</td>
                                <td>Open-die forgings, closed-die forgings, alloy-steel bar or tube, machined billet</td>
                                <td>UT, magnetic-particle inspection, hardness, mechanical testing, thread inspection, dimensions</td>
                            </tr>
                            <tr>
                                <th scope="row">Pump and Rotating Components</th>
                                <td>Volutes, impellers, shafts, diffusers, wear rings, sleeves, casings, bearing housings</td>
                                <td>Castings, forgings, rolled rings, wrought stock</td>
                                <td>Radiography or UT as applicable, dimensional inspection, balance, pressure testing, surface finish</td>
                            </tr>
                            <tr>
                                <th scope="row">Subsea and Flow-Control Hardware</th>
                                <td>Manifolds, connectors, valve blocks, actuator housings, clamp hubs, flange adapters</td>
                                <td>Forgings, castings, rolled rings, machined blocks</td>
                                <td>Pressure and leak testing, NDT, PMI, coating, corrosion requirements, traceability</td>
                            </tr>
                            <tr>
                                <th scope="row">Refining and Process Equipment</th>
                                <td>Valve and pump parts, nozzles, fittings, furnace hardware, heat-exchanger components</td>
                                <td>Castings, forgings, machined wrought alloys, approved weldments</td>
                                <td>Material compatibility, hardness, corrosion testing, NDT, dimensional inspection, process records</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section id="materials">
            <div class="content-container">
                <h2>Materials for Oil, Gas, Subsea and Petrochemical Components</h2>

                <div class="content-table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Material Family</th>
                                <th scope="col">Representative Applications</th>
                                <th scope="col">Primary Selection Drivers</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Duplex and Super Duplex Stainless Steels</th>
                                <td>Subsea valves, manifolds, pump parts, connectors, seawater and chloride-service components</td>
                                <td>Pitting and crevice corrosion, chloride SCC, strength, ferrite balance, heat treatment, welding, and NACE limits</td>
                            </tr>
                            <tr>
                                <th scope="row">Nickel-Base Alloys</th>
                                <td>Sour-service hardware, high-temperature process components, cladding, valve and pump parts</td>
                                <td>H2S, chloride, acid, temperature, strength, weldability, heat treatment, and machining</td>
                            </tr>
                            <tr>
                                <th scope="row">Low-Alloy and High-Strength Steels</th>
                                <td>Drilling tools, shafts, rings, flanges, fluid ends, pressure and structural hardware</td>
                                <td>Strength, toughness, fatigue, hardenability, hardness limits, section size, and hydrogen-related risks</td>
                            </tr>
                            <tr>
                                <th scope="row">Carbon and Low-Alloy Cast Steels</th>
                                <td>Valve bodies, pump housings, fittings, manifolds, general pressure equipment</td>
                                <td>Castability, pressure class, weldability, impact properties, heat treatment, NDT, and corrosion allowance</td>
                            </tr>
                            <tr>
                                <th scope="row">Stainless, Copper and Specialty Alloys</th>
                                <td>Cryogenic, chemical-processing, heat-transfer, instrumentation, and corrosion-resistant components</td>
                                <td>Process chemistry, temperature, conductivity, galling, cleanliness, joining, and surface condition</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <p>
                    Review
                    <a href="/superalloys-exotic-metals" class="highlight-link">superalloys and exotic metals</a>,
                    <a href="/stainless-carbon-steel" class="highlight-link">stainless and carbon steels</a>,
                    and
                    <a href="/materials-technical-specs" class="highlight-link">materials and technical specifications</a>.
                </p>
            </div>
        </section>

        <section id="sour-service">
            <div class="content-container">
                <h2>Sour-Service and NACE MR0175 / ISO 15156 Planning</h2>
                <p>
                    Sour-service suitability depends on the complete material condition and environment—not only the alloy name.
                </p>
                <ul>
                    <li><strong>Environmental limits:</strong> define H2S partial pressure, chloride content, pH, temperature, pressure, elemental sulfur, and produced-fluid chemistry.</li>
                    <li><strong>Material condition:</strong> control grade, heat treatment, hardness, strength, cold work, weld procedure, repair, and product form.</li>
                    <li><strong>Manufacturing route:</strong> casting, forging, machining, welding, cladding, and coating can affect final properties and compliance.</li>
                    <li><strong>Testing and documentation:</strong> identify hardness, chemistry, microstructure, SSC, HIC, corrosion, PMI, and certificate requirements.</li>
                    <li><strong>Customer approval:</strong> final material selection and acceptance should be confirmed by the equipment designer or operator.</li>
                </ul>
            </div>
        </section>

        <section id="casting">
            <div class="content-container">
                <h2>Cast Valve, Pump and Manifold Components</h2>
                <ul>
                    <li><strong>Investment casting:</strong> complex near-net valve, flow-control, impeller, manifold, and fitting geometry.</li>
                    <li><strong>Sand casting:</strong> larger valve bodies, pump housings, volutes, covers, and structural pressure components.</li>
                    <li><strong>Vacuum processing:</strong> may be used for selected nickel alloys or reactive materials where chemistry and cleanliness require controlled atmosphere.</li>
                    <li><strong>HIP:</strong> may reduce selected internal porosity in qualified cast products when required by specification.</li>
                    <li><strong>Repair control:</strong> weld repair, blending, impregnation, or other repair methods require defined procedures and customer approval where applicable.</li>
                </ul>
                <p>
                    See
                    <a href="/investment-casting" class="highlight-link">investment casting</a>,
                    <a href="/sand-casting" class="highlight-link">sand casting</a>,
                    and
                    <a href="/duplex-stainless-steel-casting" class="highlight-link">duplex stainless steel casting</a>.
                </p>
            </div>
        </section>

        <section id="forging">
            <div class="content-container">
                <h2>Forged and Rolled-Ring Oilfield Components</h2>
                <ul>
                    <li><strong>Open-die forging:</strong> large shafts, fluid ends, blocks, hubs, collars, discs, and pressure-containing preforms.</li>
                    <li><strong>Closed-die forging:</strong> repeatable near-net valve, fitting, tool, and structural components where volume supports tooling.</li>
                    <li><strong>Rolled rings:</strong> flanges, clamp hubs, pressure rings, bearing rings, connectors, and circumferential hardware.</li>
                    <li><strong>Heat-treatment control:</strong> quench, temper, normalize, solution treat, age, or stress relieve according to material and specification.</li>
                    <li><strong>Test material:</strong> coupons, prolongations, sacrificial zones, or test rings may be required for mechanical and metallurgical verification.</li>
                </ul>
                <p>
                    Review
                    <a href="/open-die-forging" class="highlight-link">open-die forging</a>,
                    <a href="/closed-die-forging" class="highlight-link">closed-die forging</a>,
                    and
                    <a href="/rolled-ring-forging" class="highlight-link">rolled-ring forging</a>.
                </p>
            </div>
        </section>

        <section id="machining">
            <div class="content-container">
                <h2>Precision CNC Machining for Valves, Pumps and Downhole Hardware</h2>
                <ul>
                    <li><strong>Pressure and sealing features:</strong> bores, seats, grooves, flange faces, gasket surfaces, threads, and connector profiles.</li>
                    <li><strong>Complex flow geometry:</strong> manifolds, cross bores, ports, impellers, diffusers, and multi-axis internal or external features.</li>
                    <li><strong>Difficult alloys:</strong> control work hardening, tool wear, heat, chatter, burrs, and surface integrity in duplex and nickel alloys.</li>
                    <li><strong>Thread and gauge control:</strong> verify oilfield, API, premium, customer-specific, or pressure-equipment connections using approved gauges and methods.</li>
                    <li><strong>Final inspection:</strong> CMM, gauges, profilometry, pressure testing, leak testing, and visual or borescope inspection as required.</li>
                </ul>
                <p>
                    See
                    <a href="/multi-axis-cnc" class="highlight-link">multi-axis CNC machining</a>,
                    <a href="/inconel-625-machining" class="highlight-link">Inconel 625 machining</a>,
                    and
                    <a href="/high-precision-machining" class="highlight-link">high-precision machining</a>.
                </p>
            </div>
        </section>

        <section id="inspection">
            <div class="content-container">
                <h2>NDT, Pressure Testing and Material Verification</h2>

                <div class="content-table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Method</th>
                                <th scope="col">Typical Use</th>
                                <th scope="col">Planning Considerations</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Radiographic Testing</th>
                                <td>Volumetric evaluation of selected castings and weldments</td>
                                <td>Geometry, section thickness, technique, image quality, defect orientation, and acceptance criteria</td>
                            </tr>
                            <tr>
                                <th scope="row">Ultrasonic Testing</th>
                                <td>Forgings, rings, shafts, plate, welds, and selected castings</td>
                                <td>Grain structure, attenuation, calibration, scan plan, surface condition, and reference standards</td>
                            </tr>
                            <tr>
                                <th scope="row">Penetrant or Magnetic-Particle Inspection</th>
                                <td>Surface-breaking discontinuities in compatible materials</td>
                                <td>Material compatibility, surface preparation, sensitivity, personnel qualification, and acceptance</td>
                            </tr>
                            <tr>
                                <th scope="row">Hydrostatic, Pneumatic or Leak Testing</th>
                                <td>Pressure boundaries, valves, manifolds, housings, fittings, and flow components</td>
                                <td>Test pressure, medium, dwell, temperature, allowable leakage, safety, cleanliness, and code requirements</td>
                            </tr>
                            <tr>
                                <th scope="row">PMI, Hardness and Material Testing</th>
                                <td>Verify alloy identity, heat-treatment condition, sour-service limits, chemistry, and mechanical properties</td>
                                <td>Method, calibration, location, sampling plan, conversion limits, test coupons, and acceptance criteria</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <p>
                    Review
                    <a href="/testing-inspection-capabilities" class="highlight-link">testing and inspection capabilities</a>
                    for detailed method-selection and reporting guidance.
                </p>
            </div>
        </section>

        <section id="coatings">
            <div class="content-container">
                <h2>Corrosion, Wear and Surface Protection</h2>
                <ul>
                    <li><strong>Protective coatings:</strong> e-coating, powder coating, liquid paint, zinc systems, electroless nickel, thermal spray, or project-specific barriers.</li>
                    <li><strong>Hardfacing and overlays:</strong> may be applied to seats, stems, trim, wear surfaces, or corrosion-critical zones when approved.</li>
                    <li><strong>Passivation and electropolishing:</strong> used for selected stainless components where cleanliness, corrosion, or surface condition requires it.</li>
                    <li><strong>Blasting and preparation:</strong> control surface cleanliness, profile, edge treatment, masking, and coating adhesion.</li>
                    <li><strong>Verification:</strong> define thickness, adhesion, holiday testing, hardness, roughness, corrosion testing, and repair acceptance.</li>
                </ul>
                <p>
                    See
                    <a href="/surface-finishing" class="highlight-link">surface finishing and protective coatings</a>
                    for process-to-material and roughness guidance.
                </p>
            </div>
        </section>

        <section id="quality-documentation">
            <div class="content-container">
                <h2>Traceability, Inspection Documents and Quality Records</h2>
                <ul>
                    <li><strong>Material traceability:</strong> preserve heat, lot, product form, process, and shipment linkage where required.</li>
                    <li><strong>EN 10204 documents:</strong> define whether 2.1, 2.2, 3.1, 3.2, or customer-specific inspection documentation is required.</li>
                    <li><strong>Process records:</strong> include forging, casting, heat treatment, HIP, NDT, coating, repair, and pressure-test records as applicable.</li>
                    <li><strong>Inspection reports:</strong> define CMM, NDT, PMI, hardness, mechanical testing, pressure testing, and final inspection content.</li>
                    <li><strong>Record retention:</strong> specify duration, format, revision control, customer access, and cybersecurity requirements.</li>
                </ul>
                <p>
                    Not every shipment automatically includes every possible material, NDT, mechanical, pressure-test, or inspection record. The documentation package should be defined in the purchase specification.
                </p>
            </div>
        </section>

        <section id="supply-chain">
            <div class="content-container">
                <h2>Oil and Gas Supply Chain and Program Management</h2>
                <ul>
                    <li><strong>Approved sources:</strong> verify mills, forges, foundries, heat treaters, NDT providers, laboratories, coating processors, and repair sources.</li>
                    <li><strong>Long-lead materials:</strong> plan ingot, billet, forged stock, cast alloy, special chemistry, tooling, and test material.</li>
                    <li><strong>Configuration control:</strong> manage drawing, material, pressure class, process, source, tooling, inspection, and documentation revisions.</li>
                    <li><strong>Packaging and preservation:</strong> protect machined surfaces, bores, threads, seals, coatings, and corrosion-sensitive parts.</li>
                    <li><strong>Global logistics:</strong> coordinate export controls, customs, oversized freight, warehousing, safety stock, and delivery milestones.</li>
                </ul>
                <p>
                    Review
                    <a href="/global-footprint-logistics" class="highlight-link">global footprint and logistics</a>
                    for multi-region sourcing, inventory, customs, packaging, and delivery planning.
                </p>
            </div>
        </section>

        <section id="rfq-checklist">
            <div class="content-container">
                <h2>Oil and Gas Component RFQ Checklist</h2>
                <ul>
                    <li><strong>Technical package:</strong> drawing, CAD, revision, bill of materials, component function, and design authority.</li>
                    <li><strong>Material:</strong> alloy, product form, specification, condition, heat treatment, approved source, and test requirements.</li>
                    <li><strong>Service environment:</strong> pressure, temperature, H2S, CO2, chlorides, seawater, process fluid, erosion, and duty cycle.</li>
                    <li><strong>Standards:</strong> applicable API, ASME, ASTM, AMPP/NACE, customer, operator, or project-specific requirements.</li>
                    <li><strong>Inspection:</strong> NDT, hardness, PMI, mechanical testing, pressure or leak testing, dimensions, and acceptance criteria.</li>
                    <li><strong>Documentation:</strong> MTR type, traceability, process records, pressure-test reports, coating records, and retention.</li>
                    <li><strong>Commercial:</strong> prototype quantity, annual demand, lot size, tooling, target delivery, spares, and program duration.</li>
                </ul>
            </div>
        </section>

    </div>
</IndividualPageLayout>
