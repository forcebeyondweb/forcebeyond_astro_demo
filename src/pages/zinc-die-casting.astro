---
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';

const pageTitle = 'Zinc Die Casting Services for Precision ZAMAK Components';
const seoTitle = 'Zinc Die Casting Services | ZAMAK 3, 5 & ZA-8 Parts';
const seoDescription = 'ForceBeyond provides custom zinc die casting services for ZAMAK 2, ZAMAK 3, ZAMAK 5, and ZA-8 components, including hot-chamber casting, tooling, machining, decorative plating, coating, inspection, assembly, and production support.';

const canonicalUrl = 'https://www.forcebeyond.store/zinc-die-casting/';
const socialImage = 'https://www.forcebeyond.store/media/custom-zinc-die-casting-parts-housings-flanges-4k.webp';

const faqs = [
    {
        q: "Why choose zinc instead of aluminum for die casting?",
        a: "Zinc is often selected when a component requires excellent detail reproduction, thin sections, dimensional stability, smooth cosmetic surfaces, decorative plating, or a heavier premium feel. Its lower casting temperature can also support long die life and short hot-chamber cycle times. Aluminum may be preferable when lower density, higher service temperature, or thermal performance is more important."
    },
    {
        q: "Can zinc die castings be plated?",
        a: "Yes. Zinc alloys such as ZAMAK 3, ZAMAK 5, and ZA-8 are widely used for plated and decorative components. Common systems include copper-nickel-chrome, nickel, zinc-based protective coatings, painting, and powder coating. Surface preparation, alloy condition, cosmetic class, corrosion requirements, and plating thickness should be defined before tooling and production."
    },
    {
        q: "Do zinc die castings require secondary machining?",
        a: "Many features can be produced near net shape, reducing the need for machining. Secondary CNC machining may still be required for precision bores, sealing surfaces, threads, bearing fits, datums, or features that cannot be formed reliably in the die. The machining plan should be coordinated with parting lines, ejector locations, draft, and casting tolerances."
    },
    {
        q: "What information is needed for a zinc die casting quote?",
        a: "Provide a 2D drawing and, when available, a 3D CAD model, along with alloy preference, annual and batch quantity, critical tolerances, minimum wall thickness, cosmetic class, plating or coating, machining, inserts, inspection, assembly, packaging, tooling life, and delivery expectations."
    }
];

const sources = [
    { label: 'North American Die Casting Association - Die Casting Resources', url: 'https://www.diecasting.org/' },
    { label: 'International Zinc Association - Zinc Alloy Resources', url: 'https://www.zinc.org/' },
    { label: 'ASTM International - Zinc Alloy and Coating Standards', url: 'https://www.astm.org/' },
    { label: 'American Foundry Society - Metalcasting', url: 'https://www.afsinc.org/about-metalcasting' },
    { label: 'ASM International - Zinc Alloy and Casting Resources', url: 'https://www.asminternational.org/' },
    { label: 'NIST - Manufacturing', url: 'https://www.nist.gov/topics/manufacturing' }
];

const internalResources = [
    // Die Casting
    { label: "Die Casting Overview", url: "/die-casting" },
    { label: "Aluminum Die Casting", url: "/aluminum-die-casting" },
    { label: "Magnesium Casting", url: "/magnesium-casting" },
    { label: "A356-T6 Casting", url: "/a356-t6-casting" },

    // Related Casting
    { label: "Casting Capabilities", url: "/casting" },
    { label: "Investment Casting", url: "/investment-casting" },
    { label: "Sand Casting", url: "/sand-casting" },

    // Machining and Secondary Operations
    { label: "Precision Machining", url: "/precision-machining" },
    { label: "Multi-Axis CNC Milling & Turning", url: "/multi-axis-cnc" },
    { label: "Secondary Operations", url: "/secondary-operations" },
    { label: "Surface Finishing & Coating", url: "/surface-finishing" },
    { label: "Assembly & Kitting", url: "/assembly-and-kitting" },

    // Quality and Technical
    { label: "Testing & Inspection Capabilities", url: "/testing-inspection-capabilities" },
    { label: "Quality Assurance & Certifications", url: "/quality-assurance-certifications" },
    { label: "Materials & Technical Specifications", url: "/materials-technical-specs" },
    { label: "Manufacturing Design Guides", url: "/manufacturing-design-guides" },

    // Industries
    { label: "Automotive", url: "/automotive" },
    { label: "HVAC, Fluid & Flow Control", url: "/hvac-flow" },
    { label: "Medical & Healthcare", url: "/medical" },
    { label: "Space & Defence", url: "/space-defence" },
    { label: "Energy & Power Generation", url: "/energy-power-generation" }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": seoTitle,
      "description": seoDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://www.forcebeyond.store/#website",
        "name": "ForceBeyond",
        "url": "https://www.forcebeyond.store/"
      },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": socialImage
      },
      "breadcrumb": {
        "@id": `${canonicalUrl}#breadcrumb`
      },
      "about": [
        { "@type": "Thing", "name": "Zinc die casting" },
        { "@type": "Thing", "name": "Hot-chamber die casting" },
        { "@type": "Thing", "name": "ZAMAK 3" },
        { "@type": "Thing", "name": "ZAMAK 5" },
        { "@type": "Thing", "name": "ZA-8 zinc alloy" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.forcebeyond.store/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Casting",
          "item": "https://www.forcebeyond.store/casting/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Die Casting",
          "item": "https://www.forcebeyond.store/die-casting/"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Zinc Die Casting",
          "item": canonicalUrl
        }
      ]
    },
    {
      "@type": "Service",
      "@id": `${canonicalUrl}#service`,
      "name": "Zinc Die Casting Services",
      "serviceType": "Hot-Chamber Zinc Die Casting and Precision Manufacturing",
      "description": seoDescription,
      "url": canonicalUrl,
      "provider": {
        "@id": "https://www.forcebeyond.store/#organization"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United States"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Zinc Die Casting Capabilities",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "ZAMAK 3 Zinc Die Casting",
              "description": "Hot-chamber die casting of ZAMAK 3 components requiring dimensional stability, castability, fine details, and decorative finishing."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "ZAMAK 5 and ZA-8 Zinc Die Casting",
              "description": "Higher-strength zinc alloy casting for hardware, housings, decorative parts, mechanical components, and wear-related applications."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Decorative Plating and Surface Finishing",
              "description": "Coordinated plating, polishing, painting, powder coating, conversion coating, deburring, and cosmetic inspection for zinc die-cast parts."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Machined and Assembled Zinc Die Castings",
              "description": "Integrated CNC machining, insert installation, inspection, assembly, labeling, and protective packaging."
            }
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
