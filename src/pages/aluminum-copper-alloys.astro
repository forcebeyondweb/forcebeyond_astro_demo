---
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';

const pageTitle = 'Aluminum & Copper Alloys for Casting, Forging and Machining';
const seoTitle = 'Aluminum & Copper Alloys | A356, A380, 6061 & Copper';
const seoDescription = 'Explore ForceBeyond manufacturing support for aluminum, copper, brass, and bronze alloys through die casting, sand casting, forging, CNC machining, heat treatment, finishing, leak testing, inspection, and material documentation.';

const canonicalUrl = 'https://www.forcebeyond.com/aluminum-copper-alloys/';
const socialImage = 'https://www.forcebeyond.com/media/precision-cnc-machining-metal-manufacturing-workshop-hero.webp';

const faqs = [
    {
        q: "What does T6 heat treatment do for cast aluminum?",
        a: "T6 heat treatment typically combines solution heat treatment, quenching, and artificial aging to increase strength and hardness in heat-treatable aluminum alloys such as A356. Final properties depend on chemistry, casting quality, section thickness, solution cycle, quench rate, aging cycle, and the governing material specification."
    },
    {
        q: "How are aluminum manifolds and valve bodies checked for leakage?",
        a: "Leak verification may use pressure decay, air-under-water, helium, hydrostatic, pneumatic, or application-specific test methods. The required test pressure, leak rate, medium, dwell time, and acceptance criteria should be defined by the drawing, purchase order, and service conditions. Not every component requires helium testing."
    },
    {
        q: "What is the difference between cast and wrought aluminum alloys?",
        a: "Cast alloys are formulated for fluidity, mold filling, solidification, and near-net-shape manufacturing. Wrought alloys are processed as plate, bar, extrusion, sheet, or forgings and are often selected for structural properties, machinability, or forming. Similar alloy numbers should not be treated as interchangeable across product forms."
    },
    {
        q: "What information is needed for an aluminum or copper alloy quote?",
        a: "Provide a 2D drawing and, when available, a 3D CAD model, along with alloy grade, governing specification, product form, quantity, thermal or electrical requirements, heat treatment, machining, coating, leak testing, inspection, documentation, and delivery expectations."
    }
];

const sources = [
    { label: 'ASM International - Aluminum, Copper and Nonferrous Alloy Resources', url: 'https://www.asminternational.org/' },
    { label: 'ASTM International - Aluminum and Copper Alloy Standards', url: 'https://www.astm.org/' },
    { label: 'The Aluminum Association - Aluminum Alloy Resources', url: 'https://www.aluminum.org/' },
    { label: 'Copper Development Association - Copper and Brass Resources', url: 'https://www.copper.org/' },
    { label: 'NIST - Materials and Manufacturing', url: 'https://www.nist.gov/topics/materials' },
    { label: 'North American Die Casting Association - Die Casting Resources', url: 'https://www.diecasting.org/' }
];

const internalResources = [
    // Materials Hub
    { label: "Materials & Technical Specifications", url: "/materials-technical-specs" },
    { label: "Superalloys & Exotic Metals", url: "/superalloys-exotic-metals" },
