---
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';
import { pageDates } from '../data/page-dates.js';

const pageTitle = 'Titanium Forging Services: Qualified Co-Owned Facilities';
const seoTitle = 'Titanium Forging Services | AS9100 Manufacturing | ForceBeyond';
const seoDescription = 'Tier-1.5 titanium forging supplier with co-owned and operationally managed facilities in the USA, South Korea, and Taiwan. Certification scope is verified for each project.';

const dates = pageDates['/titanium-forging/'];
const faqs = [
    {
        q: "How does ForceBeyond manage quality across three countries?",
        a: "We don’t just “source”—we co-own and operationally manage facilities in the USA, South Korea, and Taiwan. Our US-led engineering team coordinates quality oversight, while each selected facility’s certification status and scope are verified for the project."
    },
    {
        q: "Does ForceBeyond hold the AS9100 certification?",
        a: "ForceBeyond is the management and engineering entity. Manufacturing certifications apply at the facility level, so the AS9100 status and scope of the facility selected for a project must be confirmed against the applicable customer and program requirements."
    }
];

// Sources
const sources = [
    {
        label: "SAE International - AMS 4928 Ti-6Al-4V Bars, Forgings, Rings and Forging Stock",
        url: "https://saemobilus.sae.org/standards/ams4928x-titanium-alloy-bars-wire-forgings-flash-welded-rings-drawn-shapes-6al-4v-annealed"
    },
    {
        label: "SAE International - AMS 4976 Ti-6Al-2Sn-4Zr-2Mo Forgings and Forging Stock",
        url: "https://saemobilus.sae.org/standards/ams4976-titanium-alloy-forgings-6al-2sn-4zr-2mo-solution-precipitation-heat-treated"
    },
    {
        label: "SAE International - AMS 4983 Ti-10V-2Fe-3Al Forgings",
        url: "https://saemobilus.sae.org/standards/ams4983g-titanium-alloy-forgings-10v-2fe-3al-consumable-electrode-melted-single-step-solution-heat-treated-aged-180-ksi-1241-mpa-tensile-strength"
    },
    {
        label: "SAE International - AMS 4984 Ti-10V-2Fe-3Al Forgings",
        url: "https://saemobilus.sae.org/standards/ams4984-titanium-alloy-forgings-10v-2fe-3al-consumable-electrode-melted-solution-heat-treated-aged-173000-psi-1195-mpa-tensile-strength"
    },
    {
        label: "Forging Industry Association - Forgings Compared with Machined Bar and Plate",
        url: "https://www.forging.org/fia/content/about/design-engineering-center-content/How_Forgings_Compare_to_Other_Processes.aspx"
    }
];

// Resources 
const internalResources = [
    // Primary titanium forging spokes
    { label: "Titanium Aerospace Forging", url: "/titanium-aerospace-forging/" },
    { label: "High-Strength Beta Titanium Forging", url: "/high-strength-beta-titanium-forging/" },
    { label: "Near-Net-Shape Titanium Forging", url: "/near-net-shape-titanium-forging/" },

    // Forging process capabilities
    { label: "Forging Capabilities Overview", url: "/forging/" },
    { label: "Open Die Forging", url: "/open-die-forging/" },
    { label: "Closed Die Forging", url: "/closed-die-forging/" },
    { label: "Rolled Ring Forging", url: "/rolled-ring-forging/" },

    // Related titanium manufacturing routes
    { label: "Titanium Machining", url: "/titanium-machining/" },
    { label: "Aerospace Titanium Machining", url: "/titanium-aerospace-machining/" },
    { label: "Titanium Investment Casting", url: "/titanium-investment-casting/" }
];
// Page-level schema migrated from the current forcebeyond.com page.
// Global Place, Organization, and WebSite entities are defined in Layout.astro.
const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.forcebeyond.com/titanium-forging/#webpage",
      "url": "https://www.forcebeyond.com/titanium-forging/",
      "name": "Titanium Forging Services | Aerospace & High-Strength Alloys | ForceBeyond",
      "description": "Titanium forging services for aerospace and high-performance applications, including Ti-6Al-4V, beta and near-beta titanium alloys, near-net-shape forging, open-die forging, closed-die forging, rolled rings, heat treatment, NDT, and precision machining.",
      ...(dates?.published && {
        "datePublished": dates.published
      }),
      ...(dates?.modified && {
        "dateModified": dates.modified
      }),
      "isPartOf": {
        "@id": "https://www.forcebeyond.com/#website"
      },
      "mainEntity": {
        "@id": "https://www.forcebeyond.com/titanium-forging/#service"
      },
      "inLanguage": "en-US"
    },
    {
      "@type": "Service",
      "@id": "https://www.forcebeyond.com/titanium-forging/#service",
      "name": "Titanium Forging Services",
      "serviceType": "Titanium Forging and Forge-to-Finish Manufacturing",
      "description": "Engineering and manufacturing support for titanium forgings, including aerospace Ti-6Al-4V components, high-strength beta titanium forgings, near-net-shape titanium forgings, open-die forgings, closed-die forgings, and rolled rings.",
      "provider": {
        "@id": "https://www.forcebeyond.com/#organization"
      },
      "areaServed": [
        { "@type": "Country", "name": "United States" },
        { "@type": "Country", "name": "South Korea" },
        { "@type": "Country", "name": "Taiwan" }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Titanium Forging Capabilities",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "@id": "https://www.forcebeyond.com/titanium-aerospace-forging/#service",
              "name": "Titanium Aerospace Forging",
              "url": "https://www.forcebeyond.com/titanium-aerospace-forging/"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "@id": "https://www.forcebeyond.com/high-strength-beta-titanium-forging/#service",
              "name": "High-Strength Beta Titanium Forging",
              "url": "https://www.forcebeyond.com/high-strength-beta-titanium-forging/"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "@id": "https://www.forcebeyond.com/near-net-shape-titanium-forging/#service",
              "name": "Near-Net-Shape Titanium Forging",
              "url": "https://www.forcebeyond.com/near-net-shape-titanium-forging/"
            }
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.forcebeyond.com/titanium-forging/#faq",
      "url": "https://www.forcebeyond.com/titanium-forging/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does ForceBeyond manage quality across three countries?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ForceBeyond coordinates engineering, manufacturing, inspection, and quality oversight across its USA, South Korea, and Taiwan manufacturing network. Production requirements are controlled according to the applicable drawing, material specification, inspection plan, facility certification, and customer requirements."
          }
        },
        {
          "@type": "Question",
          "name": "Does ForceBeyond hold the AS9100 certification?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ForceBeyond is the management and engineering entity. Manufacturing certification applies at the facility level, so the AS9100 status of the manufacturing facility selected for a project should be confirmed against the applicable customer and program requirements."
          }
        }
      ]
    }
  ]
};
---

<IndividualPageLayout
    title={seoTitle}
    description={seoDescription}
    schema={pageSchema}
    pageTitle={pageTitle}
    publishedDate={dates?.published}

        modifiedDate={dates.modified}
publishedDate = {dates.published}
    heroImage="/media/aerospace-titanium-5-axis-machining-as9100-hero.webp"
    heroImageAlt="Precision 5-axis machining of an aerospace titanium component in an AS9100-certified manufacturing environment"
    faqSectionTitle="Frequently Asked Questions"
    faqItems={faqs}
    ctaTitle=""
    ctaDescription=""
    sourcesTitle="Sources"
    sourcesList={sources}
    resourcesTitle="Related Titanium Forging & Manufacturing Resources"
    resourcesList={internalResources}
>

    <div slot="full-width" class="individual-content">

        <section id="overview" >
            <div class="content-container">
                
                <h2>Titanium Forging Services: Global Scale, US Operational Oversight</h2>

                <div class="grid gap-10 lg:grid-cols-2 lg:items-center mt-6">
                    <div>
                        <p>
                            ForceBeyond is a Tier-1.5 manufacturing partner specializing in high-integrity <strong>Titanium Forging</strong> for 
                            aerospace, defense, and medical sectors. We <strong>co-own and operate</strong> an AS9100-certified manufacturing 
                            network across the USA, South Korea, and Taiwan, using appropriately qualified facilities for each program. By integrating direct operational control with
                            in-house 5-axis CNC machining, we deliver mission-critical Ti-6Al-4V and Beta-alloy components 
                            with project-specific metallurgical traceability.
                        </p>
                    </div>

                    <div class="relative">
                        <div class="overflow-hidden">
                            <img
                                src="/media/Titanium-Jet-Engine-Blade-Turbine-Aircraft.webp"
                                alt="Precision-machined titanium jet engine turbine blades for aerospace aircraft applications on a white background"
                                class="w-full h-auto object-cover hover:scale-105 transition-transform duration-500"
                            />
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <section id="co-owned-operation" >
            <div class="content-container">
                <h2>The ForceBeyond Advantage: Co-Owned Operational Control</h2>
                    <p>
                        Unlike brokers or traditional contract manufacturers, ForceBeyond is deeply embedded in the production cycle. 
                        Our leadership and engineering teams manage the operations of our co-owned facilities to coordinate process controls and support compliance with the requirements and certification scope applicable to each project.
                    </p>
                    <ul>
                        <li>
                            <strong>USA (Manufacturing & Engineering Operations):</strong>Co-owned domestic manufacturing, ITAR-compliant projects, and final quality verification.
                        </li>
                        <li>
                            <strong>South Korea (Co-Owned Facility):</strong> AS9100-certified high-tonnage forging and advanced VIM melting under ForceBeyond operational management.
                        </li>
                        <li>
                            <strong>Taiwan (Co-Owned Facility):</strong>Precision investment casting and advanced <a href="/titanium-machining" class = "highlight-link">Titanium Machining</a> centers managed by our integrated technical team.
                        </li>
                    </ul>
                
            </div>
        </section>

        <section id="special-capabilities" >
            <div class="content-container">
                <h2>Specialized Titanium Forging Capabilities</h2>
                
                <p>
                    Our facilities utilize advanced thermal-mechanical processing (TMP) to 
                    reach ultra-high tensile strengths (above 1,200 MPa) and optimized fatigue resistance.
                </p>

                <ul>
                    <li>
                        <a href="/titanium-aerospace-forging/" class="highlight-link">
                            Titanium Aerospace Forging
                        </a>:
                        Ti-6Al-4V forgings, seamless rolled rings, and structural airframe components
                        produced to applicable aerospace material specifications such as AMS 4928.
                        Legacy military specifications may also be reviewed when specifically invoked
                        by the customer drawing or purchase order.
                    </li>
                    <li>
                        <a href="/high-strength-beta-titanium-forging/" class = "highlight-link">High-Strength Beta Titanium Forging</a>: Specializing in Ti-5553 and Ti-10-2-3 utilizing Isothermal Forging to eliminate “die chilling” and ensure microstructural homogeneity.
                    </li>
                    <li>
                        <a href="/near-net-shape-titanium-forging/" class = "highlight-link">Near-Net-Shape (NNS) Forging</a>: Precision blocker dies that reduce material waste by up to 45% and achieve “Buy-to-Fly” ratios as low as 3.5:1.
                    </li>
                </ul>
                <h3>Common Forged Components & Applications</h3>
                <ul>
                    <li>
                        <strong>Jet Engine Turbine Blades:</strong>Optimized grain flow for high-cycle fatigue resistance.
                    </li>
                    <li>
                        <strong>Landing Gear Actuators:</strong>High-strength Beta titanium for structural loads.
                    </li>
                    <li>
                        <strong>Structural Airframe Brackets:</strong>Near-Net-Shape (NNS) designs to reduce “Buy-to-Fly” ratios.
                    </li>
                    <li>
                        <strong>Compressor Disks:</strong>High-temperature stability using Ti-6242 alloys.
                    </li>
                    <li>
                        <strong>Exhaust Rings & Seamless Rolled Rings:</strong>Up to 84″ O.D. for propulsion systems, subject to alloy, cross-section, ring geometry,
                            equipment availability and DFM review
                    </li>
                </ul>
            </div>
        </section>


        <section id="alloy-parameters" >
            <div class="content-container">
                <h2>ForceBeyond Process Parameters for High-Performance Alloys</h2>
                
                <p>
                    Forging temperature is selected relative to each alloy's beta transus and
                    desired final microstructure. Process control includes billet temperature,
                    die temperature, transfer time, reduction, strain rate, and subsequent heat treatment.
                </p>
                <div class="content-table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Alloy Grade</th>
                                <th scope="col">Beta Transus (Typical)</th>
                                <th scope="col">Illustrative Processing Considerations</th>
                                <th scope="col">Microstructural Goal</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <th scope="row">Ti-6Al-4V</th>
                                <td>1820°F (995°C)</td>
                                <td>1650°F – 1750°F</td>
                                <th scope="row">Equiaxed Alpha + Transformed Beta</th>
                            </tr>
                            <tr>
                                <th scope="row">Ti-5553</th>
                                <td>1470°F (800°C)</td>
                                <td>1400°F – 1550°F</td>
                                <th scope="row">Controlled beta/alpha microstructure based on required strength,
                                ductility and fracture-toughness targets</th>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>


        <section id="optimized-but-to-fly-ratio" >
            <div class="content-container">
                <h2>Economic Impact: Optimizing the “Buy-to-Fly” Ratio</h2>
                
                <p>
                   In traditional titanium aerospace manufacturing, “Buy-to-Fly” ratios often exceed 10:1. ForceBeyond’s <a href="/near-net-shape-titanium-forging" class="highlight-link">Near-Net-Shape (NNS) Forging </a>
                   process, managed through our co-owned facilities, achieves a benchmark ratio of <strong>3.5:1 to 4.2:1</strong> for structural airframe components.
                </p>
            </div>
        </section>

        <section id="why-forcebeyond">
            <div class="content-container">
                <div class="content-table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Feature</th>
                                <th scope="col">Small Machine Shop</th>
                                <th scope="col">Large Broker/Distributor</th>
                                <th scope="col">ForceBeyond (Tier-1.5)</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <th scope="row">Ownership</th>
                                <td>Local</td>
                                <td>None (Middleman)</td>
                                <td>Co-Owned Factories</td>
                            </tr>
                            <tr>
                                <th scope="row">Process Control</th>
                                <td>Machining Only</td>
                                <td>Paperwork Only</td>
                                <td>Melt, Forge & Machine</td>
                            </tr>
                            <tr>
                                <th scope="row">Compliance</th>
                                <td>Varies</td>
                                <td>Third-Party Dependent</td>
                                <td>In-House AS9100 Oversight</td>
                            </tr>
                            <tr>
                                <th scope="row">Lead Times</th>
                                <td>Limited by backlogs</td>
                                <td>40–50 weeks</td>
                                <td><strong>14–18 weeks (Integrated)</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section id="request-quote">
            <div class="content-container">
                <h2>Request a Quote for Titanium Forging</h2>
                
                <p>
                    <strong>Partner with a Tier-1.5 Leader for Your Mission-Critical Components.</strong>                
                </p>
                <p>Ready to optimize your supply chain with our co-owned tri-regional manufacturing? 
                    Provide your project details below, and our engineering team will conduct a thorough 
                    <strong>Design for Manufacturing (DFM)</strong> review.</p>
                <p><strong>Please include the following for a precise quote:</strong></p>
                <ul>
                    <li>
                        <strong>Technical Drawings:</strong> (PDF, STEP, or IGES files)
                    </li>
                    <li>
                        <strong>Material Specification:</strong> (e.g., Ti-6Al-4V Grade 5, Ti-5553, etc.)
                    </li>
                    <li>
                        <strong>Certification Requirements: </strong>(AS9100, ITAR, or specific AMS standards)
                    </li>
                    <li>
                        <strong>Production Volume: </strong> (Prototype vs. Full Production Run)
                    </li>
                    <li>
                        <strong>Estimated Annual Usage (EAU):</strong> To help us optimize your “Buy-to-Fly” cost-savings.
                    </li>
                </ul>
            </div>
        </section>
    </div>
</IndividualPageLayout>
