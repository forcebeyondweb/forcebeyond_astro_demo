import { pageDates } from '../data/page-dates.js';
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';


const dates = pageDates['/cold-forging/'];

const pageTitle = 'Cold Forging: High-Volume Precision & Strain-Hardened Strength';
const seoTitle = 'Cold Forging Services | High-Volume Net-Shape Precision';
const seoDescription = 'Custom cold forging and heading services for high-volume automotive, electronic, and fastener components. ForceBeyond leverages strain hardening to increase yield strength, achieving true net-shape parts with brilliant surface finishes and zero material waste.';
const faqs = [
    {
        q: "Can any metal be cold forged?",
        a: "No. Because the metal is not heated, it must possess high natural ductility. Low-to-medium carbon steels, aluminum, copper, and brass are excellent candidates. High-carbon steels, titanium, and superalloys (like Inconel) are too hard and brittle at room temperature and must be hot forged."
    },
    {
        q: "Are there size limitations to cold forging?",
        a: "Yes. Because cold metal resists deformation, it requires massive press tonnage to move. Therefore, cold forging is typically restricted to smaller parts (usually under 25 lbs, and often much smaller, like fasteners and pins). For massive structural components, hot open die or closed die forging is required."
    },
    {
        q: "How does cold forging reduce material costs?",
        a: "If you CNC machine a bolt from a solid bar of steel, you turn a large percentage of that bar into scrap chips. Cold forging takes a wire or rod of the exact volume needed and simply reshapes it into the bolt. You pay only for the material in the final part, with virtually zero waste."
    }
];

// Sources
const sources = [
