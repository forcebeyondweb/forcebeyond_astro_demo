---
import { pageDates } from '../data/page-dates.js';
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';

const dates = pageDates['/contact-us/'];

// 1. Fetch Dynamic Cloud Configuration from Sanity
const data = await sanityClient.fetch(`*[_type == "contactPage"][0]`);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const countries = ['United States of America', 'Afghanistan', 'Albania', 'Algeria', 'Andorra', 'Angola', 'Antigua and Barbuda', 'Argentina', 'Armenia', 'Australia', 'Austria', 'Azerbaijan', 'Bahamas', 'Bahrain', 'Bangladesh', 'Barbados', 'Belarus', 'Belgium', 'Belize', 'Benin', 'Bhutan', 'Bolivia', 'Bosnia and Herzegovina', 'Botswana', 'Brazil', 'Brunei', 'Bulgaria', 'Burkina Faso', 'Burundi', 'Cabo Verde', 'Cambodia', 'Cameroon', 'Canada', 'Central African Republic', 'Chad', 'Chile', 'China', 'Colombia', 'Comoros', 'Congo (Congo-Brazzaville)', 'Costa Rica', 'Croatia', 'Cuba', 'Cyprus', 'Czechia', 'Democratic Republic of the Congo', 'Denmark', 'Djibouti', 'Dominica', 'Dominican Republic', 'Ecuador', 'Egypt', 'El Salvador', 'Equatorial Guinea', 'Eritrea', 'Estonia', 'Eswatini', 'Ethiopia', 'Fiji', 'Finland', 'France', 'Gabon', 'Gambia', 'Georgia', 'Germany', 'Ghana', 'Greece', 'Grenada', 'Guatemala', 'Guinea', 'Guinea-Bissau', 'Guyana', 'Haiti', 'Honduras', 'Hungary', 'Iceland', 'India', 'Indonesia', 'Iran', 'Iraq', 'Ireland', 'Israel', 'Italy', 'Jamaica', 'Japan', 'Jordan', 'Kazakhstan', 'Kenya', 'Kiribati', 'Kuwait', 'Kyrgyzstan', 'Laos', 'Latvia', 'Lebanon', 'Lesotho', 'Liberia', 'Libya', 'Liechtenstein', 'Lithuania', 'Luxembourg', 'Madagascar', 'Malawi', 'Malaysia', 'Maldives', 'Mali', 'Malta', 'Marshall Islands', 'Mauritania', 'Mauritius', 'Mexico', 'Micronesia', 'Moldova', 'Monaco', 'Mongolia', 'Montenegro', 'Morocco', 'Mozambique', 'Myanmar', 'Namibia', 'Nauru', 'Nepal', 'Netherlands', 'New Zealand', 'Nicaragua', 'Niger', 'Nigeria', 'North Korea', 'North Macedonia', 'Norway', 'Oman', 'Pakistan', 'Palau', 'Panama', 'Papua New Guinea', 'Paraguay', 'Peru', 'Philippines', 'Poland', 'Portugal', 'Qatar', 'Romania', 'Russia', 'Rwanda', 'Saint Kitts and Nevis', 'Saint Lucia', 'Saint Vincent and the Grenadines', 'Samoa', 'San Marino', 'Sao Tome and Principe', 'Saudi Arabia', 'Senegal', 'Serbia', 'Seychelles', 'Sierra Leone', 'Singapore', 'Slovakia', 'Slovenia', 'Solomon Islands', 'Somalia', 'South Africa', 'South Korea', 'South Sudan', 'Spain', 'Sri Lanka', 'Sudan', 'Suriname', 'Sweden', 'Switzerland', 'Syria', 'Taiwan', 'Tajikistan', 'Tanzania', 'Thailand', 'Timor-Leste', 'Togo', 'Tonga', 'Trinidad and Tobago', 'Tunisia', 'Turkey', 'Turkmenistan', 'Tuvalu', 'Uganda', 'Ukraine', 'United Arab Emirates', 'United Kingdom', 'Uruguay', 'Uzbekistan', 'Vanuatu', 'Vatican City', 'Venezuela', 'Vietnam', 'Yemen', 'Zambia', 'Zimbabwe'];

const sources = ['Cold Call', 'Direct Mail', 'Email', 'Industry Event', 'Referral', 'Search Engine', 'Web Research', 'AI Search (ChatGPT/Gemini/Claude)'];

// Unified form input style – solid white, slightly translucent background; blue highlight on focus
const input = 'mt-2 w-full border border-slate-200 transition-all duration-300 bg-white px-5 py-3.5 text-slate-900 text-sm font-medium outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-100 placeholder:text-slate-400';

const contactSchema = {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    '@id': 'https://fbwebdemo.netlify.app/contact-us/#contact',
    name: data?.title || 'Contact ForceBeyond',
    url: 'https://fbwebdemo.netlify.app/contact-us/',
    mainEntity: {
        '@type': 'IndustrialBusiness',
        name: data?.companyName || 'ForceBeyond',
        telephone: data?.phone || '+1-302-995-6588',
        email: data?.email || 'contact@forcebeyond.com',
        address: { 
            '@type': 'PostalAddress', 
            streetAddress: data?.streetAddress || '261 Quigley Blvd, Suite 18', 
            addressLocality: data?.locality || 'New Castle', 
            addressRegion: data?.region || 'DE', 
            postalCode: data?.postalCode || '19720', 
            addressCountry: 'US' 
        },
        geo: { '@type': 'GeoCoordinates', latitude: 39.6621, longitude: -75.5663 }
    }
};
---

<Layout title="Contact Corporate Access | ForceBeyond" description={data?.seoDescription || "Submit your metal manufacturing requirements to ForceBeyond."}>
    <Fragment slot="head">
        <meta property="article:modified_time" content={dates.modified} />
    </Fragment>
    <script slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(contactSchema)}></script>
    
<!-- ========================================= -->
<!-- SECTION 1: CONTACT HERO IMAGE -->
<!-- ========================================= -->
<section class="relative z-20 w-full h-[420px] lg:h-[500px] flex items-center justify-center bg-slate-950 overflow-hidden border-b border-white/5">
    <img 
        src="/media/die-casting-investment-casting-forging-cnc-high-precision-machining-title-bar-2.jpg" 
        alt="Contact ForceBeyond"
        class="absolute inset-0 z-0 h-full w-full object-cover object-center"
    />
    
    <div class="relative z-10 mx-auto max-w-7xl px-6 sm:px-12 text-center">
        <h1 class="mt-3 text-4xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl  leading-none">
            Contact Us
        </h1>
    </div>
</section>

<!-- ========================================= -->
<!-- SECTION 2: MAP SECTION -->
<!-- ========================================= -->
<section class="relative z-10 w-full bg-white border-b border-slate-200 py-12">
    <div class="mx-auto max-w-7xl px-6 sm:px-12">
        
        <div class="mb-8 text-center">
            <h2 class="text-2xl sm:text-3xl font-black mt-2 text-slate-950 tracking-tight">Find Us On The Map</h2>
        </div>

        <div class="w-full rounded-xl overflow-hidden border border-slate-200 shadow-xl shadow-slate-900/10 bg-white h-[320px] sm:h-[420px] lg:h-[480px] relative">
            <iframe 
                src="https://maps.google.com/maps?q=39.6621,-75.5663&z=8&hl=en&output=embed"
                class="absolute inset-0 w-full h-full" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade"
                title="ForceBeyond LLC Global Headquarters Location"
            ></iframe>
        </div>

    </div>
</section>

    <!-- ========================================= -->
    <!-- SECTION 3: CORE B2B INQUIRY FORM -->
    <!-- ========================================= -->
    <section class="bg-slate-50 py-16 text-slate-900 sm:py-24 relative z-10">
    <div class="mx-auto max-w-7xl px-6 sm:px-12">
        
        <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.65fr] gap-10 lg:gap-12 items-start">
            
            <!-- left Contact Info -->
            <aside class="bg-white rounded-2xl border border-slate-200/80 p-8 shadow-xl shadow-slate-900/5 text-slate-900 lg:sticky lg:top-28">
                <h3 class="text-2xl font-black mt-2 text-slate-950 tracking-tight">Forcebeyond</h3>
                
                <address class="mt-6 text-sm text-slate-600 not-italic leading-relaxed  pl-4">
                    {data?.streetAddress || "261 Quigley Blvd, Suite 18"}<br />
                    {data?.locality || "New Castle"}, {data?.region || "Delaware"} {data?.postalCode || "19720"}, USA
                </address>

                <div class="mt-8 space-y-6 text-sm">
                    <div>
                        <p class="text-[10px] font-black tracking-[0.2em] text-slate-950 uppercase">Phone</p>
                        <a href={`tel:${data?.phone || "+13029956588"}`} class="mt-2 inline-block text-slate-700 hover:text-blue-600 transition">
                            {data?.phone || "(302) 995 6588"}
                        </a>
                    </div>

                    <div>
                        <p class="text-[10px] font-black tracking-[0.2em] text-slate-950 uppercase">Email</p>
                        <p>contact at forcebeyond dot com
                    </div>
                </div>
            </aside>

            <!-- Right-side form body container -->
            <div class="bg-white rounded-2xl border border-slate-200/80 p-8 shadow-xl shadow-slate-900/5 lg:p-14">

                <div id="thankYouState" class="hidden mx-auto max-w-2xl text-center">
                    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-green-100 text-green-600">
                        <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                    </div>

                    <h2 class="mt-6 text-3xl font-bold tracking-tight text-slate-900">Thank You!</h2>

                    <p class="mt-4 text-lg text-slate-600">
                        Thank you so much for contacting us!
                        Your message has been safely received.
                        Our team will review your inquiry and get back to you soon.
                    </p>

                    <div class="mt-8">
                        <button 
                            type="button"
                            onclick="window.location.reload()" 
                            class="inline-flex items-center justify-center bg-slate-900 px-6 py-3 text-sm font-bold text-white transition hover:bg-slate-800"
                        >
                            Submit Another Message
                        </button>
                    </div>
                </div>
                            
                <form id="contactForm" action="/contact-form-submit.php" method="POST" class="w-full" novalidate>
                    <h2 class="text-2xl font-black tracking-tight text-slate-950 ">{data?.formTitle || "B2B Technical Communications"}</h2>
                    <p class="mt-3 leading-relaxed text-slate-600 text-sm">{data?.formDescription || "A dedicated ForceBeyond engineer will evaluate your submission and respond within one business day."}</p>
                        <p class="text-xs font-black tracking-wider text-slate-500 ">
                            <span class="mr-2 text-blue-600">*</span>Required fields
                        </p>
                    <div class="mt-12 grid gap-x-6 gap-y-8 sm:grid-cols-2">
                        <fieldset class="contents">
                            <legend class="sm:col-span-2 text-sm font-black text-slate-900  tracking-wider">Contact Information<span class="text-blue-600">(Required)</span></legend>
                            <label class="block text-xs font-bold text-slate-500  tracking-wider">Your First Name<span class="mr-2 text-blue-600">*</span><input class={input} required name="first-name" autocomplete="given-name" type="text" /></label>
                            <label class="block text-xs font-bold text-slate-500  tracking-wider">Your Last Name<span class="mr-2 text-blue-600">*</span><input class={input} required name="last-name" autocomplete="family-name" type="text" /></label>
                        </fieldset>

                        <label class="block text-xs font-bold text-slate-500  tracking-wider">Your Job Title <span class="mr-2 text-blue-600">*</span></span><input class={input} required name="job-title" autocomplete="organization-title" type="text" /></label>
                        <label class="block text-xs font-bold text-slate-500  tracking-wider">Your Company Name <span class="mr-2 text-blue-600">*</span></span><input class={input} required name="company-name" autocomplete="organization" type="text" /></label>

                        <fieldset class="contents">
                            <legend class="sm:col-span-2 mt-4 text-sm font-black text-slate-900  tracking-wider">Your Location <span class="mr-2 text-blue-600">(Required)</span></legend>
                            <label class="block text-xs font-bold text-slate-500  tracking-wider sm:col-span-2">Address Line 1<span class="mr-2 text-blue-600">*</span><input class={input} required name="address-line-1" autocomplete="address-line1" type="text" /></label>
                            <label class="block text-xs font-bold text-slate-500  tracking-wider sm:col-span-2">Address Line 2 (Optional)<input class={input} name="address-line-2" autocomplete="address-line2" type="text" /></label>
                            <label class="block text-xs font-bold text-slate-500  tracking-wider">City<span class="mr-2 text-blue-600">*</span><input class={input} required name="city" autocomplete="address-level2" type="text" /></label>
                            <label class="block text-xs font-bold text-slate-500  tracking-wider">State / Province<span class="mr-2 text-blue-600">*</span><input class={input} required name="state-region" autocomplete="address-level1" type="text" /></label>
                            <label class="block text-xs font-bold text-slate-500  tracking-wider">Postal Code<span class="mr-2 text-blue-600">*</span><input class={input} required name="postal-code" autocomplete="postal-code" type="text" /></label>
                            <label class="block text-xs font-bold text-slate-500  tracking-wider">
                                Country<span class="mr-2 text-blue-600">*</span>
                                <select class={input} required name="country" autocomplete="country-name">
                                    <option value="">Select a country</option>
                                    {countries.map((country) => (
                                        <option
                                            value={country}
                                            selected={country === "United States of America"}
                                        >
                                            {country}
                                        </option>
                                    ))}
                                </select>
                            </label>
                        </fieldset>

                        <label class="block text-xs font-bold text-slate-500  tracking-wider">Your Corporate Email <span class="mr-2 text-blue-600">*</span><input id="contact-email" class={input} required name="email" autocomplete="email" type="email" /></label>
                        <label class="block text-xs font-bold text-slate-500  tracking-wider">Confirm Corporate Email<span class="mr-2 text-blue-600">*</span><input id="contact-confirm-email" class={input} required name="confirm-email" autocomplete="email" type="email" /></label>
                        <label class="block text-xs font-bold text-slate-500  tracking-wider sm:col-span-2">Your Business Phone <span class="mr-2 text-blue-600">*</span><input class={input} required name="phone" autocomplete="tel" type="tel" /></label>

                        <fieldset class="sm:col-span-2 border-y border-slate-200 py-8 my-2">
                            <legend class="text-sm font-black text-slate-900  tracking-wider">How Did You Hear About Us? <span class="mr-2 text-blue-600">(Required)</span></legend>
                            <div class="mt-6 grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
                                {sources.map((source) => (
                                    <label class="flex cursor-pointer items-center gap-3 rounded border border-slate-200 bg-slate-50/50 px-4 py-3 text-xs font-bold text-slate-700 transition hover:border-blue-500 hover:bg-slate-50">
                                        <input required type="radio" name="marketing-source" value={source} class="h-4 w-4 accent-blue-600" />{source}
                                    </label>
                                ))}
                            </div>
                        </fieldset>

                        <label class="block text-sm font-black text-slate-900  tracking-wider sm:col-span-2">Subject<span class="mr-2 text-blue-600">(Required)</span><input class={input} required name="subject" type="text" /></label>
                        <label class="block text-sm font-black text-slate-900  tracking-wider sm:col-span-2">
                            Your Message<span class="mr-2 text-blue-600">(Required)</span>
                            <textarea 
                                class={input + ' min-h-48 resize-y'} 
                                required 
                                name="message" 
                                placeholder="Please provide casting/forging grades, annual volume estimates, secondary processing, or critical tolerances..."
                            ></textarea>
                        </label>
                    </div>

                    <!-- Honeypot: human visitors will never see or complete this field -->
                    <div class="absolute -left-[10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
                        <label>
                            Leave this field empty
                            <input type="text" name="website-url" tabindex="-1" autocomplete="off" />
                        </label>
                    </div>

                    <div class="mt-8">
                        {turnstileSiteKey ? (
                            <div
                                class="cf-turnstile"
                                data-sitekey={turnstileSiteKey}
                                data-theme="light"
                                data-size="flexible"
                                data-action="contact-form"
                                data-language="en"
                            ></div>
                        ) : (
                            <p class="text-sm font-bold text-red-600">Security verification is not configured.</p>
                        )}
                        <p class="mt-2 text-xs text-slate-500">Security verification helps prevent automated spam.</p>
                    </div>

                    <div id="formErrorMessage" class="mt-8 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-bold text-red-700" role="alert" aria-live="polite"></div>

                    <!-- Standardized, full, round blue submit button for the homepage -->
                    <div class="mt-6 text-center sm:text-left">
                        <button type="submit" id="submitBtn" class="inline-flex items-center justify-center rounded-full bg-blue-600 px-12 py-4.5 font-black tracking-widest text-white  text-xs transition hover:bg-blue-700 hover:scale-[1.02] active:scale-[0.98] shadow-lg shadow-blue-600/10 cursor-pointer">
                            Submit
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
        <!-- Mobile-safe contact form validation and submission -->
        <script is:inline>
            const contactForm = document.getElementById('contactForm');
            const contactSubmitBtn = document.getElementById('submitBtn');
            const contactThankYouState = document.getElementById('thankYouState');
            const formErrorMessage = document.getElementById('formErrorMessage');
            const emailInput = document.getElementById('contact-email');
            const confirmEmailInput = document.getElementById('contact-confirm-email');

            const requiredFields = [
                { name: 'first-name', label: 'First Name' },
                { name: 'last-name', label: 'Last Name' },
                { name: 'job-title', label: 'Job Title' },
                { name: 'company-name', label: 'Company Name' },
                { name: 'address-line-1', label: 'Address Line 1' },
                { name: 'city', label: 'City' },
                { name: 'state-region', label: 'State / Province' },
                { name: 'postal-code', label: 'Postal Code' },
                { name: 'country', label: 'Country' },
                { name: 'email', label: 'Corporate Email' },
                { name: 'confirm-email', label: 'Confirm Corporate Email' },
                { name: 'phone', label: 'Business Phone' },
                { name: 'marketing-source', label: 'How Did You Hear About Us' },
                { name: 'subject', label: 'Subject' },
                { name: 'message', label: 'Message' }
            ];

            const INVALID_CLASSES = ['ring-2', 'ring-red-500', 'ring-offset-4'];
            const SCROLL_OFFSET = 120;

            function validateEmail() {
                if (
                    confirmEmailInput.value &&
                    emailInput.value !== confirmEmailInput.value
                ) {
                    confirmEmailInput.setCustomValidity('Email addresses must match.');
                } else {
                    confirmEmailInput.setCustomValidity('');
                }
            }

            function getMissingFields() {
                return requiredFields.filter(({ name }) => {
                    const fields = contactForm.querySelectorAll(`[name="${name}"]`);

                    if (!fields.length) {
                        return true;
                    }

                    if (fields[0].type === 'radio') {
                        return !Array.from(fields).some((field) => field.checked);
                    }

                    return !fields[0].value.trim();
                });
            }

            function showFormError(message) {
                formErrorMessage.textContent = message;
                formErrorMessage.classList.remove('hidden');
            }

            function clearFormError() {
                formErrorMessage.textContent = '';
                formErrorMessage.classList.add('hidden');
            }

            function clearInvalidHighlights() {
                contactForm
                    .querySelectorAll('.ring-red-500')
                    .forEach((element) => element.classList.remove(...INVALID_CLASSES));
            }

            function getValidationTarget(field) {
                if (!field) {
                    return null;
                }

                if (field.type === 'radio' || field.type === 'checkbox') {
                    return field.closest('fieldset') || field.closest('label') || field;
                }

                return field.closest('label') || field;
            }

            function scrollToValidationTarget(field) {
                const target = getValidationTarget(field);

                if (!target) {
                    return;
                }

                clearInvalidHighlights();
                target.classList.add(...INVALID_CLASSES);

                const top =
                    target.getBoundingClientRect().top +
                    window.scrollY -
                    SCROLL_OFFSET;

                window.scrollTo({
                    top: Math.max(0, top),
                    behavior: 'smooth'
                });

                window.setTimeout(() => {
                    try {
                        field.focus({ preventScroll: true });
                    } catch {
                        field.focus();
                    }
                }, 450);
            }

            function scrollToTurnstile() {
                const turnstile = contactForm.querySelector('.cf-turnstile');
                const target = turnstile?.parentElement || turnstile || formErrorMessage;

                clearInvalidHighlights();
                target.classList.add(...INVALID_CLASSES);

                const top =
                    target.getBoundingClientRect().top +
                    window.scrollY -
                    SCROLL_OFFSET;

                window.scrollTo({
                    top: Math.max(0, top),
                    behavior: 'smooth'
                });
            }

            function clearFieldHighlight(event) {
                const target = getValidationTarget(event.target);
                target?.classList.remove(...INVALID_CLASSES);
            }

            if (
                contactForm &&
                contactSubmitBtn &&
                contactThankYouState &&
                formErrorMessage &&
                emailInput &&
                confirmEmailInput
            ) {
                emailInput.addEventListener('input', () => {
                    validateEmail();
                    clearFieldHighlight({ target: emailInput });
                });

                confirmEmailInput.addEventListener('input', () => {
                    validateEmail();
                    clearFieldHighlight({ target: confirmEmailInput });
                });

                contactForm.addEventListener('input', clearFieldHighlight);
                contactForm.addEventListener('change', clearFieldHighlight);

                contactForm.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    clearFormError();
                    clearInvalidHighlights();
                    validateEmail();

                    const missingFields = getMissingFields();

                    if (missingFields.length > 0 || !contactForm.checkValidity()) {
                        const missingLabels = missingFields
                            .map(({ label }) => label)
                            .join(', ');

                        showFormError(
                            missingLabels
                                ? `Please complete: ${missingLabels}.`
                                : 'Please correct the highlighted field.'
                        );

                        const firstMissingName = missingFields[0]?.name;
                        const firstInvalidField = firstMissingName
                            ? contactForm.querySelector(`[name="${firstMissingName}"]`)
                            : contactForm.querySelector(':invalid');

                        scrollToValidationTarget(firstInvalidField);
                        return;
                    }

                    const turnstileToken =
                        contactForm.querySelector(
                            'input[name="cf-turnstile-response"]'
                        )?.value;

                    if (!turnstileToken) {
                        showFormError('Please complete the security verification.');
                        scrollToTurnstile();
                        return;
                    }

                    contactSubmitBtn.textContent = 'Submitting...';
                    contactSubmitBtn.disabled = true;

                    const formData = new FormData(contactForm);

                    try {
                        const response = await fetch(contactForm.action, {
                            method: 'POST',
                            body: formData
                        });

                        let result;
                        const contentType = response.headers.get('content-type');

                        if (contentType && contentType.includes('application/json')) {
                            result = await response.json();
                        } else {
                            const textResponse = await response.text();
                            result = {
                                success: false,
                                error:
                                    textResponse ||
                                    'The server returned an invalid response.'
                            };
                        }

                        if (response.ok && result.success === true) {
                            contactForm.reset();
                            clearInvalidHighlights();
                            contactForm.classList.add('hidden');
                            contactThankYouState.classList.remove('hidden');

                            const top =
                                contactThankYouState.getBoundingClientRect().top +
                                window.scrollY -
                                SCROLL_OFFSET;

                            window.scrollTo({
                                top: Math.max(0, top),
                                behavior: 'smooth'
                            });
                        } else {
                            window.turnstile?.reset();
                            showFormError(
                                result.error ||
                                    `Submission failed with HTTP status ${response.status}. Please try again.`
                            );

                            const top =
                                formErrorMessage.getBoundingClientRect().top +
                                window.scrollY -
                                SCROLL_OFFSET;

                            window.scrollTo({
                                top: Math.max(0, top),
                                behavior: 'smooth'
                            });
                        }
                    } catch (error) {
                        window.turnstile?.reset();
                        showFormError(
                            'A transmission error occurred. Please try again.'
                        );

                        const top =
                            formErrorMessage.getBoundingClientRect().top +
                            window.scrollY -
                            SCROLL_OFFSET;

                        window.scrollTo({
                            top: Math.max(0, top),
                            behavior: 'smooth'
                        });
                    } finally {
                        contactSubmitBtn.textContent = 'Submit';
                        contactSubmitBtn.disabled = false;
                    }
                });
            }
        </script>
    </section>
</Layout>