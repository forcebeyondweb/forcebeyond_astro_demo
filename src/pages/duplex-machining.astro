---
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';

const pageTitle = 'Duplex & Super Duplex Stainless Steel CNC Machining Services';
const seoTitle = 'Duplex Stainless Steel Machining | 2205 & 2507 CNC Parts';
const seoDescription = 'ForceBeyond provides duplex and super duplex stainless steel CNC machining for 2205, 2507, Zeron 100, and cast duplex components, including 5-axis milling, turning, heat treatment coordination, passivation, inspection, and production support.';

const canonicalUrl = 'https://www.forcebeyond.store/duplex-machining/';
const socialImage = 'https://www.forcebeyond.store/media/duplex-super-duplex-cnc-machining-overview-4k.webp';

const faqs = [
    {
        q: "Why is duplex stainless steel harder to machine than 316L?",
        a: "Duplex stainless steels generally have higher strength, higher cutting forces, lower thermal conductivity, and strong work-hardening behavior compared with 316L. These characteristics increase heat at the cutting edge and can shorten tool life if rigidity, feed, depth of cut, chip control, and coolant delivery are not properly managed."
    },
    {
        q: "How are machined duplex stainless steel parts inspected?",
        a: "Inspection may include CMM measurement, gauges, surface-finish checks, positive material identification, hardness or ferrite measurement, penetrant inspection, pressure testing, corrosion testing, and material documentation. The required inspection plan depends on the drawing, purchase order, service environment, governing material standard, and customer quality requirements."
    },
    {
        q: "Can machining affect duplex stainless steel corrosion resistance?",
        a: "Machining can affect surface condition through heat, smeared material, embedded contamination, or poor cleaning. Appropriate cutting parameters, coolant control, cleaning, and passivation can help maintain the intended surface condition. Bulk phase balance is primarily controlled by alloy chemistry and thermal history rather than normal finish machining alone."
    },
    {
        q: "What information is needed for a duplex machining quote?",
        a: "Provide a 2D drawing and, when available, a 3D CAD model, along with alloy grade and product form, quantity, critical tolerances, GD&T, surface finish, heat-treatment condition, corrosion environment, NACE or ISO requirements, passivation, inspection, testing, documentation, and delivery expectations."
    }
];

const sources = [
    { label: 'Sandvik Coromant - Stainless Steel Machining Knowledge', url: 'https://www.sandvik.coromant.com/en-us/knowledge/materials/workpiece-materials/iso-m-stainless-steel' },
    { label: 'International Molybdenum Association - Duplex Stainless Steel Resources', url: 'https://www.imoa.info/' },
    { label: 'Nickel Institute - Duplex Stainless Steel Resources', url: 'https://nickelinstitute.org/' },
    { label: 'ASTM International - Duplex Stainless Steel Standards', url: 'https://www.astm.org/' },
    { label: 'AMPP - Corrosion and NACE Standards Resources', url: 'https://www.ampp.org/' },
    { label: 'ASM International - Stainless Steel and Machining Information', url: 'https://www.asminternational.org/' }
];

const internalResources = [
    // Machining
    { label: "Precision Machining", url: "/precision-machining" },
    { label: "High-Precision Component Machining", url: "/high-precision-machining" },
    { label: "Multi-Axis CNC Milling & Turning", url: "/multi-axis-cnc" },
    { label: "Stainless Steel Machining", url: "/stainless-steel-machining" },
    { label: "Superalloy Machining Services", url: "/high-performance-superalloy-machining" },

    // Duplex and Stainless Casting
    { label: "Duplex & Super Duplex Stainless Steel Casting", url: "/duplex-stainless-steel-casting" },
    { label: "Stainless Steel Casting", url: "/stainless-steel-casting" },
    { label: "Investment Casting", url: "/investment-casting" },
    { label: "Casting Capabilities", url: "/casting" },

    // Secondary Operations and Quality
    { label: "Secondary Operations", url: "/secondary-operations" },
    { label: "Heat Treatment", url: "/heat-treatment" },
    { label: "Surface Finishing & Coating", url: "/surface-finishing" },
    { label: "Testing & Inspection Capabilities", url: "/testing-inspection-capabilities" },
    { label: "Assembly & Kitting", url: "/assembly-and-kitting" },
    { label: "Quality Assurance & Certifications", url: "/quality-assurance-certifications" },

    // Materials and Technical
    { label: "Stainless Steel & Carbon Steel Materials", url: "/stainless-carbon-steel" },
    { label: "Materials & Technical Specifications", url: "/materials-technical-specs" },
    { label: "Manufacturing Design Guides", url: "/manufacturing-design-guides" },

    // Industries
    { label: "Oil & Gas", url: "/oil-gas" },
    { label: "HVAC, Fluid & Flow Control", url: "/hvac-flow" },
    { label: "Energy & Power Generation", url: "/energy-power-generation" },
    { label: "Mining & Heavy Equipment", url: "/mining" }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": seoTitle,
      "description": seoDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://www.forcebeyond.store/#website",
        "name": "ForceBeyond",
        "url": "https://www.forcebeyond.store/"
      },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": socialImage
      },
      "breadcrumb": {
        "@id": `${canonicalUrl}#breadcrumb`
      },
      "about": [
        { "@type": "Thing", "name": "Duplex stainless steel machining" },
        { "@type": "Thing", "name": "Super duplex stainless steel machining" },
        { "@type": "Thing", "name": "2205 duplex stainless steel" },
        { "@type": "Thing", "name": "2507 super duplex stainless steel" },
        { "@type": "Thing", "name": "5-axis CNC machining" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.forcebeyond.store/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Precision Machining",
          "item": "https://www.forcebeyond.store/precision-machining/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Duplex Stainless Steel Machining",
          "item": canonicalUrl
        }
      ]
    },
    {
      "@type": "Service",
      "@id": `${canonicalUrl}#service`,
      "name": "Duplex and Super Duplex Stainless Steel CNC Machining Services",
      "serviceType": "Precision CNC Milling, Turning and Finishing of Duplex Stainless Steel",
      "description": seoDescription,
      "url": canonicalUrl,
      "provider": {
        "@id": "https://www.forcebeyond.store/#organization"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United States"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Duplex Stainless Steel Machining Capabilities",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "2205 Duplex Stainless Steel Machining",
              "description": "CNC milling, turning, threading, boring, and finishing of wrought and cast 2205 duplex stainless steel components."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "2507 and Zeron 100 Super Duplex Machining",
              "description": "Rigid multi-axis machining for high-strength super duplex components used in chloride-bearing, marine, subsea, and chemical environments."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Cast-to-Machine Duplex Components",
              "description": "Coordinated near-net casting, solution treatment, CNC finish machining, passivation, inspection, and documentation."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Duplex Inspection and Documentation",
              "description": "Project-specific dimensional inspection, PMI, ferrite measurement, penetrant testing, corrosion testing, pressure testing, and quality records."
            }
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }
  ]
