        url: "https://saemobilus.sae.org/standards/ams5666k-nickel-alloy-corrosion-heat-resistant-bars-forgings-extrusions-rings-stock-forgings-extrusions-rings-62ni-215cr-90mo-365cb-nb-annealed"
    },
    {
        label: "ASTM International - ASTM B564 Standard Specification for Nickel Alloy Forgings",
        url: "https://store.astm.org/b0564-22.html"
    }
];

// Resources
