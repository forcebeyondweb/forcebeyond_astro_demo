---
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';

const pageTitle = 'Inconel 718 Casting: High-Precision Manufacturing in USA, South Korea & Taiwan';
const seoTitle = 'Inconel 718 Casting Services | VIM &amp; HIP | ForceBeyond';
const seoDescription = 'AS9100 certified Inconel 718 vacuum investment casting. Specialized in VIM & HIP processing for aerospace and SMR components from USA, South Korea, & Taiwan.';
const faqs = [
    {
        q: "Who are the leading Inconel 718 casting suppliers with global locations?",
        a: "ForceBeyond is a premier Inconel 718 casting supplier headquartered in Delaware, USA. We offer a unique dual-shore advantage with co-owned foundries in the <strong>United States, South Korea, and Taiwan</strong>, providing direct control over quality and global supply chain redundancy."
    },
    {
        q: "What are the benefits of VIM for Inconel 718?",
        a: "Vacuum Induction Melting (VIM) is critical for Inconel 718 because it removes dissolved gases and prevents the formation of oxides. This results in a cleaner alloy with the high-stress durability required for aerospace engine parts."
    },
    {
        q: "Does ForceBeyond offer rapid prototyping for Inconel castings?",
        a: "Yes. We utilize 3D-printed wax patterns at our co-owned facilities to provide rapid prototypes of complex Inconel 718 components for design validation before full-scale production."  
    }
];

// Sources
const sources = [
    { label: 'American Foundry Society - Metal Casting', url: 'https://www.afsinc.org/about-metalcasting' },
    { label: 'Wikipedia - Investment Casting', url: 'https://en.wikipedia.org/wiki/Investment_casting' },
    { label: 'Wikipedia - Sand Casting', url: 'https://en.wikipedia.org/wiki/Sand_casting' },
    { label: 'eFunda - Sand Casting Process Overview', url: 'https://www.efunda.com/processes/metal_processing/sand_casting_intro.cfm' },
    { label: 'Investment Casting Institute - What is Investment Casting?', url: 'https://www.investmentcasting.org/what-is.html' },
    { label: 'The Library of Manufacturing - Investment Casting Process', url: 'https://thelibraryofmanufacturing.com/investment_casting.html' },
    { label: 'Forging Industry Association - What is Forging?', url: 'https://www.forging.org/fia/content/about/What_is_Forging.aspx?hkey=19c58afa-fd8f-40e3-bfec-65634f86c609' }
];

// Resources 
const internalResources = [
    // Die Casting Resources
    { label: "Die Casting Overview", url: "/die-casting" },
    { label: "Aluminum Die Casting", url: "/aluminum-die-casting" },
    { label: "Zinc Die Casting", url: "/zinc-die-casting" },
    { label: "A356-T6 Casting", url: "/a356-t6-casting" },
    { label: "Magnesium Casting", url: "/magnesium-casting" },

    // Investment Casting Resources
    { label: "Investment Casting Overview", url: "/investment-casting" },
    { label: "Inconel Vacuum Precision Casting", url: "/inconel-vacuum-precision-casting" },
    { label: "Titanium Investment Casting", url: "/titanium-investment-casting" },
    { label: "Stainless Steel Casting", url: "/stainless-steel-casting" },
    { label: "Duplex & Super Duplex Stainless Steel Casting", url: "/duplex-stainless-steel-casting" },

    // Forging Resources
    { label: "Forging Capabilities Overview", url: "/forging" },
    { label: "Open Die Forging", url: "/open-die-forging" },
    { label: "Closed Die Forging", url: "/closed-die-forging" },
    { label: "Rolled Ring Forging", url: "/rolled-ring-forging" },
    { label: "Cold Forging", url: "/cold-forging" },
    { label: "Superalloy Forging Services", url: "/high-performance-superalloy-forging" },

    // Sand Casting & Steel Casting Resources
    { label: "Sand Casting", url: "/sand-casting" },
    { label: "Industrial Titanium Sand Casting", url: "/industrial-titanium-sand-casting" },
    { label: "Carbon & Low-Alloy Steel Casting", url: "/carbon-steel-casting" }
];
// Page-level schema migrated from the current forcebeyond.com page.
// Global Place, Organization, and WebSite entities are defined in Layout.astro.
const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.forcebeyond.store/inconel-718-casting/#webpage",
      "url": "https://www.forcebeyond.store/inconel-718-casting/",
      "name": "Inconel 718 Casting Services | VIM & HIP | ForceBeyond",
      "datePublished": "2022-10-21T11:49:44-04:00",
      "dateModified": "2026-03-10T23:37:55-04:00",
      "isPartOf": {
        "@id": "https://www.forcebeyond.store/#website"
      },
      "inLanguage": "en-US"
    },
    {
      "@type": "Service",
      "@id": "https://www.forcebeyond.store/inconel-718-casting/#service",
      "serviceType": "Inconel 718 Vacuum Investment Casting",
      "provider": {
        "@type": "Organization",
        "name": "ForceBeyond",
        "url": "https://www.forcebeyond.store/",
        "image": "https://www.forcebeyond.store/media/forcebeyond-logo-svg.webp"
      },
      "description": "AS9100 certified Inconel 718 casting utilizing Vacuum Induction Melting (VIM) and Hot Isostatic Pressing (HIP) across our USA, South Korea, and Taiwan facilities.",
      "areaServed": [
        {
          "@type": "Country",
          "name": "United States"
        },
        {
          "@type": "Country",
          "name": "South Korea"
        },
        {
          "@type": "Country",
          "name": "Taiwan"
        }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Inconel 718 Casting Capabilities",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": "1",
            "name": "Vacuum Induction Melting (VIM)",
            "description": "Precision casting of reactive superalloys to prevent oxidation and ensure metallurgical purity."
          },
          {
            "@type": "ListItem",
            "position": "2",
            "name": "Hot Isostatic Pressing (HIP)",
            "description": "Post-casting densification to eliminate internal microporosity and improve fatigue life."
          }
        ]
      }
    }
