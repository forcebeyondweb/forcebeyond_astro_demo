    { label: "Die Casting", url: "/die-casting" },
    { label: "Sand Casting", url: "/sand-casting" },
    { label: "Aluminum Die Casting", url: "/aluminum-die-casting" },
    { label: "A356-T6 Casting", url: "/a356-t6-casting" },

    // Forging
    { label: "Forging Capabilities", url: "/forging" },
    { label: "Open Die Forging", url: "/open-die-forging" },
    { label: "Closed Die Forging", url: "/closed-die-forging" },
    { label: "Rolled Ring Forging", url: "/rolled-ring-forging" },
    { label: "Cold Forging", url: "/cold-forging" },

