---
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';

const pageTitle = 'Design for Manufacturability Guidelines for Casting, Forging & CNC';
const seoTitle = 'Design for Manufacturability Guides | Casting, Forging & CNC';
const seoDescription = 'Explore practical DFM guidelines for investment casting, sand casting, die casting, forging, and CNC machining, including wall thickness, draft, radii, tolerances, machining allowance, datum strategy, inspection, and RFQ preparation.';

const canonicalUrl = 'https://www.forcebeyond.com/manufacturing-design-guides/';
const socialImage = 'https://www.forcebeyond.com/media/precision-cnc-machining-metal-manufacturing-workshop-hero.webp';

const faqs = [
    {
        q: "Why should DFM review happen before tooling is released?",
        a: "Early DFM review can identify geometry, tolerance, material, tooling, process, inspection, and assembly risks before changes become expensive. It may reduce revisions, rework, trial iterations, and lead-time risk, but it cannot guarantee defect-free production or a fixed cost reduction."
    },
    {
        q: "Which files and requirements are needed for a DFM review?",
        a: "Provide a 3D CAD model, 2D drawing, material and condition, expected quantity, critical tolerances, GD&T, surface finish, heat treatment, coating, inspection, testing, assembly, packaging, and delivery requirements. Identifying critical-to-function features is especially important."
    },
    {
        q: "Are the dimensions and draft angles in these guides mandatory?",
        a: "No. The values on this page are starting points for discussion. Final wall thickness, draft, radii, machining allowance, tolerance, and tooling requirements depend on alloy, component size, geometry, process route, equipment, volume, quality requirements, and supplier-specific capability."
    },
    {
        q: "What engineering tools may be used during DFM review?",
        a: "Depending on project scope, DFM review may use CAD section analysis, tolerance-stack review, casting fill and solidification simulation, forging process modeling, CNC toolpath and collision simulation, fixture review, inspection planning, and prototype or first-article validation."
    }
];

const sources = [
    { label: 'Investment Casting Institute - Investment Casting Design Resources', url: 'https://www.investmentcasting.org/what-is.html' },
    { label: 'American Foundry Society - Metalcasting Design Resources', url: 'https://www.afsinc.org/' },
    { label: 'Forging Industry Association - Forging Design Resources', url: 'https://www.forging.org/' },
    { label: 'North American Die Casting Association - Product Design Resources', url: 'https://www.diecasting.org/' },
    { label: 'ASME - Geometric Dimensioning and Tolerancing Standards', url: 'https://www.asme.org/codes-standards' },
    { label: 'NIST - Manufacturing and Dimensional Metrology', url: 'https://www.nist.gov/topics/manufacturing' }
];

