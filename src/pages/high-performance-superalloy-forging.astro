    },
    {
        label: "ASTM International - ASTM B637 Nickel Alloy Bars, Forgings and Forging Stock",
        url: "https://store.astm.org/standards/b637"
    },
    {
        label: "ASTM International - ASTM B564 Nickel Alloy Forgings",
        url: "https://store.astm.org/b0564-25.html"
    },
    {
        label: "Forging Industry Association - What Is Forging?",
        url: "https://www.forging.org/fia/content/about/What_is_Forging.aspx"
    }
];

// Resources 
const internalResources = [
    // Primary alloy spokes
    {
        label: "Inconel 718 Forging",
        url: "/inconel-718-forging/"
    },
    {
        label: "Inconel 625 Forging",
        url: "/inconel-625-forging/"
    },
    {
        label: "Inconel 718 vs. 625 Forging Technical Guide",
        url: "/inconel-718-vs-625-forging-guide/"
    },

    // Forging process pages
    {
        label: "Forging Capabilities Overview",
        url: "/forging/"
    },
    {
        label: "Open Die Forging",
        url: "/open-die-forging/"
    },
    {
        label: "Closed Die Forging",
        url: "/closed-die-forging/"
    },
    {
        label: "Rolled Ring Forging",
        url: "/rolled-ring-forging/"
    },

    // Related superalloy manufacturing routes
    {
        label: "Superalloy Machining",
        url: "/high-performance-superalloy-machining/"
    },
    {
        label: "Inconel 718 Machining",
        url: "/inconel-718-machining/"
    },
    {
        label: "Inconel 625 Machining",
        url: "/inconel-625-machining/"
    },
    {
        label: "Superalloy Casting",
        url: "/high-performance-superalloy-casting/"
    },
    {
        label: "Inconel 718 Casting",
        url: "/inconel-718-casting/"
