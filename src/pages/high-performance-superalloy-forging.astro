---
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';

const pageTitle = 'Superalloy Forging Services: USA, South Korea & Taiwan Manufacturing Network';
const seoTitle = 'Superalloy Forging Services | Inconel 718 & 625 | ForceBeyond';
const seoDescription = 'Superalloy forging for Inconel 718, Inconel 625, Waspaloy, and other nickel alloys, with AS9100-based quality oversight across ForceBeyond’s USA, South Korea, and Taiwan manufacturing network.';
const faqs = [
    {
        q: " Why choose ForceBeyond as your Inconel 718 forging supplier?",
        a: "ForceBeyond combines US-based engineering, DFM, and quality oversight with manufacturing capacity across its USA, South Korea, and Taiwan network. Manufacturing route, material condition, inspection requirements, and final acceptance are controlled according to the applicable drawing, material specification, and customer requirements."
    },
    {
        q: "How do you manage lead times for Inconel 625 forgings?",
        a: "ForceBeyond maintains strategic billet supply across its US and Asian manufacturing network to help reduce exposure to extended mill lead times. Actual delivery depends on material availability, forging route, geometry, quantity, heat treatment, inspection requirements, and customer specifications."
    },
    {
        q:" What is the difference between Superalloy Casting vs. Forging?",
        a: "Forging is commonly selected for components that benefit from a wrought structure, controlled material flow, and high fatigue or mechanical performance. Casting can be advantageous for complex shapes, internal passages, and thin-wall geometries that are difficult to produce through forging. The appropriate manufacturing route depends on geometry, loading, service environment, specification, quantity, and inspection requirements."
    },
];

// Sources
const sources = [
    {
        label: "Special Metals - INCONEL Alloy 718 Technical Bulletin",
