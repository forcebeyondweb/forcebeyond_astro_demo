        url: "https://saemobilus.sae.org/standards/ams5662p-nickel-alloy-corrosion-heat-resistant-bars-forgings-rings-stock-forgings-rings-525ni-19cr-30mo-51cb-nb-090ti-050al-18fe-consumable-electrode-vacuum-induction-melted-1775-f-968-c-solution-heat-treated-precipitation-hardenable"
    },
    {
        label: "SAE International - AMS 5663 Inconel 718 Bars, Forgings and Rings",
        url: "https://saemobilus.sae.org/standards/ams5663"
    },
    {
