  },
  {
    label: 'SAE International - AMS 5401 Inconel 625 Investment Castings',
    url: 'https://saemobilus.sae.org/standards/ams5401-alloy-castings-investment-corrosion-heat-resistant-62ni-215cr-90mo-36-cb-ta-vacuum-melted-vacuum-cast'
  },
  {
