const dates = pageDates['/superalloy-casting-guide/'];

const pageTitle = 'Superalloy Casting Technical Guide: Inconel 718, Inconel 625, VIM & HIP';
const seoTitle = 'Superalloy Casting Technical Guide | Inconel 718 & 625 | ForceBeyond';
const seoDescription = 'Technical guide to superalloy casting, Inconel 718 and 625, Vacuum Induction Melting (VIM), HIP, NDT, alloy selection, casting-vs-forging screening, and quality control.';
const pdfUrl = '/media/superalloy-casting-guide.pdf';

const faqs = [
  {
    q: 'What is ForceBeyond’s superalloy casting capability?',
    a: 'ForceBeyond describes precision casting support for nickel-based superalloys and related high-performance materials, with vacuum investment casting, VIM for applicable routes, HIP where required, NDT, material traceability, machining, and manufacturing support across its USA, South Korea, and Taiwan network.'
  },
  {
    q: 'Is HIP required for every Inconel casting?',
    a: 'No. HIP is applied when required by the drawing, material specification, qualification plan, customer requirements, or service conditions. It may be used to reduce internal microporosity and increase density, but it is not a universal zero-defect guarantee.'
  },
  {
    q: 'When should Inconel 718 be considered for casting?',
    a: 'Inconel 718 is commonly considered when mechanical strength, creep performance, and elevated-temperature capability are important design drivers. Final material and process selection must follow the component design, service conditions, heat-treatment condition, and governing specification.'
  },
  {
    q: 'When should Inconel 625 be considered for casting?',
    a: 'Inconel 625 is commonly considered when corrosion resistance, including resistance to pitting, crevice corrosion, and chloride-containing environments, is a primary design driver. Final use must follow the service environment, loading, temperature, applicable code, qualification plan, and governing specification.'
  },
  {
    q: 'What is the difference between superalloy casting and forging?',
    a: 'Vacuum investment casting is commonly selected for complex and near-net-shape geometries, while forging is commonly selected when a wrought structure and controlled material flow are important. Neither route is universally superior; the correct process depends on geometry, loading, quantity, inspection requirements, and governing specifications.'
  }
];

const sources = [
  {
    label: 'SAE International - AMS 5383 Inconel 718 Investment Castings',
