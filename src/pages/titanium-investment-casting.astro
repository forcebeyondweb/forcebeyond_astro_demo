            "position": "2",
            "item": {
              "@type": "Service",
              "name": "Hot Isostatic Pressing (HIP) Treatment"
            }
          },
          {
            "@type": "ListItem",
            "position": "3",
            "item": {
              "@type": "Service",
              "name": "Thin-Walled Precision Geometry"
            }
          }
        ]
      }
