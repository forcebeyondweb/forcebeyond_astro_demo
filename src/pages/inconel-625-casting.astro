---
import { pageDates } from '../data/page-dates.js';
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';


const dates = pageDates['/inconel-625-casting/'];

const pageTitle = 'Inconel 625 Casting Services: Co-Owned Foundries in USA, South Korea & Taiwan';
const seoTitle = 'Inconel 625 Casting Services | Nuclear SMR & Marine | ForceBeyond';
const seoDescription = 'Inconel 625 vacuum investment casting with VIM, HIP where required, NDT and machining for corrosion-critical marine, chemical-processing and selected nuclear applications.';
const faqs = [
    {
        q: "Why choose ForceBeyond as your Inconel casting supplier?",
        a: "<strong>ForceBeyond</strong> provides Inconel casting through a co-owned manufacturing network in the USA and Asia, with engineering and quality oversight coordinated across casting, heat treatment, inspection, machining, and documentation. VIM and HIP are applied where appropriate to the alloy, drawing, specification, qualification plan, and customer requirements."
    },
    {
        q: "How does ForceBeyond ensure supply chain reliability for Inconel 625?",
        a: "ForceBeyond provides a de-risked supply chain through our co-owned foundry network in the USA, South Korea, and Taiwan. By maintaining direct operational control over the casting and NDT processes, we eliminate the risks associated with third-party brokers and provide the high-level engineering oversight required for mission-critical Nuclear SMR and subsea projects."
    },
    {
        q: "When should I choose Inconel 625 over Inconel 718?",
        a: "Inconel 625 is commonly considered when corrosion and oxidation resistance are primary design drivers, particularly in seawater, chloride-containing, or chemical-processing environments. Inconel 718 is commonly considered when higher mechanical strength and creep performance dominate. Final selection must follow the service environment, loading, temperature, material condition, and governing specification. See our <a href='/inconel-718-casting/' class='highlight-link'>Inconel 718 Casting</a> page for the strength-oriented option."  
    },
    {
        q: "Can ForceBeyond provide large-scale Inconel 625 castings?",
        a: "Yes. Our vacuum precision casting capabilities support parts up to <strong>32 inches</strong> in size and <strong>220 pounds</strong> in weight, covering a wide range of industrial gas turbine and marine components."
    }
];

// Sources
const sources = [
    { label: "SAE International - AMS 5401 Inconel 625 Investment Castings", url: "https://saemobilus.sae.org/standards/ams5401-alloy-castings-investment-corrosion-heat-resistant-62ni-215cr-90mo-36-cb-ta-vacuum-melted-vacuum-cast" },
    { label: "Special Metals - INCONEL Alloy 625 Technical Bulletin", url: "https://www.specialmetals.com/documents/technical-bulletins/inconel/inconel-alloy-625.pdf" }
];

// Resources 
const internalResources = [
    { label: "Superalloy Casting Technical Guide", url: "/superalloy-casting-guide/" },
    // Die Casting Resources
    { label: "Die Casting Overview", url: "/die-casting/" },
    { label: "Aluminum Die Casting", url: "/aluminum-die-casting/" },
    { label: "Zinc Die Casting", url: "/zinc-die-casting/" },
    { label: "A356-T6 Casting", url: "/a356-t6-casting/" },
    { label: "Magnesium Casting", url: "/magnesium-casting/" },

    // Investment Casting Resources
    { label: "Investment Casting Overview", url: "/investment-casting/" },
    { label: "Inconel Vacuum Precision Casting", url: "/inconel-vacuum-precision-casting/" },
    { label: "Titanium Investment Casting", url: "/titanium-investment-casting/" },
    { label: "Stainless Steel Casting", url: "/stainless-steel-casting/" },
    { label: "Duplex & Super Duplex Stainless Steel Casting", url: "/duplex-stainless-steel-casting/" },

    // Forging Resources
    { label: "Forging Capabilities Overview", url: "/forging/" },
    { label: "Open Die Forging", url: "/open-die-forging/" },
    { label: "Closed Die Forging", url: "/closed-die-forging/" },
    { label: "Rolled Ring Forging", url: "/rolled-ring-forging/" },
    { label: "Cold Forging", url: "/cold-forging/" },
    { label: "Superalloy Forging Services", url: "/high-performance-superalloy-forging/" },

    // Sand Casting & Steel Casting Resources
    { label: "Sand Casting", url: "/sand-casting/" },
    { label: "Industrial Titanium Sand Casting", url: "/industrial-titanium-sand-casting/" },
    { label: "Carbon & Low-Alloy Steel Casting", url: "/carbon-steel-casting/" }
];
// Page-level schema migrated from the current forcebeyond.com page.
// Global Place, Organization, and WebSite entities are defined in Layout.astro.
const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.forcebeyond.com/inconel-625-casting/#webpage",
      "url": "https://www.forcebeyond.com/inconel-625-casting/",
      "name": "Inconel 625 Casting Services | Nuclear SMR & Marine | ForceBeyond",
      "datePublished": "2022-10-21T11:35:23-04:00",
      "dateModified": "2026-03-04T14:32:19-05:00",
      "isPartOf": {
        "@id": "https://www.forcebeyond.com/#website"
      },
      "mainEntity": {
        "@id": "https://www.forcebeyond.com/inconel-625-casting/#service"
      },
      "inLanguage": "en-US"
    },
    {
      "@type": "Service",
      "@id": "https://www.forcebeyond.com/inconel-625-casting/#service",
      "serviceType": "Inconel 625 Vacuum Precision Casting",
      "provider": {
        "@id": "https://www.forcebeyond.com/#organization"
      },
      "description": "Inconel 625 vacuum investment casting with VIM, HIP where required, NDT, and machining for corrosion-critical marine, chemical-processing, subsea, and selected nuclear applications.",
      "areaServed": [
        {
          "@type": "Country",
          "name": "United States"
        },
        {
          "@type": "Country",
          "name": "South Korea"
        },
        {
          "@type": "Country",
          "name": "Taiwan"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.forcebeyond.com/inconel-625-casting/#faq",
      "url": "https://www.forcebeyond.com/inconel-625-casting/#faq",
      "mainEntity": faqs.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a.replace(/<[^>]+>/g, "")
        }
      }))
    }
  ]
