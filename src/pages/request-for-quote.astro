---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';

// 1. Precisely fetch dynamic configuration copy for the inquiry/quote page from the Sanity cloud.
const data = await sanityClient.fetch(`*[_type == "quotePage"][0]`);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const countries = ['United States of America','Afghanistan', 'Albania', 'Algeria', 'Andorra', 'Angola', 'Argentina', 'Armenia', 'Australia', 'Austria', 'Azerbaijan', 'Bahamas', 'Bahrain', 'Bangladesh', 'Barbados', 'Belgium', 'Belize', 'Brazil', 'Bulgaria', 'Cambodia', 'Cameroon', 'Canada', 'Chile', 'China', 'Colombia', 'Costa Rica', 'Croatia', 'Cyprus', 'Czechia', 'Denmark', 'Dominican Republic', 'Ecuador', 'Egypt', 'El Salvador', 'Estonia', 'Ethiopia', 'Finland', 'France', 'Germany', 'Ghana', 'Greece', 'Guatemala', 'Hong Kong', 'Hungary', 'Iceland', 'India', 'Indonesia', 'Ireland', 'Israel', 'Italy', 'Japan', 'Jordan', 'Kenya', 'Malaysia', 'Mexico', 'Netherlands', 'New Zealand', 'Nigeria', 'Norway', 'Pakistan', 'Panama', 'Peru', 'Philippines', 'Poland', 'Portugal', 'Qatar', 'Romania', 'Saudi Arabia', 'Singapore', 'South Africa', 'South Korea', 'Spain', 'Sweden', 'Switzerland', 'Taiwan', 'Thailand', 'Turkey', 'Ukraine', 'United Arab Emirates', 'United Kingdom', 'Uruguay', 'Vietnam'];
const sources = ['Cold Call', 'Direct Mail', 'Email', 'Industry Event', 'Referral', 'Search Engine', 'Web Research', 'AI Search (ChatGPT/Gemini/Claude)'];
const budgets = ['$0 - $25,000', '$25,001 - $100,000', '$100,001 - $250,000', '$250,001 - $500,000', '$500,001 - $1,000,000', '$1,000,000 & Above'];
const input = 'mt-2 w-full border border-slate-200 transition-all duration-300 bg-white px-5 py-3.5 text-slate-900 text-sm font-medium outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-100 placeholder:text-slate-400';
// Define safe file extensions for engineering blueprints
const allowedExtensions = ['.pdf', '.dwg', '.dxf', '.step', '.stp', '.iges', '.igs', '.sldprt', '.zip', '.jpg', '.jpeg', '.png','.doc','.docx'];
---

<Layout title="Request a Quote | ForceBeyond" description={data?.seoDescription || "Request a quote for custom metal component manufacturing."}>
    <script slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    
    <section class="relative border-b border-white/10 bg-slate-900 h-[420px] lg:h-[500px] flex items-center justify-center overflow-hidden">
    <img 
        src="/media/trust.webp" 
        alt="Request for Quote"
        class="absolute inset-0 z-0 h-full w-full object-cover object-center"
    />

    <div class="absolute inset-0 z-1 bg-slate-950/25"></div>
    <div class="absolute inset-0 z-2 bg-gradient-to-r from-slate-950/45 via-transparent to-transparent"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="mt-3 text-4xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl  leading-none">
            Request for quote
        </h1>
    </div>
</section>

    <section class="bg-slate-100 py-14 text-slate-900 sm:py-20">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            
            <div id="thankYouState" class="hidden mx-auto max-w-2xl border border-slate-200 bg-white p-8 text-center shadow-xl shadow-slate-900/10 sm:p-12">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-green-100 text-green-600">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                </div>
                <h2 class="mt-6 text-3xl font-bold tracking-tight text-slate-900">Thank You!</h2>
                <p class="mt-4 text-lg text-slate-600">
                    Thank you so much for contacting us!
                    Your Request for Quote (RFQ) has been safely received along with your engineering assets. 
                    Our team will review your specs and get back to you.
                </p>
                <div class="mt-8">
                    <button onclick="window.location.reload()" class="inline-flex items-center justify-center bg-slate-900 px-6 py-3 text-sm font-bold text-white transition hover:bg-slate-800">
                        Submit Another Request
                    </button>
                </div>
            </div>
            
            <form 
                id="rfqForm"
                action="/quote.php" 
                method="POST" 
                enctype="multipart/form-data"
                novalidate
                class="bg-white rounded-2xl border border-slate-200/80 shadow-xl shadow-slate-900/5 overflow-hidden"
            >
                <div class="border-b border-slate-200 bg-white px-8 py-6 lg:px-14">
                    <p class="text-xs font-black tracking-wider text-slate-500 ">
                        <span class="mr-2 text-blue-600">*</span>Required fields
                    </p>
                </div>
        
                <div class="grid gap-x-6 gap-y-8 p-8 lg:grid-cols-2 lg:p-14">
                    <div class="mb-10 lg:col-span-2">
                        <h2 class="text-2xl font-black tracking-tight text-slate-950 ">
                            Ready to Start A Conversation? Request for Quote?
                        </h2>

                        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600">
                            Hey ForceBeyond, I would like to drop you a line about my project/product needs.
                            Please contact me back to start a conversation.
                        </p>
                    </div>
                    <div class="lg:col-span-2">
                        <h2 class="text-2xl font-black tracking-tight text-slate-950 ">My Contact Information<span class="text-blue-600">(Required)</span></h2>
                    </div>
            
                    <label class="block text-xs font-bold text-slate-500  tracking-wider">My First Name <span class="text-blue-600">*</span><input class={input} required name="first-name" autocomplete="given-name" type="text" /></label>
                    <label class="block text-xs font-bold text-slate-500  tracking-wider">My Last Name <span class="text-blue-600">*</span><input class={input} required name="last-name" autocomplete="family-name" type="text" /></label>
                    <label class="block text-xs font-bold text-slate-500  tracking-wider">My Job Title Is <span class="text-blue-600">*</span><input class={input} required name="job-title" autocomplete="organization-title" type="text" /></label>
                    <label class="block text-xs font-bold text-slate-500  tracking-wider">My Business / Organization Is <span class="text-blue-600">*</span><input class={input} required name="organization" autocomplete="organization" type="text" /></label>
                    <label class="block text-xs font-bold text-slate-500  tracking-wider">My Email Is <span class="text-blue-600">*</span><input id="quote-email" class={input} required name="email" autocomplete="email" type="email" /></label>
                    <label class="block text-xs font-bold text-slate-500  tracking-wider">Confirm Email <span class="text-blue-600">*</span><input id="quote-confirm-email" class={input} required name="confirm-email" autocomplete="email" type="email" /></label>

                    <div class="lg:col-span-2 border-t border-slate-200 pt-10">
                        <h2 class="text-2xl font-black tracking-tight text-slate-950 ">My Address<span class="text-blue-600">(Required)</span></h2>
                        <div class="mt-6 grid gap-6 lg:grid-cols-2">
                            <label class="block text-xs font-bold text-slate-500  tracking-wider">Address Line 1 <span class="text-blue-600">*</span><input class={input} required name="address-line-1" autocomplete="address-line1" type="text" /></label>
                            <label class="block text-xs font-bold text-slate-500  tracking-wider">Address Line 2 <span class="text-slate-400">(Optional)</span><input class={input} name="address-line-2" autocomplete="address-line2" type="text" /></label>
                            <label class="block text-xs font-bold text-slate-500  tracking-wider">City <span class="text-blue-600">*</span><input class={input} required name="city" autocomplete="address-level2" type="text" /></label>
                            <label class="block text-xs font-bold text-slate-500  tracking-wider">State <span class="text-blue-600">*</span><input class={input} required name="state" autocomplete="address-level1" type="text" /></label>
                            <label class="block text-xs font-bold text-slate-500  tracking-wider">Postal Code <span class="text-blue-600">*</span><input class={input} required name="postal-code" autocomplete="postal-code" type="text" /></label>
                            <label class="block text-xs font-bold text-slate-500  tracking-wider">Country:<span class="text-blue-600">*</span>
                                <select class={input} required name="country" autocomplete="country-name">
                                    <option value="">Select a country</option>
                                    {countries.map((country) => <option value={country}>{country}</option>)}
                                </select>
                            </label>
                        </div>
                    </div>

                    <fieldset class="lg:col-span-2 border-t border-slate-200 pt-10">
                        <h2 class="text-2xl font-black tracking-tight text-slate-950 ">How Did You Hear About ForceBeyond? <span class="text-blue-600">(Required)</span></h2>
                        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                            {sources.map((source) => (
                                <label class="flex cursor-pointer items-center gap-3 rounded border border-slate-200 bg-slate-50/50 px-4 py-3 text-xs font-bold text-slate-700 transition hover:border-blue-500 hover:bg-slate-50">
                                    <input type="radio" name="marketing-source" value={source} required class="h-4 w-4 accent-blue-600" />{source}
                                </label>
                            ))}
                        </div>
                    </fieldset>

                    <fieldset class="lg:col-span-2 border-t border-slate-200 pt-10">
                        <h2 class="text-2xl font-black tracking-tight text-slate-950">
                            I Am Interested In <span class="text-blue-600">(Required)</span>
                        </h2>

                        <div class="mt-6">
                            <textarea
                                id="project-interest"
                                class={`${input} mt-2 min-h-36 resize-y py-4`}
                                name="project-interest"
                                required
                                rows="5"
                                placeholder="Casting, forging, machining, or another requirement"
                            ></textarea>
                        </div>
                    </fieldset>

                    <fieldset class="lg:col-span-2 border-t border-slate-200 pt-10">
                        <h2 class="text-2xl font-black tracking-tight text-slate-950">
                            With Annual Budget Of <span class="text-blue-600">(Required)</span>
                        </h2>

                        <div class="mt-6 grid gap-2 sm:grid-cols-2">
                            {budgets.map((budget) => (
                                <label
                                    class="flex cursor-pointer items-center gap-3 rounded border border-slate-200 bg-slate-50/50 px-4 py-3 text-xs font-bold text-slate-700 transition hover:border-blue-500 hover:bg-slate-50"
                                >
                                    <input
                                        type="radio"
                                        name="annual-budget"
                                        value={budget}
                                        required
                                        class="h-4 w-4 accent-blue-600"
                                    />
                                    <span>{budget}</span>
                                </label>
                            ))}
                        </div>
                    </fieldset>

                    <fieldset class="lg:col-span-2 border-t border-slate-200 pt-10">
                        <h2 class="text-2xl font-black tracking-tight text-slate-950">
                            Give Me a Call Sometime At<span class="text-blue-600">(Required)</span>
                        </h2>

                        <div class="mt-6">
                            <label
                                for="phone"
                                class="block text-xs font-bold tracking-wider text-slate-500"
                            >
                                Phone Number
                                <span class="text-blue-600">*</span>
                            </label>

                            <input
                                id="phone"
                                class={input}
                                required
                                name="phone"
                                autocomplete="tel"
                                type="tel"
                            />
                        </div>
                    </fieldset>

                    <fieldset class="lg:col-span-2 border-t border-slate-200 pt-10">
                        <h2 class="text-2xl font-black tracking-tight text-slate-950">
                            Engineering Assets <span class="text-slate-400 text-sm font-semibold">(Optional)</span>
                        </h2>

                        <label
                            for="fileInput"
                            class="mt-6 flex min-h-48 cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-200 bg-slate-50/60 px-6 text-center transition hover:border-blue-500 hover:bg-blue-50/60 focus-within:border-blue-600"
                        >
                            <svg
                                class="h-10 w-10 text-slate-400"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.7"
                                aria-hidden="true"
                            >
                                <path
                                    d="M12 16V4m0 0L8 8m4-4 4 4M5 14v5h14v-5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                            </svg>

                            <span class="mt-4 font-bold normal-case" id="fileStatus">
                                Click or drag files here to upload.
                            </span>

                            <span class="mt-2 text-sm text-slate-600">
                                Supported formats: PDF, DWG, DXF, STEP, IGES, SLDPRT, ZIP,
                                images, and documents. Maximum 25 MB per file.
                            </span>

                            <input
                                id="fileInput"
                                name="engineering-assets[]"
                                type="file"
                                multiple
                                accept={allowedExtensions.join(',')}
                                class="sr-only"
                            />
                        </label>

                        <div
                            id="fileError"
                            class="mt-3 hidden text-sm font-bold text-red-600"
                        ></div>

                        <div id="fileListContainer" class="mt-4 hidden">
                            <p class="text-xs font-bold tracking-wider text-slate-500">
                                Files Selected for Upload:
                            </p>

                            <ul
                                id="fileVisualList"
                                class="mt-2 divide-y divide-slate-200 rounded-md border border-slate-200 bg-slate-50"
                            ></ul>
                        </div>
                    </fieldset>
                    <!-- Honeypot: human visitors will never see or complete this field -->
                    <div class="absolute -left-[10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
                        <label>
                            Leave this field empty
                            <input type="text" name="website-url" tabindex="-1" autocomplete="off" />
                        </label>
                    </div>

                    <div class="lg:col-span-2 border-t border-slate-200 pt-10">
                        {turnstileSiteKey ? (
                            <div
                                class="cf-turnstile"
                                data-sitekey={turnstileSiteKey}
                                data-theme="light"
                                data-size="flexible"
                                data-action="rfq-form"
                                data-language="en"
                            ></div>
                        ) : (
                            <p class="text-sm font-bold text-red-600">Security verification is not configured.</p>
                        )}
                        <p class="mt-2 text-xs text-slate-500">Security verification helps prevent automated RFQ spam.</p>
                    </div>

                </div>
        
                <div class="border-t border-slate-200 bg-white px-8 py-8 lg:px-14 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div id="formErrorMessage" class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-bold text-red-700" role="alert" aria-live="polite"></div>
                    <button type="submit" id="submitBtn" class="w-full rounded-full bg-blue-600 px-12 py-4 font-black tracking-widest text-white  text-xs transition hover:bg-blue-700 hover:scale-[1.02] active:scale-[0.98] shadow-lg shadow-blue-600/10 cursor-pointer sm:w-auto">
                        Submit Request
                    </button>
                </div>
            </form>
        </div>
    </section>
</Layout>


<script is:inline>
    // 1. Email check
    const email = document.querySelector('#quote-email');
    const confirmation = document.querySelector('#quote-confirm-email');
    const validateEmailMatch = () => confirmation.setCustomValidity(confirmation.value && confirmation.value !== email.value ? 'Email addresses must match.' : '');
    
    const allowedExtensions = ['.pdf', '.dwg', '.dxf', '.step', '.stp', '.iges', '.igs', '.sldprt', '.zip', '.jpg', '.jpeg', '.png', '.doc', '.docx'];
    const MAX_FILE_SIZE = 25 * 1024 * 1024;

    email.addEventListener('input', validateEmailMatch);
    confirmation.addEventListener('input', validateEmailMatch);

    // Keep selected files in a normal JavaScript array instead of assigning to
    // input.files via DataTransfer. Programmatic FileList replacement is not
    // reliable on iOS Safari and some other mobile browsers.
    let selectedEngineeringFiles = [];

    const fileInput = document.getElementById('fileInput');
    const fileStatus = document.getElementById('fileStatus');
    const fileError = document.getElementById('fileError');
    const fileListContainer = document.getElementById('fileListContainer');
    const fileVisualList = document.getElementById('fileVisualList');

    fileInput.addEventListener('change', () => {
        const freshSelectedFiles = Array.from(fileInput.files || []);
        fileError.classList.add('hidden');
        fileError.textContent = '';

        for (const file of freshSelectedFiles) {
            const extension = '.' + file.name.split('.').pop().toLowerCase();
            const lowerName = file.name.toLowerCase();

            if (lowerName.includes('.php') || lowerName.includes('.js') || lowerName.includes('.sh') || lowerName.includes('.exe')) {
                fileError.textContent = `🛑 Security exception: "${file.name}" is unauthorized.`;
                fileError.classList.remove('hidden');
                continue;
            }

            if (!allowedExtensions.includes(extension)) {
                fileError.textContent = `❌ Extension rejected: "${extension}" is not supported.`;
                fileError.classList.remove('hidden');
                continue;
            }

            if (file.size > MAX_FILE_SIZE) {
                fileError.textContent = `❌ File size exceeded: "${file.name}" is larger than 25MB.`;
                fileError.classList.remove('hidden');
                continue;
            }

            if (selectedEngineeringFiles.length >= 10) {
                fileError.textContent = '⚠️ You can upload a maximum of 10 engineering assets.';
                fileError.classList.remove('hidden');
                break;
            }

            const duplicate = selectedEngineeringFiles.some(
                (existingFile) => existingFile.name === file.name && existingFile.size === file.size
            );

            if (!duplicate) {
                selectedEngineeringFiles.push(file);
            }
        }

        // Clear the native picker after copying the File objects. This allows the
        // same file to be selected again later and avoids relying on FileList mutation.
        fileInput.value = '';
        renderVisualList();
    });

    function renderVisualList() {
        fileVisualList.innerHTML = '';

        if (selectedEngineeringFiles.length > 0) {
            let totalSize = 0;

            selectedEngineeringFiles.forEach((file, i) => {
                totalSize += file.size;
                const sizeInMB = (file.size / (1024 * 1024)).toFixed(2);

                const li = document.createElement('li');
                li.className = 'flex items-center justify-between px-4 py-3 text-sm';
                li.innerHTML = `
                    <div class="flex items-center gap-2 truncate">
                        <svg class="h-5 w-5 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <span class="font-medium text-slate-700 truncate"></span>
                    </div>
                    <div class="flex items-center gap-3 flex-shrink-0">
                        <span class="text-xs font-semibold text-slate-400 bg-slate-200/60 px-2 py-1 rounded">${sizeInMB} MB</span>
                        <button type="button" data-index="${i}" class="remove-file-btn text-red-500 hover:text-red-700 font-bold px-1" aria-label="Remove ${file.name}">✕</button>
                    </div>
                `;

                // Do not inject a user-controlled filename through innerHTML.
                li.querySelector('.font-medium').textContent = file.name;
                fileVisualList.appendChild(li);
            });

            const totalMB = (totalSize / (1024 * 1024)).toFixed(1);
            fileStatus.innerHTML = `Total <span class="text-blue-600 font-extrabold">${selectedEngineeringFiles.length}</span> file(s) selected (${totalMB} MB).`;
            fileListContainer.classList.remove('hidden');

            fileVisualList.querySelectorAll('.remove-file-btn').forEach((btn) => {
                btn.addEventListener('click', () => {
                    const indexToRemove = Number(btn.getAttribute('data-index'));
                    selectedEngineeringFiles.splice(indexToRemove, 1);
                    renderVisualList();
                });
            });
        } else {
            fileStatus.textContent = 'Click or tap here to upload files.';
            fileListContainer.classList.add('hidden');
        }
    }

    const form = document.getElementById('rfqForm');
    const submitBtn = document.getElementById('submitBtn');
    const thankYouState = document.getElementById('thankYouState');
    const formErrorMessage = document.getElementById('formErrorMessage');

    // Every user-facing field is required except Address Line 2 and engineering attachments.
    const requiredFields = [
        { name: 'first-name', label: 'First Name' },
        { name: 'last-name', label: 'Last Name' },
        { name: 'job-title', label: 'Job Title' },
        { name: 'organization', label: 'Business / Organization' },
        { name: 'email', label: 'Email' },
        { name: 'confirm-email', label: 'Confirm Email' },
        { name: 'address-line-1', label: 'Address Line 1' },
        { name: 'city', label: 'City' },
        { name: 'state', label: 'State' },
        { name: 'postal-code', label: 'Postal Code' },
        { name: 'country', label: 'Country' },
        { name: 'marketing-source', label: 'How Did You Hear About ForceBeyond' },
        { name: 'project-interest', label: 'Project Interest' },
        { name: 'annual-budget', label: 'Annual Budget' },
        { name: 'phone', label: 'Phone Number' }
    ];

    const getFieldsByName = (name) =>
        Array.from(form.querySelectorAll(`[name="${name}"]`));

    const isFieldMissing = (name) => {
        const fields = getFieldsByName(name);

        if (!fields.length) {
            return true;
        }

        if (fields[0].type === 'radio' || fields[0].type === 'checkbox') {
            return !fields.some((field) => field.checked);
        }

        return !String(fields[0].value || '').trim();
    };

    const getValidationTarget = (field) => {
        if (!field) return null;

        // Radio groups should scroll to their complete visible section and heading,
        // rather than to the tiny first radio control.
        if (field.type === 'radio' || field.type === 'checkbox') {
            return field.closest('fieldset') || field.closest('label') || field;
        }

        return field.closest('label') || field.closest('fieldset') || field;
    };

    const clearValidationHighlight = () => {
        form.querySelectorAll('[data-validation-error="true"]').forEach((element) => {
            element.removeAttribute('data-validation-error');
            element.classList.remove('ring-2', 'ring-red-500', 'ring-offset-4');
        });

        form.querySelectorAll('[aria-invalid="true"]').forEach((field) => {
            field.removeAttribute('aria-invalid');
        });
    };

    const showValidationLocation = (field) => {
        if (!field) return;

        clearValidationHighlight();

        const target = getValidationTarget(field);
        const groupFields = field.name ? getFieldsByName(field.name) : [field];

        groupFields.forEach((groupField) => groupField.setAttribute('aria-invalid', 'true'));

        if (target) {
            target.setAttribute('data-validation-error', 'true');
            target.classList.add('ring-2', 'ring-red-500', 'ring-offset-4');

            // Manual offset is more reliable than scrollIntoView on iOS Safari,
            // especially when the website has a sticky header.
            const headerOffset = 120;
            const top = Math.max(
                0,
                target.getBoundingClientRect().top + window.pageYOffset - headerOffset
            );

            window.scrollTo({
                top,
                behavior: 'smooth'
            });
        }

        // Focus after starting the scroll. preventScroll avoids mobile browsers
        // overriding the carefully calculated position.
        window.setTimeout(() => {
            try {
                field.focus({ preventScroll: true });
            } catch {
                field.focus();
            }
        }, 350);
    };

    form.addEventListener('input', (event) => {
        const field = event.target;
        if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return;

        field.removeAttribute('aria-invalid');
        const target = getValidationTarget(field);
        target?.removeAttribute('data-validation-error');
        target?.classList.remove('ring-2', 'ring-red-500', 'ring-offset-4');
    });

    form.addEventListener('change', (event) => {
        const field = event.target;
        if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return;

        field.removeAttribute('aria-invalid');
        const target = getValidationTarget(field);
        target?.removeAttribute('data-validation-error');
        target?.classList.remove('ring-2', 'ring-red-500', 'ring-offset-4');
    });

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        formErrorMessage.classList.add('hidden');
        clearValidationHighlight();

        validateEmailMatch();

        const missingFields = requiredFields.filter(({ name }) => isFieldMissing(name));
        const firstBrowserInvalidField = form.querySelector(':invalid');

        if (missingFields.length > 0 || firstBrowserInvalidField) {
            const missingLabels = missingFields.map(({ label }) => label).join(', ');

            formErrorMessage.textContent = missingLabels
                ? `Please complete: ${missingLabels}.`
                : firstBrowserInvalidField?.validationMessage || 'Please correct the highlighted field.';

            formErrorMessage.classList.remove('hidden');

            const firstMissingName = missingFields[0]?.name;
            const firstInvalidField = firstMissingName
                ? form.querySelector(`[name="${firstMissingName}"]`)
                : firstBrowserInvalidField;

            showValidationLocation(firstInvalidField);
            return;
        }

        const turnstileToken = form.querySelector('input[name="cf-turnstile-response"]')?.value;

        if (!turnstileToken) {
            formErrorMessage.textContent = 'Please complete the security verification.';
            formErrorMessage.classList.remove('hidden');

            const turnstileSection = form.querySelector('.cf-turnstile')?.parentElement;
            if (turnstileSection) {
                turnstileSection.setAttribute('data-validation-error', 'true');
                turnstileSection.classList.add('ring-2', 'ring-red-500', 'ring-offset-4');

                const top = Math.max(
                    0,
                    turnstileSection.getBoundingClientRect().top + window.pageYOffset - 120
                );
                window.scrollTo({ top, behavior: 'smooth' });
            }
            return;
        }

        submitBtn.textContent = 'Uploading Assets & Submitting RFQ...';
        submitBtn.disabled = true;

        const formData = new FormData(form);

        // The native file input is intentionally cleared after selection. Append
        // our retained File objects directly so mobile and desktop submit identically.
        formData.delete('engineering-assets[]');
        selectedEngineeringFiles.forEach((file) => {
            formData.append('engineering-assets[]', file, file.name);
        });

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: formData
            });

            let result;
            const contentType = response.headers.get('content-type');
            if (contentType && contentType.includes('application/json')) {
                result = await response.json();
            } else {
                const textResponse = await response.text();
                result = { success: false, error: textResponse || 'The server returned an invalid response.' };
            }

            if (response.ok && result.success === true) {
                form.reset();
                clearValidationHighlight();
                selectedEngineeringFiles = [];
                renderVisualList();
                form.classList.add('hidden');
                thankYouState.classList.remove('hidden');
                window.scrollTo({ top: thankYouState.offsetTop - 100, behavior: 'smooth' });
            } else {
                window.turnstile?.reset();
                formErrorMessage.textContent = result.error || `Submission failed (HTTP ${response.status}). Please try again.`;
                formErrorMessage.classList.remove('hidden');
                showValidationLocation(formErrorMessage);
            }
        } catch (error) {
            window.turnstile?.reset();
            formErrorMessage.textContent = 'A transmission anomaly took place.';
            formErrorMessage.classList.remove('hidden');
            showValidationLocation(formErrorMessage);
        } finally {
            submitBtn.textContent = 'Submit Request';
            submitBtn.disabled = false;
        }
    });
</script>