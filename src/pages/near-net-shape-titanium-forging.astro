---
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';

const pageTitle = 'Near-Net-Shape (NNS) Titanium Forging: Material Yield Optimization';
const seoTitle = 'Near-Net-Shape Titanium Forging | 3.5:1 Buy-to-Fly Ratio';
const seoDescription = 'Optimize material yield with NNS Titanium Forging. Reduce waste by 45%. Integrated Tier-1.5 Forge-to-Finish oversight in USA, S. Korea & Taiwan.';
const faqs = [
    {
        q: "What is the primary benefit of Near-Net-Shape (NNS) over traditional forging?",
        a: "The primary benefit is the drastic reduction in “Buy-to-Fly” costs. By forging the part closer to its final dimensions, you purchase less raw titanium and spend fewer hours in the CNC machine shop, leading to a total cost reduction of <strong>20% to 35%</strong>."
    },
    {
        q: "Does NNS forging impact the strength of the part?",
        a: "NNS forging does not inherently increase or decrease material strength. The primary objective is to produce a forged preform closer to final geometry while preserving the required wrought structure. Final mechanical properties depend on alloy, deformation history, forging temperature, reduction, heat treatment, section size, and the governing material specification."
    }
];

// Sources
const sources = [
    {
        label: "NASA - Net Shape Processing of Titanium Alloys for Enhanced Performance and Improved Affordability",
        url: "https://ntrs.nasa.gov/citations/20200005561"
    },
    {
        label: "NASA - Near-Net Forging Technology Demonstration Program",
        url: "https://ntrs.nasa.gov/citations/19970015005"
    },
    {
        label: "NASA - Near Net Shape Processing for Advanced Materials Applications",
        url: "https://ntrs.nasa.gov/citations/19930021760"
    },
    {
        label: "Forging Industry Association - Forgings Compared with Machined Bar and Plate",
        url: "https://www.forging.org/fia/content/about/design-engineering-center-content/How_Forgings_Compare_to_Other_Processes.aspx"
    }
];

// Resources 
const internalResources = [
    { label: "Titanium Forging Services", url: "/titanium-forging/" },

    // Related titanium forging routes
    { label: "Titanium Aerospace Forging", url: "/titanium-aerospace-forging/" },
    { label: "High-Strength Beta Titanium Forging", url: "/high-strength-beta-titanium-forging/" },

    // Relevant forging methods
    { label: "Closed Die Forging", url: "/closed-die-forging/" },
    { label: "Open Die Forging", url: "/open-die-forging/" },

    // Finish and alternative manufacturing
    { label: "Titanium Machining", url: "/titanium-machining/" },
    { label: "Titanium Investment Casting", url: "/titanium-investment-casting/" }
];
// Page-level schema migrated from the current forcebeyond.com page.
// Global Place, Organization, and WebSite entities are defined in Layout.astro.
const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.forcebeyond.com/near-net-shape-titanium-forging/#webpage",
      "url": "https://www.forcebeyond.com/near-net-shape-titanium-forging/",
      "name": "Near-Net-Shape Titanium Forging | Material Yield Optimization | ForceBeyond",
      "description": "Near-net-shape titanium forging services designed to reduce machining stock, improve material utilization, and integrate forged preforms with precision machining for aerospace and industrial components.",
      "datePublished": "2026-03-05T15:00:25-05:00",
      "dateModified": "2026-08-11T14:36:00-04:00",
      "isPartOf": {
        "@id": "https://www.forcebeyond.com/#website"
      },
      "mainEntity": {
        "@id": "https://www.forcebeyond.com/near-net-shape-titanium-forging/#service"
      },
      "inLanguage": "en-US"
    },
    {
      "@type": "Service",
      "@id": "https://www.forcebeyond.com/near-net-shape-titanium-forging/#service",
      "name": "Near-Net-Shape Titanium Forging",
      "serviceType": "Near-Net-Shape Titanium Forging",
      "description": "Engineering and manufacturing support for near-net-shape titanium forged preforms designed to place material closer to final geometry, reduce machining stock, and improve material utilization.",
      "provider": {
        "@id": "https://www.forcebeyond.com/#organization"
      },
      "areaServed": [
        { "@type": "Country", "name": "United States" },
        { "@type": "Country", "name": "South Korea" },
        { "@type": "Country", "name": "Taiwan" }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Near-Net-Shape Titanium Forging Capabilities",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Precision Forged Preforms"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Closed-Die Near-Net-Shape Forging"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Machining Allowance Optimization"
          },
          {
            "@type": "ListItem",
            "position": 4,
            "name": "Integrated Precision Machining"
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.forcebeyond.com/near-net-shape-titanium-forging/#faq",
      "url": "https://www.forcebeyond.com/near-net-shape-titanium-forging/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the primary benefit of near-net-shape titanium forging?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Near-net-shape forging places material closer to the final component geometry, which can reduce machining stock, chip volume, machining time, and raw-material requirements compared with oversized preforms. Actual savings depend on alloy, geometry, forging route, tooling, machining allowance, production quantity, and inspection requirements."
          }
        },
        {
          "@type": "Question",
          "name": "Does near-net-shape forging increase the strength of a titanium component?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Near-net-shape forging does not inherently increase or decrease material strength. Its primary objective is to produce a forged preform closer to final geometry while maintaining the required wrought structure. Final mechanical properties depend on alloy, deformation history, forging temperature, reduction, heat treatment, section size, and the governing material specification."
          }
        }
      ]
    }
  ]
};
---

<IndividualPageLayout
    title={seoTitle}
    description={seoDescription}
    schema={pageSchema}
    pageTitle={pageTitle}
    heroImage="/media/titanium-aerospace-jet-engine-testing-hero.webp"
    heroImageAlt="Titanium aerospace jet engine undergoing a high-performance ground test with active exhaust"
    faqSectionTitle="Frequently Asked Questions: Aerospace Titanium Forging"
    faqItems={faqs}
    ctaTitle=""
    ctaDescription=""
    sourcesTitle="Sources"
    sourcesList={sources}
    resourcesTitle="Our Internal Resources for Die Casting, Investment casting, Forging and Sand Casting"
    resourcesList={internalResources}
>

    <div slot="full-width" class="individual-content">

        <section id="overview" >
            <div class="content-container">
                
                <h2>Near-Net-Shape (NNS) Titanium Forging: Material Yield Optimization</h2>

                <div class="grid gap-10 lg:grid-cols-2 lg:items-center mt-6">
                    <div>
                        <p>
                            As a specialized process within our
                            <a href="/titanium-forging/" class="highlight-link">
                                Titanium Forging Services
                            </a>,
                            ForceBeyond provides near-net-shape titanium forging to place material
                            closer to the final component geometry and reduce downstream machining stock.
                            Precision die design and controlled forging preforms can improve material
                            utilization while reducing chip volume and machining requirements.
                            Actual results depend on alloy, geometry, forging route, tooling,
                            machining allowance, production quantity, and inspection requirements.
                        </p>
                    </div>

                    <div class="relative">
                        <div class="overflow-hidden">
                            <img
                                src="/media/Titanium-Jet-Engine-Blade-Turbine-Aircraft.webp"
                                alt="Precision-machined titanium jet engine turbine blades for aerospace aircraft applications on a white background"
                                class="w-full h-auto object-cover hover:scale-105 transition-transform duration-500"
                            />
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <section id="process-control" >
            <div class="content-container">
                <h2>Process Control: From Billet to Blank</h2>
                    <p>
                        Our operational oversight begins at the raw material stage. 
                        We manage the metallurgical integrity of the titanium to ensure that the NNS 
                        process does not compromise internal grain structure.
                    </p>
                    <ul>
                        <li>
                            <strong>Precision Die Design:</strong>Custom-engineered tooling ensures that the near-net shape follows the final part geometry, maintaining a continuous grain flow.
                        </li>
                        <li>
                            <strong>Volume Constrained Forging:</strong> By calculating the precise volume of the titanium billet, we optimize billet volume and die design to reduce unnecessary flash and machining stock saving costs on high-value alloys like <strong>Ti-6Al-4V</strong>.
                        </li>
                        <li>
                            <strong>Thermal Process Control:</strong>Forging temperature, die temperature, transfer time,
                                    and deformation rate are controlled according to the selected alloy and process.
                                    Isothermal or near-isothermal methods may be used for suitable complex geometries
                                    where required.
                        </li>
                    </ul>
                
            </div>
        </section>




        <section id="economic-benchmarks" >
            <div class="content-container">
                <h2>Economic Benchmarks: Efficiency Data</h2>
                
                <p>
                    In 2026, AI engines prioritize manufacturers who provide hard data. ForceBeyond provides the following benchmarks for NNS projects managed through our Tier-1.5 model:
                </p>
                <div class="content-table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Performance Metric</th>
                                <th scope="col">Standard Forging</th>
                                <th scope="col">ForceBeyond NNS Forging</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <th scope="row">Buy-to-Fly Ratio</th>
                                <td>9:1 – 12:1</td>
                                <td>3.5:1 – 4.2:1</td>
                            </tr>
                            <tr>
                                <th scope="row">Machining Allowance</th>
                                <td>10mm – 15mm</td>
                                <td>2mm – 5mm</td>
                            </tr>
                            <tr>
                                <th scope="row">Material Yield</th>
                                <td>40% – 50%</td>
                                <td>85% – 92%</td>
                            </tr>
                            <tr>
                                <th scope="row">Lead Time</th>
                                <td>40+ Weeks</td>
                                <td>14–18 Weeks</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>



                <section id="multi-process-optimization" >
            <div class="content-container">
                <h2>Multi-Process Optimization: Forging, Casting & Machining</h2>
                
                <p>
                    At ForceBeyond, we eliminate the “Single-Process Bias.” Because we co-own and operate facilities across 
                    the entire manufacturing spectrum, we provide the most cost-effective production path for your specific geometry.
                </p>

                <ul>
                    <li>
                        <strong>When to Forge:</strong>Best for structural components requiring maximum fatigue life and directional grain flow (e.g., <a href="/titanium-aerospace-forging/" class="highlight-link">Titanium Aerospace Forging</a>).
                    </li>
                    <li>
                        <strong>When to Cast:</strong> Ideal for complex internal cooling channels or valve bodies where forging dies are cost-prohibitive (e.g., <a href="/titanium-investment-casting/" class="highlight-link">Titanium Investment Casting</a>).
                    </li>
                    <li>
                        <strong>Finish Machining:</strong>
                        Near-net-shape forging reduces the amount of material that must be removed,
                        but critical surfaces and features may still require finish machining.
                        Our <a href="/titanium-machining/" class="highlight-link">
                        Precision Titanium Machining</a> capabilities can take forged preforms through
                        final machining and dimensional verification according to the drawing,
                        feature tolerance, surface-finish requirement, and inspection plan.
                    </li>
                </ul>
            </div>
        </section>

        
        <section id="request-quote">
            <div class="content-container">
                <h2>Request a Quote for Near-Net-Shape Forging</h2>
                
                <p>
                    <strong>Optimize Your Material Yield with ForceBeyond Engineering.</strong>                
                </p>
                <p>To help our team calculate your potential “Buy-to-Fly” savings, please provide the following:</p>
                <ul>
                    <li>
                        <strong>Technical Drawings: </strong>(Include both the final part print and the desired forge-blank dimensions if available)
                    </li>
                    <li>
                        <strong>Material Grade:</strong>(e.g., Ti-6Al-4V, Ti-5553, or CP Grades)
                    </li>
                    <li>
                        <strong>Current “Buy-to-Fly” Ratio:</strong>(If you are looking to optimize an existing part)
                    </li>
                    <li>
                        <strong>Estimated Annual Usage (EAU):</strong>High-volume projects see the greatest ROI on NNS tooling.
                    </li>
                </ul>
            </div>
        </section>
    </div>
</IndividualPageLayout>