---
import { pageDates } from '../data/page-dates.js';
import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';


const dates = pageDates['/magnesium-casting/'];

const pageTitle = 'Magnesium Die Casting Services for Lightweight Precision Components';
const seoTitle = 'Magnesium Die Casting Services | AZ91D, AM60B & AM50A Parts';
const seoDescription = 'ForceBeyond provides custom magnesium die casting services for AZ91D, AM60B, AM50A, and AS41B components, including tooling, hot- and cold-chamber casting, CNC machining, conversion coating, painting, inspection, assembly, and production support.';

const canonicalUrl = 'https://www.forcebeyond.com/magnesium-casting/';
const socialImage = 'https://www.forcebeyond.com/media/magnesium-die-cast-engine-housing-automotive-4k.webp';

const faqs = [
    {
        q: "Why choose magnesium instead of aluminum for die casting?",
        a: "Magnesium is often selected when weight reduction, machinability, vibration damping, thin-wall potential, or electromagnetic shielding are important. It is less dense than aluminum, but the final material choice should also consider stiffness, strength, corrosion protection, service temperature, joining method, coating, cost, and applicable specifications."
    },
    {
        q: "Is galvanic corrosion a concern with magnesium components?",
        a: "Yes. Magnesium can corrode rapidly when it is electrically connected to a more noble metal in the presence of moisture or another electrolyte. Risk can be reduced through suitable conversion coatings, primers, paint systems, sealants, isolation washers, compatible fasteners, drainage, and careful joint design. The complete corrosion-control system should be reviewed for the intended environment."
    },
    {
        q: "How is molten magnesium handled safely during die casting?",
        a: "Magnesium die casting requires dedicated melt handling, temperature control, ventilation, fire-prevention procedures, dry tools, controlled housekeeping, and approved cover-gas or flux systems. Modern foundries manage oxidation and ignition risk through engineered controls and trained operators, but the process is not risk-free and must follow facility, environmental, and safety requirements."
    },
    {
        q: "What information is needed for a magnesium die casting quote?",
        a: "Provide a 2D drawing and, when available, a 3D CAD model, along with alloy preference, annual and batch quantity, critical tolerances, wall thickness, service temperature, corrosion environment, cosmetic class, machining, coating, inserts, inspection, assembly, packaging, tooling life, and delivery expectations."
    }
];

const sources = [
    { label: 'International Magnesium Association - Magnesium Resources', url: 'https://www.intlmag.org/' },
    { label: 'North American Die Casting Association - Die Casting Resources', url: 'https://www.diecasting.org/' },
    { label: 'ASM International - Magnesium and Magnesium Alloys', url: 'https://www.asminternational.org/' },
    { label: 'ASTM International - Magnesium Alloy and Coating Standards', url: 'https://www.astm.org/' },
    { label: 'American Foundry Society - Metalcasting', url: 'https://www.afsinc.org/about-metalcasting' },
    { label: 'NIST - Manufacturing', url: 'https://www.nist.gov/topics/manufacturing' }
];

const internalResources = [
    // Die Casting
    { label: "Die Casting Overview", url: "/die-casting" },
    { label: "Aluminum Die Casting", url: "/aluminum-die-casting" },
    { label: "Zinc Die Casting", url: "/zinc-die-casting" },
    { label: "A356-T6 Casting", url: "/a356-t6-casting" },

    // Related Casting
    { label: "Casting Capabilities", url: "/casting" },
    { label: "Investment Casting", url: "/investment-casting" },
    { label: "Sand Casting", url: "/sand-casting" },

    // Machining and Secondary Operations
    { label: "Precision Machining", url: "/precision-machining" },
    { label: "Multi-Axis CNC Milling & Turning", url: "/multi-axis-cnc" },
    { label: "Secondary Operations", url: "/secondary-operations" },
    { label: "Surface Finishing & Coating", url: "/surface-finishing" },
    { label: "Assembly & Kitting", url: "/assembly-and-kitting" },

    // Quality and Technical
    { label: "Testing & Inspection Capabilities", url: "/testing-inspection-capabilities" },
    { label: "Quality Assurance & Certifications", url: "/quality-assurance-certifications" },
    { label: "Aluminum & Magnesium Materials", url: "/aluminum-magnesium" },
    { label: "Materials & Technical Specifications", url: "/materials-technical-specs" },
    { label: "Manufacturing Design Guides", url: "/manufacturing-design-guides" },

    // Industries
    { label: "Automotive", url: "/automotive" },
    { label: "Medical & Healthcare", url: "/medical" },
    { label: "Space & Defence", url: "/space-defense" },
    { label: "Energy & Power Generation", url: "/energy-power-generation" },
    { label: "HVAC, Fluid & Flow Control", url: "/hvac-flow" }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": seoTitle,
      "description": seoDescription,
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://www.forcebeyond.com/#website",
        "name": "ForceBeyond",
        "url": "https://www.forcebeyond.com/"
      },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": socialImage
      },
      "breadcrumb": {
        "@id": `${canonicalUrl}#breadcrumb`
      },
      "about": [
        { "@type": "Thing", "name": "Magnesium die casting" },
        { "@type": "Thing", "name": "AZ91D magnesium alloy" },
        { "@type": "Thing", "name": "AM60B magnesium alloy" },
        { "@type": "Thing", "name": "AM50A magnesium alloy" },
        { "@type": "Thing", "name": "Lightweight metal components" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.forcebeyond.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Casting",
          "item": "https://www.forcebeyond.com/casting/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Die Casting",
          "item": "https://www.forcebeyond.com/die-casting/"
        },
        {
