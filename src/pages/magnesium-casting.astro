          "item": canonicalUrl
        }
      ]
    },
    {
      "@type": "Service",
      "@id": `${canonicalUrl}#service`,
      "name": "Magnesium Die Casting Services",
      "serviceType": "Lightweight Magnesium Die Casting and Precision Manufacturing",
      "description": seoDescription,
      "url": canonicalUrl,
      "provider": {
        "@id": "https://www.forcebeyond.com/#organization"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United States"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Magnesium Die Casting Capabilities",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "AZ91D Magnesium Die Casting",
              "description": "Magnesium die casting for housings, frames, covers, enclosures, and industrial components requiring lightweight construction and good castability."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "AM60B and AM50A Magnesium Die Casting",
              "description": "Ductile magnesium alloy casting for energy-absorbing, impact-sensitive, automotive, and structural applications."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "AS41B and Elevated-Temperature Magnesium Casting",
              "description": "Application-specific magnesium die casting for components requiring improved creep resistance at elevated temperature."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Machined and Coated Magnesium Castings",
              "description": "Integrated CNC machining, conversion coating, painting, powder coating, inspection, assembly, and kitting for magnesium components."
            }
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
