import IndividualPageLayout from '../layouts/IndividualPageLayout.astro';


const dates = pageDates['/stainless-carbon-steel/'];

const pageTitle = 'Stainless Steel & Carbon Steel for Casting, Forging and Machining';
const seoTitle = 'Stainless & Carbon Steel | 304, 316, 17-4, 2205 & 4140';
const seoDescription = 'Explore ForceBeyond manufacturing support for stainless steel, duplex, precipitation-hardening, carbon steel, and alloy steel grades through casting, forging, CNC machining, heat treatment, finishing, inspection, and documentation.';

const canonicalUrl = 'https://www.forcebeyond.com/stainless-carbon-steel/';
const socialImage = 'https://www.forcebeyond.com/media/precision-cnc-machining-metal-manufacturing-workshop-hero.webp';

const faqs = [
    {
        q: "How is corrosion resistance maintained in 300-series stainless steel?",
        a: "Corrosion performance depends on alloy chemistry, heat treatment, fabrication history, surface condition, contamination control, and service environment. Solution annealing and appropriate cooling may be used when required by the product form and specification, while cleaning, pickling, and passivation can help remove contamination and restore a suitable surface condition."
    },
    {
        q: "How are duplex and super duplex heat treatments controlled?",
        a: "Duplex stainless steel heat treatment is controlled to achieve the required phase balance and avoid excessive intermetallic phases such as sigma. Acceptance limits vary by alloy, product form, specification, and service requirement. NACE MR0175 or ISO 15156 applicability must be verified against the exact material condition, hardness, service environment, and purchase requirements."
    },
    {
        q: "What is the difference between 17-4 PH and 316 stainless steel?",
        a: "17-4 PH is a precipitation-hardening stainless steel selected for high strength and hardness after aging. 316 is an austenitic stainless steel valued for corrosion resistance, ductility, and weldability. The correct choice depends on strength, corrosion environment, temperature, toughness, magnetic response, heat treatment, fabrication, and specification."
    },
    {
        q: "What information is needed for a stainless or carbon steel manufacturing quote?",
        a: "Provide a 2D drawing and, when available, a 3D CAD model, along with steel grade, governing specification, product form, quantity, mechanical requirements, corrosion environment, heat treatment, machining, coating, NDT, documentation, and delivery expectations."
    }
];

const sources = [
    { label: 'ASM International - Stainless, Carbon and Alloy Steel Resources', url: 'https://www.asminternational.org/' },
    { label: 'ASTM International - Steel Material Standards', url: 'https://www.astm.org/' },
    { label: 'Nickel Institute - Stainless Steel Resources', url: 'https://nickelinstitute.org/' },
    { label: 'International Molybdenum Association - Duplex Stainless Steel Resources', url: 'https://www.imoa.info/' },
    { label: 'SAE International - Steel and Aerospace Materials Standards', url: 'https://www.sae.org/standards' },
    { label: 'AMPP - Corrosion and NACE Standards Resources', url: 'https://www.ampp.org/' }
];

